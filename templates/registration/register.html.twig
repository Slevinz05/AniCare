{% extends 'base.html.twig' %}

{% block title %}Inscription - AniCare{% endblock %}

{% block body %}
    <div class="form-card auth-card mx-auto">
        <div class="text-center mb-4">
            <h1 class="page-title h3">Créer un compte AniCare</h1>
            <p class="page-subtitle">Rejoignez-nous pour gérer le carnet de santé de vos compagnons.</p>
        </div>

        {% if form_errors(registrationForm) %}
            <div class="alert alert-danger">
                {{ form_errors(registrationForm) }}
            </div>
        {% endif %}

        {{ form_start(registrationForm, {'attr': {'class': 'anicare-form'}}) }}
            {{ form_row(registrationForm.email, {
                label: 'Adresse email',
                row_attr: {'class': 'form-field'},
                attr: {'class': 'form-control'}
            }) }}
            {{ form_row(registrationForm.plainPassword, {
                label: 'Mot de passe',
                row_attr: {'class': 'form-field'},
                attr: {'class': 'form-control'}
            }) }}
            {{ form_row(registrationForm.agreeTerms, {
                row_attr: {'class': 'form-check'},
                label: "J'accepte les conditions générales d'utilisation d'AniCare"
            }) }}

            <button type="submit" class="btn btn-lg w-100">Créer mon compte</button>
        {{ form_end(registrationForm) }}
    </div>
{% endblock %}
