{% extends 'base.html.twig' %}

{% block title %}Animal
{% endblock %}

{% block body %}
	<h1>Animal</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ animal.id }}</td>
			</tr>
			<tr>
				<th>Name</th>
				<td>{{ animal.name }}</td>
			</tr>
			<tr>
				<th>Species</th>
				<td>{{ animal.species }}</td>
			</tr>
			<tr>
				<th>Breed</th>
				<td>{{ animal.breed }}</td>
			</tr>
			<tr>
				<th>BirthDate</th>
				<td>{{ animal.birthDate ? animal.birthDate|date('Y-m-d') : '' }}</td>
			</tr>
			<tr>
				<th>Gender</th>
				<td>{{ animal.gender }}</td>
			</tr>
			<tr>
				<th>Weight</th>
				<td>{{ animal.weight }}</td>
			</tr>
			<tr>
				<th>BloodType</th>
				<td>{{ animal.bloodType }}</td>
			</tr>
			<tr>
				<th>IdentificationNumber</th>
				<td>{{ animal.identificationNumber }}</td>
			</tr>
		</tbody>
	</table>

	<hr class="my-5">

	<h2>📋 Carnet de santé de
		{{ animal.name }}</h2>

	{% if animal.healthBookEntries is empty %}
		<p class="text-muted">Aucune entrée pour le moment dans le carnet de santé.</p>
	{% else %}
		<table class="table table-striped mt-3">
			<thead>
				<tr>
					<th>Date</th>
					<th>Type</th>
					<th>Titre</th>
					<th>Vétérinaire</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for entry in animal.healthBookEntries %}
					<tr>
						<td>{{ entry.date|date('d/m/Y') }}</td>
						<td>
							<span class="badge bg-secondary">{{ entry.type }}</span>
						</td>
						<td>
							<strong>{{ entry.title }}</strong>
						</td>
						<td>{{ entry.veterinarianName ?? 'Non spécifié' }}</td>
						<td>
							<a href="{{ path('app_health_book_entry_show', {'id': entry.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
							<a href="{{ path('app_health_book_entry_edit', {'id': entry.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% endif %}

	<a href="{{ path('app_health_book_entry_new') }}" class="btn btn-success mt-2">➕ Ajouter un soin</a>

	<a href="{{ path('app_animal_index') }}">back to list</a>

	<a href="{{ path('app_animal_edit', {'id': animal.id}) }}">edit</a>

	{{ include('animal/_delete_form.html.twig') }}
{% endblock %}
