{% extends 'base.html.twig' %}

{% block title %}Fiche de {{ animal.name }} - AniCare{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="card anicare-card overflow-hidden">
        <div class="card-header medical-header p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <p class="page-eyebrow mb-2">Fiche clinique</p>

                    <h1 class="page-title mb-1">
                        {{ animal.name }}
                    </h1>

                    <p class="page-subtitle mb-0">
                        Identifiant dossier : #{{ animal.id }}
                    </p>
                </div>

                <div>
                    {{ include('_partials/_gender_badge.html.twig', {'gender': animal.gender}) }}
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4 mb-5">
                {# ── Colonne gauche : Le cheval ── #}
                <div class="col-12 col-lg-7">
                    <div class="p-4 rounded-3 bg-light h-100">
                        <p class="page-eyebrow mb-3">Le cheval</p>

                        {% if animal.photo %}
                            <div class="text-center mb-4">
                                <img src="{{ asset('uploads/photos/' ~ animal.photo) }}"
                                     alt="Photo de {{ animal.name }}"
                                     class="rounded-3 shadow"
                                     style="max-height: 240px; max-width: 100%; object-fit: cover;">
                            </div>
                        {% endif %}

                        <div class="table-responsive mb-4">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <th style="width: 35%;" class="text-secondary">Race</th>
                                        <td>{{ animal.breed ?: 'Non renseignée' }}</td>
                                    </tr>
                                    {% if animal.coat %}
                                        <tr>
                                            <th class="text-secondary">Robe</th>
                                            <td>{{ animal.coat }}</td>
                                        </tr>
                                    {% endif %}
                                    <tr>
                                        <th class="text-secondary">Date de naissance</th>
                                        <td>
                                            {{ animal.birthDate ? animal.birthDate|date('d/m/Y') : 'Non renseignée' }}
                                            {% if animal.age is not null %}
                                                <span class="text-secondary ms-1">({{ animal.age }} an{{ animal.age > 1 ? 's' : '' }})</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% if animal.height %}
                                        <tr>
                                            <th class="text-secondary">Taille</th>
                                            <td>{{ animal.height }} m</td>
                                        </tr>
                                    {% endif %}
                                    <tr>
                                        <th class="text-secondary">Poids actuel</th>
                                        <td>
                                            <span class="badge-medical badge-weight">
                                                {{ animal.weight ? animal.weight ~ ' kg' : 'Non renseigné' }}
                                            </span>
                                        </td>
                                    </tr>
                                    {% if animal.averageWeight %}
                                        <tr>
                                            <th class="text-secondary">Poids moyen</th>
                                            <td>{{ animal.averageWeight }} kg</td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>

                        <p class="page-eyebrow mb-2">Identification</p>
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <th style="width: 35%;" class="text-secondary">Numéro de SIRE</th>
                                        <td>
                                            <strong class="text-teal">
                                                {{ animal.identificationNumber ?: 'Non renseigné' }}
                                            </strong>
                                        </td>
                                    </tr>
                                    {% if animal.microchipNumber %}
                                        <tr>
                                            <th class="text-secondary">Numéro de puce</th>
                                            <td>{{ animal.microchipNumber }}</td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# ── Colonne droite : Propriétaire & Lieu de vie ── #}
                <div class="col-12 col-lg-5">
                    <div class="d-flex flex-column gap-4 h-100">
                        {# Propriétaire #}
                        <div class="p-4 rounded-3 border border-anicare bg-white flex-shrink-0">
                            <p class="page-eyebrow mb-3">Propriétaire</p>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle bg-anicare-soft d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                                    <span style="font-size: 1.2rem;">👤</span>
                                </div>
                                <div>
                                    <strong class="d-block">{{ animal.owner.fullName }}</strong>
                                    <span class="text-secondary small">{{ animal.owner.email }}</span>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-borderless align-middle mb-0">
                                    <tbody>
                                        {% if animal.owner.phone %}
                                            <tr>
                                                <th style="width: 35%;" class="text-secondary">Téléphone</th>
                                                <td><a href="tel:{{ animal.owner.phone }}">{{ animal.owner.phone }}</a></td>
                                            </tr>
                                        {% endif %}
                                        {% if animal.owner.city %}
                                            <tr>
                                                <th class="text-secondary">Ville</th>
                                                <td>{{ animal.owner.city }}</td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        {# Lieu de vie #}
                        {% if animal.livingPlaceName or animal.livingPlaceCity or animal.livingPlaceManagerLastName %}
                            <div class="p-4 rounded-3 border border-anicare bg-white flex-grow-1">
                                <p class="page-eyebrow mb-3">Lieu de vie</p>
                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless align-middle mb-0">
                                        <tbody>
                                            {% if animal.livingPlaceName %}
                                                <tr>
                                                    <th style="width: 35%;" class="text-secondary">Structure</th>
                                                    <td><strong>{{ animal.livingPlaceName }}</strong></td>
                                                </tr>
                                            {% endif %}
                                            {% if animal.livingPlaceManagerLastName or animal.livingPlaceManagerFirstName %}
                                                <tr>
                                                    <th class="text-secondary">Gérant</th>
                                                    <td>{{ animal.livingPlaceManagerFirstName }} {{ animal.livingPlaceManagerLastName }}</td>
                                                </tr>
                                            {% endif %}
                                            {% if animal.livingPlaceManagerPhone %}
                                                <tr>
                                                    <th class="text-secondary">Téléphone</th>
                                                    <td><a href="tel:{{ animal.livingPlaceManagerPhone }}">{{ animal.livingPlaceManagerPhone }}</a></td>
                                                </tr>
                                            {% endif %}
                                            {% if animal.livingPlaceManagerEmail %}
                                                <tr>
                                                    <th class="text-secondary">E-mail</th>
                                                    <td><a href="mailto:{{ animal.livingPlaceManagerEmail }}">{{ animal.livingPlaceManagerEmail }}</a></td>
                                                </tr>
                                            {% endif %}
                                            {% if animal.livingPlaceStreet or animal.livingPlaceCity %}
                                                <tr>
                                                    <th class="text-secondary">Adresse</th>
                                                    <td>
                                                        {% if animal.livingPlaceStreet %}{{ animal.livingPlaceStreet }}<br>{% endif %}
                                                        {% if animal.livingPlaceComplement %}{{ animal.livingPlaceComplement }}<br>{% endif %}
                                                        {% if animal.livingPlacePostalCode %}{{ animal.livingPlacePostalCode }} {% endif %}{{ animal.livingPlaceCity }}
                                                        {% if animal.livingPlaceCountry %}<br>{{ animal.livingPlaceCountry }}{% endif %}
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <section class="mb-5">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <div>
                        <p class="page-eyebrow mb-2">Documents</p>
                        <h2 class="h4 page-title mb-0">
                            Documents du cheval
                        </h2>
                    </div>

                    <a href="{{ path('app_animal_edit', {'id': animal.id}) }}" class="btn btn-outline-primary btn-sm">
                        Ajouter un document
                    </a>
                </div>

                {% if animal.documents is empty %}
                    <div class="alert bg-anicare-soft border border-anicare text-secondary mb-0">
                        Aucun document n'est encore associé à ce cheval.
                    </div>
                {% else %}
                    <div class="document-list">
                        {% for document in animal.documents %}
                            <div class="document-item d-flex justify-content-between align-items-center flex-wrap gap-2 py-2 {{ not loop.last ? 'border-bottom border-light' : '' }}">
                                <div>
                                    <a href="{{ path('app_document_download_animal', {'animalId': animal.id, 'fileName': document.fileName}) }}"
                                       target="_blank" rel="noopener" class="document-name text-decoration-none">
                                        {{ document.originalName|default(document.fileName) }}
                                    </a>
                                    <span class="document-meta d-block small text-secondary">
                                        {% if document.size is defined %}
                                            {{ (document.size / 1024)|round(0, 'ceil') }} Ko
                                        {% endif %}
                                        {% if document.uploadedAt is defined %}
                                            · {{ document.uploadedAt|date('d/m/Y') }}
                                        {% endif %}
                                    </span>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    {% set doc_status = document.status|default('pending') %}
                                    {% if doc_status == 'approved' %}
                                        <span class="badge bg-success">Validé</span>
                                    {% elseif doc_status == 'rejected' %}
                                        <span class="badge bg-danger">Refusé</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">En attente</span>
                                    {% endif %}

                                    {% if is_granted('ANIMAL_EDIT', animal) and is_granted('ROLE_PRO') %}
                                        {% if doc_status != 'approved' %}
                                            <form method="post" action="{{ path('app_document_status', {'animalId': animal.id, 'fileName': document.fileName}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('document_status' ~ document.fileName) }}">
                                                <input type="hidden" name="status" value="approved">
                                                <button type="submit" class="btn btn-success btn-sm py-0 px-2">Valider</button>
                                            </form>
                                        {% endif %}
                                        {% if doc_status != 'rejected' %}
                                            <form method="post" action="{{ path('app_document_status', {'animalId': animal.id, 'fileName': document.fileName}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('document_status' ~ document.fileName) }}">
                                                <input type="hidden" name="status" value="rejected">
                                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">Refuser</button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            <section class="mb-5">
                <div class="mb-3">
                    <p class="page-eyebrow mb-2">Accès rapide</p>
                    <h2 class="h4 page-title mb-3">Dossier complet</h2>
                </div>
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="{{ path('app_allergy_index', {'id': animal.id}) }}" class="btn btn-outline-primary w-100 py-3">
                            Allergies
                            {% if animal.allergies|length > 0 %}
                                <span class="badge bg-danger ms-1">{{ animal.allergies|length }}</span>
                            {% endif %}
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="{{ path('app_weight_record_index', {'id': animal.id}) }}" class="btn btn-outline-primary w-100 py-3">
                            Courbe de poids
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="{{ path('app_message_thread', {'id': animal.id}) }}" class="btn btn-outline-primary w-100 py-3">
                            Messages
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="{{ path('app_emergency_card', {'id': animal.id}) }}" class="btn btn-danger w-100 py-3">
                            Fiche d'urgence
                        </a>
                    </div>
                </div>
            </section>

            <section>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <div>
                        <p class="page-eyebrow mb-2">Consultations</p>

                        <h2 class="h4 page-title mb-0">
                            Historique des consultations
                        </h2>
                    </div>

                    <a href="{{ path('app_health_book_entry_new') }}" class="btn btn-primary btn-sm">
                        Ajouter une consultation
                    </a>
                </div>

                {% if animal.healthBookEntries is empty %}
                    <div class="alert bg-anicare-soft border border-anicare text-secondary mb-0">
                        Aucune consultation enregistrée pour le moment.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover table-medical align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Date du soin</th>
                                    <th>Type</th>
                                    <th>Consultation</th>
                                    <th>Vétérinaire</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for entry in animal.healthBookEntries %}
                                    {% set entry_type = entry.type|default('')|lower %}

                                    <tr>
                                        <td>
                                            <strong>{{ entry.date|date('d/m/Y') }}</strong>
                                        </td>

                                        <td>
                                            {% if entry_type == 'vaccination' or entry_type == 'vaccin' %}
                                                <span class="badge-medical badge-vaccin">Vaccination</span>
                                            {% elseif entry_type == 'chirurgie' %}
                                                <span class="badge-medical badge-surgery">Chirurgie</span>
                                            {% else %}
                                                <span class="badge-medical badge-neutral">
                                                    {{ entry.type }}
                                                </span>
                                            {% endif %}
                                        </td>

                                        <td>
                                            <strong class="text-teal">{{ entry.title }}</strong>
                                        </td>

                                        <td>
                                            Dr. {{ entry.veterinarianName ?? 'Non renseigné' }}
                                        </td>

                                        <td class="text-end">
                                            <a href="{{ path('app_health_book_entry_show', {'id': entry.id}) }}" class="btn btn-outline-primary btn-sm">
                                                Consulter
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-5 pt-4 border-top border-anicare">
                <a href="{{ path('app_animal_index') }}" class="btn btn-outline-primary">
                    Retour
                </a>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('app_animal_share_new') }}" class="btn btn-outline-primary">
                        Partager
                    </a>

                    <a href="{{ path('app_animal_edit', {'id': animal.id}) }}" class="btn btn-primary">
                        Modifier le profil
                    </a>

                    {{ include('animal/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}