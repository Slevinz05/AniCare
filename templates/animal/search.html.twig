{% extends 'base.html.twig' %}

{% block title %}Rechercher un cheval - AniCare{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .as-page { max-width: 800px; margin: 0 auto; }

    .as-hero {
        background: linear-gradient(135deg, var(--primary-color) 0%, #0a7a70 60%, var(--secondary-color) 100%);
        border-radius: var(--radius-lg);
        padding: 2.2rem 2.5rem;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .as-hero::before {
        content: '';
        position: absolute; top: -40%; right: -10%; width: 340px; height: 340px;
        background: radial-gradient(circle, rgba(255,255,255,.08) 0%, transparent 70%);
        border-radius: 50%;
    }
    .as-hero h1 { font-size: 1.5rem; font-weight: 800; margin: 0 0 .35rem; }
    .as-hero p { font-size: .9rem; opacity: .85; margin: 0; }

    .as-search-bar {
        position: relative; max-width: 100%;
    }
    .as-search-bar input {
        width: 100%; padding: .7rem 1rem .7rem 2.8rem;
        border: 2px solid rgba(255,255,255,.3); border-radius: var(--radius-md);
        background: rgba(255,255,255,.15); color: #fff; font-size: .95rem;
        transition: all .2s;
    }
    .as-search-bar input::placeholder { color: rgba(255,255,255,.6); }
    .as-search-bar input:focus { background: rgba(255,255,255,.25); border-color: rgba(255,255,255,.5); outline: none; }
    .as-search-bar svg {
        position: absolute; left: .9rem; top: 50%; transform: translateY(-50%); opacity: .6;
    }

    .as-result-card {
        display: flex; align-items: center; gap: 1rem;
        padding: 1rem 1.25rem;
        background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-md);
        text-decoration: none; color: inherit;
        transition: all .2s;
    }
    .as-result-card:hover {
        border-color: var(--primary-color); background: var(--soft-teal);
        transform: translateX(4px); box-shadow: 0 4px 12px rgba(26,77,69,.08);
        color: inherit;
    }
    .as-result-avatar {
        width: 48px; height: 48px; border-radius: 14px;
        background: var(--soft-teal); color: var(--primary-color);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1.1rem; flex-shrink: 0;
    }
    .as-result-avatar img {
        width: 48px; height: 48px; border-radius: 14px; object-fit: cover;
    }
    .as-result-name { font-weight: 700; font-size: .95rem; }
    .as-result-meta { font-size: .8rem; color: #6c757d; }

    .as-match-badge {
        display: inline-flex; padding: .15rem .5rem; border-radius: 999px;
        font-size: .68rem; font-weight: 600;
        background: #fef2f2; color: #dc2626;
    }

    .as-create-cta {
        background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
        border: 2px dashed #d1d5db; border-radius: var(--radius-md);
        padding: 2rem; text-align: center;
        transition: all .2s;
    }
    .as-create-cta:hover { border-color: var(--primary-color); background: var(--soft-teal); }
</style>
{% endblock %}

{% block body %}
<div class="as-page py-4 px-3">

    <div class="as-hero mb-4">
        <p style="font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; opacity: .8; margin-bottom: .35rem;">Étape 1</p>
        <h1>Rechercher avant de créer</h1>
        <p>Vérifiez qu'un cheval avec ce nom ou identifiant n'existe pas déjà dans AniCare.</p>

        <form method="get" class="mt-3">
            <div class="as-search-bar">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="q" value="{{ query }}" placeholder="Nom, n° SIRE, puce, propriétaire..." autofocus>
            </div>
        </form>
    </div>

    {% if query %}
        {% if results is not empty %}
            <div class="mb-3">
                <p style="font-size: .85rem; font-weight: 600; color: #6c757d;">
                    {{ results|length }} résultat{{ results|length > 1 ? 's' : '' }} pour "{{ query }}"
                </p>
            </div>

            <div class="d-flex flex-column gap-2 mb-4">
                {% for animal in results %}
                    <a href="{{ path('app_animal_show', {slug: animal.slug}) }}" class="as-result-card">
                        <div class="as-result-avatar">
                            {% if animal.photo %}
                                <img src="{{ asset('uploads/photos/' ~ animal.photo) }}" alt="{{ animal.name }}">
                            {% else %}
                                {{ animal.name|first|upper }}
                            {% endif %}
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div class="as-result-name">{{ animal.name }}</div>
                            <div class="as-result-meta">
                                {{ animal.breed ?: 'Race non renseignée' }}
                                {% if animal.age is not null %} · {{ animal.age }} an{{ animal.age > 1 ? 's' : '' }}{% endif %}
                                {% if animal.owner %} · {{ animal.owner.fullName }}{% endif %}
                            </div>
                            {% if animal.identificationNumber %}
                                <div class="as-result-meta">SIRE : {{ animal.identificationNumber }}</div>
                            {% endif %}
                            {% if animal.microchipNumber %}
                                <div class="as-result-meta">Puce : {{ animal.microchipNumber }}</div>
                            {% endif %}
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="#adb5bd" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                {% endfor %}
            </div>

            <div class="as-create-cta">
                <div class="mb-2" style="width: 48px; height: 48px; border-radius: 50%; background: var(--soft-teal); display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="var(--primary-color)" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <p style="font-weight: 700; font-size: .95rem; margin-bottom: .3rem; color: #333;">Ce n'est pas mon cheval ?</p>
                <p style="font-size: .85rem; color: #6c757d; margin-bottom: 1rem;">Aucun résultat ne correspond. Créez une nouvelle fiche.</p>
                <a href="{{ path('app_animal_new') }}" class="btn" style="background: var(--primary-color); color: #fff; border-radius: var(--radius-md); font-weight: 600; font-size: .85rem; padding: .55rem 1.5rem;">
                    Créer un nouveau cheval
                </a>
            </div>

        {% else %}
            <div class="as-create-cta">
                <div class="mb-2" style="width: 56px; height: 56px; border-radius: 50%; background: #dcfce7; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#16a34a" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <p style="font-weight: 700; font-size: .95rem; margin-bottom: .3rem; color: #333;">Aucun doublon détecté</p>
                <p style="font-size: .85rem; color: #6c757d; margin-bottom: 1rem;">Aucun cheval trouvé pour "{{ query }}". Vous pouvez créer une nouvelle fiche.</p>
                <a href="{{ path('app_animal_new') }}" class="btn" style="background: var(--primary-color); color: #fff; border-radius: var(--radius-md); font-weight: 600; font-size: .85rem; padding: .55rem 1.5rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align: -1px; margin-right: .3rem;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Créer un nouveau cheval
                </a>
            </div>
        {% endif %}
    {% else %}
        <div class="text-center py-4">
            <div class="mb-3" style="width: 56px; height: 56px; border-radius: 50%; background: var(--soft-teal); display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="var(--primary-color)" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <p style="font-weight: 700; font-size: .95rem; color: #333; margin-bottom: .3rem;">Recherchez un cheval</p>
            <p style="font-size: .85rem; color: #6c757d; margin-bottom: 1.5rem;">
                Saisissez un nom, numéro SIRE, puce ou nom du propriétaire.
            </p>
            <a href="{{ path('app_animal_new') }}" class="btn btn-outline-secondary" style="font-size: .85rem; border-radius: var(--radius-md);">
                Passer et créer directement
            </a>
        </div>
    {% endif %}

</div>
{% endblock %}
