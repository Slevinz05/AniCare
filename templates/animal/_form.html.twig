<script>
document.addEventListener('DOMContentLoaded', function () {
    // ── Espèce : toggle active class ──
    document.querySelectorAll('.species-radio').forEach(function(radio) {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.species-label').forEach(function(l) { l.classList.remove('active'); });
            if (this.checked) this.nextElementSibling.classList.add('active');
            var isEquine = (this.value === 'Cheval');
            var letterBox = document.getElementById('letterCheckboxes');
            if (letterBox) letterBox.style.display = isEquine ? '' : 'none';
        });
    });

    var currentSpecies = document.querySelector('.species-radio:checked');
    var letterBox = document.getElementById('letterCheckboxes');
    if (currentSpecies && letterBox) {
        letterBox.style.display = (currentSpecies.value === 'Cheval') ? '' : 'none';
    }

    var coatSelect = document.getElementById('{{ form.coat.vars.id }}');
    var coatCustomGroup = document.getElementById('coatCustomGroup');
    if (coatSelect && coatCustomGroup) {
        coatSelect.addEventListener('change', function () {
            coatCustomGroup.style.display = this.value === 'Autre' ? '' : 'none';
        });
    }

    // ── Alphabet équidé ──
    var EQUINE_LETTERS = 'ABCDEFGHIJKLMNOPQRSTUV';
    var JEUNE_CYCLE_START = 2010;
    var ANIMAL_CYCLE_START = JEUNE_CYCLE_START - 22;

    var nameInput = document.getElementById('animal_name_input') || document.getElementById('{{ form.name.vars.id }}');
    var birthDateInput = document.getElementById('{{ form.birthDate.vars.id }}');
    var ageDisplay = document.getElementById('ageDisplay');
    var ageHidden = document.getElementById('age_hidden_field');
    var letterJeune = document.getElementById('letterJeune');
    var letterAnimal = document.getElementById('letterAnimal');
    var letterInfo = document.getElementById('letterInfo');
    var letterInfoText = document.getElementById('letterInfoText');
    var ageDateError = document.getElementById('ageDateError');

    function getLetterOffset(name) {
        if (!name) return -1;
        return EQUINE_LETTERS.indexOf(name.trim().charAt(0).toUpperCase());
    }

    function computeAgeFromBirth(dateStr) {
        if (!dateStr) return '';
        var birth = new Date(dateStr);
        var today = new Date();
        var age = today.getFullYear() - birth.getFullYear();
        var m = today.getMonth() - birth.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
        return Math.max(0, age);
    }

    function updateAgeDisplay() {
        var age = computeAgeFromBirth(birthDateInput.value);
        ageDisplay.value = age !== '' ? age : '';
        if (ageHidden) ageHidden.value = age !== '' ? age : '';
    }

    function updateBirthFromLetter() {
        var offset = getLetterOffset(nameInput.value);
        if (offset < 0) {
            letterInfo.style.display = 'none';
            birthDateInput.value = '';
            updateAgeDisplay();
            return;
        }
        var letter = EQUINE_LETTERS[offset];
        var isAnimal = letterAnimal.checked;
        var cycleStart = isAnimal ? ANIMAL_CYCLE_START : JEUNE_CYCLE_START;
        var birthYear = cycleStart + offset;
        var cycleName = isAnimal ? 'ancien cycle' : 'cycle actuel';

        birthDateInput.value = birthYear + '-01-01';
        letterInfoText.textContent = 'Lettre « ' + letter + ' » → né(e) en ' + birthYear + ' (' + cycleName + ')';
        letterInfo.style.display = 'block';
        updateAgeDisplay();
    }

    if (letterJeune && letterAnimal) {
        letterJeune.addEventListener('change', function () {
            if (this.checked) { letterAnimal.checked = false; updateBirthFromLetter(); }
        });
        letterAnimal.addEventListener('change', function () {
            if (this.checked) { letterJeune.checked = false; updateBirthFromLetter(); }
        });
    }

    if (nameInput) {
        nameInput.addEventListener('input', function () {
            if (letterJeune.checked || letterAnimal.checked) updateBirthFromLetter();
        });
    }

    if (birthDateInput) {
        birthDateInput.addEventListener('change', updateAgeDisplay);
        updateAgeDisplay();
    }

    var theForm = document.querySelector('.anicare-form');
    if (theForm && ageDateError) {
        theForm.addEventListener('submit', function(e) {
            if (!birthDateInput.value) {
                e.preventDefault();
                ageDateError.classList.remove('d-none');
                birthDateInput.closest('.row').scrollIntoView({behavior: 'smooth', block: 'center'});
            } else {
                ageDateError.classList.add('d-none');
            }
        });
    }

    if (nameInput && birthDateInput && birthDateInput.value) {
        var offset = getLetterOffset(nameInput.value);
        if (offset >= 0) {
            var letter = EQUINE_LETTERS[offset];
            var birthYear = parseInt(birthDateInput.value.substring(0, 4), 10);
            var jeuneYear = JEUNE_CYCLE_START + offset;
            var animalYear = ANIMAL_CYCLE_START + offset;
            if (birthYear === animalYear) {
                letterAnimal.checked = true;
                letterJeune.checked = false;
                letterInfoText.textContent = 'Lettre « ' + letter + ' » → né(e) en ' + birthYear + ' (ancien cycle)';
                letterInfo.style.display = 'block';
            } else if (birthYear === jeuneYear) {
                letterInfoText.textContent = 'Lettre « ' + letter + ' » → né(e) en ' + birthYear + ' (cycle actuel)';
                letterInfo.style.display = 'block';
            }
        }
    }

    // ── Doublons ──
    var duplicateAlert = document.getElementById('duplicateAlert');
    var duplicateList = document.getElementById('duplicateList');
    var sireInput = document.getElementById('animal_sire_input') || document.getElementById('{{ form.identificationNumber.vars.id }}');
    var chipInput = document.getElementById('animal_chip_input') || document.getElementById('{{ form.microchipNumber.vars.id }}');
    var dupDebounce = null;

    function checkDuplicates() {
        clearTimeout(dupDebounce);
        var name = (nameInput ? nameInput.value.trim() : '');
        var sire = (sireInput ? sireInput.value.trim() : '');
        var chip = (chipInput ? chipInput.value.trim() : '');

        if (name.length < 2 && sire.length < 3 && chip.length < 3) {
            duplicateAlert.classList.add('d-none');
            return;
        }

        dupDebounce = setTimeout(function () {
            var params = new URLSearchParams();
            if (name) params.append('name', name);
            if (sire) params.append('identification', sire);
            if (chip) params.append('microchip', chip);

            fetch('{{ path("app_animal_check_duplicates") }}?' + params.toString())
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.length === 0) { duplicateAlert.classList.add('d-none'); return; }
                    duplicateList.innerHTML = '';
                    data.forEach(function (dup) {
                        var card = document.createElement('a');
                        card.href = '/mes-chevaux/' + dup.slug;
                        card.target = '_blank';
                        card.className = 'duplicate-card';
                        var info = '<strong>' + dup.name + '</strong>';
                        if (dup.breed) info += ' <span class="text-secondary">(' + dup.breed + ')</span>';
                        var sub = [];
                        if (dup.owner) sub.push(dup.owner);
                        if (dup.identificationNumber) sub.push('SIRE: ' + dup.identificationNumber);
                        if (dup.microchipNumber) sub.push('Puce: ' + dup.microchipNumber);
                        card.innerHTML = '<div>' + info + (sub.length ? '<br><span class="text-secondary" style="font-size:.78rem;">' + sub.join(' — ') + '</span>' : '') + '</div>';
                        duplicateList.appendChild(card);
                    });
                    duplicateAlert.classList.remove('d-none');
                });
        }, 400);
    }

    if (nameInput) nameInput.addEventListener('input', checkDuplicates);
    if (sireInput) sireInput.addEventListener('input', checkDuplicates);
    if (chipInput) chipInput.addEventListener('input', checkDuplicates);

    // ── Référent : checkbox auto-désignation + panels ──
    var refSelfCheckbox = document.getElementById('referentSelfCheckbox');
    var refOtherPanel = document.getElementById('referentOtherPanel');
    var refSearchCard = document.getElementById('referentSearchCard');
    var refCreateCard = document.getElementById('referentCreateCard');
    var refSearchPanel = document.getElementById('referentSearchPanel');
    var refCreatePanel = document.getElementById('referentCreatePanel');
    var refInput = document.getElementById('referentSearchInput');
    var refResults = document.getElementById('referentSearchResults');
    var refSelected = document.getElementById('referentSelected');
    var refIdInput = document.getElementById('referentIdInput');
    var refSelectedName = document.getElementById('referentSelectedName');
    var refSelectedInfo = document.getElementById('referentSelectedInfo');
    var refRemoveBtn = document.getElementById('referentRemoveBtn');
    var refRoleInput = document.getElementById('referentRoleInput');
    var refDebounce = null;

    function toggleReferentSelf() {
        if (refSelfCheckbox.checked) {
            refOtherPanel.style.display = 'none';
            refIdInput.value = '';
            refSelected.style.display = 'none';
            refSearchPanel.style.display = 'none';
            refCreatePanel.style.display = 'none';
        } else {
            refOtherPanel.style.display = 'block';
        }
    }

    if (refSelfCheckbox) {
        refSelfCheckbox.addEventListener('change', toggleReferentSelf);
        toggleReferentSelf();
    }

    if (refSearchCard) {
        refSearchCard.addEventListener('click', function () {
            refSearchPanel.style.display = 'block';
            refCreatePanel.style.display = 'none';
            refInput.focus();
        });
    }

    if (refCreateCard) {
        refCreateCard.addEventListener('click', function () {
            refCreatePanel.style.display = 'block';
            refSearchPanel.style.display = 'none';
        });
    }

    if (refInput) {
        refInput.addEventListener('input', function () {
            clearTimeout(refDebounce);
            var q = this.value.trim();
            if (q.length < 2) { refResults.style.display = 'none'; return; }

            refDebounce = setTimeout(function () {
                fetch('{{ path("api_users_search") }}?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        refResults.innerHTML = '';
                        if (data.length === 0) {
                            refResults.innerHTML = '<div class="list-group-item text-secondary small">Aucun utilisateur trouvé.</div>';
                        } else {
                            data.forEach(function (user) {
                                var item = document.createElement('button');
                                item.type = 'button';
                                item.className = 'list-group-item list-group-item-action py-2';
                                var badge = user.accountType === 'PRO' ? ' <span class="badge" style="background:#e3f2fd;color:#1565C0;font-size:.65rem;">PRO</span>' : '';
                                item.innerHTML = '<strong>' + user.fullName + '</strong>' + badge + '<br><span class="small text-secondary">' + user.email + (user.city ? ' — ' + user.city : '') + '</span>';
                                item.addEventListener('click', function () {
                                    refIdInput.value = user.id;
                                    refSelectedName.textContent = user.fullName;
                                    refSelectedInfo.textContent = user.email + (user.city ? ' — ' + user.city : '');
                                    refSelected.style.display = 'block';
                                    refSearchPanel.style.display = 'none';
                                    refCreatePanel.style.display = 'none';
                                    refResults.style.display = 'none';
                                });
                                refResults.appendChild(item);
                            });
                        }
                        refResults.style.display = 'block';
                    });
            }, 300);
        });

        refRemoveBtn.addEventListener('click', function () {
            refIdInput.value = '';
            refSelected.style.display = 'none';
            refSearchPanel.style.display = 'block';
            refInput.value = '';
            refInput.focus();
        });

        document.addEventListener('click', function (e) {
            if (!refInput.contains(e.target) && !refResults.contains(e.target)) {
                refResults.style.display = 'none';
            }
        });
    }

    // ── Rôle référent ──
    document.querySelectorAll('.referent-role-btn').forEach(function(btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.referent-role-btn').forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');
            refRoleInput.value = this.getAttribute('data-role');
        });
    });

    // ── Lieu de vie : cartes sélectionnables ──
    var lpCards = document.querySelectorAll('.action-card-selectable');
    var lpModeInput = document.getElementById('livingPlaceModeInput');
    var lpFields = document.getElementById('livingPlaceFields');
    var lpStructure = document.getElementById('livingPlaceStructureMode');
    var lpReferent = document.getElementById('livingPlaceReferentMode');

    lpCards.forEach(function(card) {
        card.addEventListener('click', function() {
            lpCards.forEach(function(c) { c.classList.remove('active'); });
            this.classList.add('active');
            var mode = this.getAttribute('data-mode');
            lpModeInput.value = mode;
            lpFields.style.display = mode === 'address' ? '' : 'none';
            lpStructure.style.display = mode === 'structure' ? '' : 'none';
            lpReferent.style.display = mode === 'referent' ? '' : 'none';
        });
    });

    // ── Recherche structure (lieu de vie) ──
    var strInput = document.getElementById('structureSearchInput');
    var strResults = document.getElementById('structureSearchResults');
    var strSelected = document.getElementById('structureSelected');
    var strIdInput = document.getElementById('structureIdInput');
    var strSelectedName = document.getElementById('structureSelectedName');
    var strSelectedInfo = document.getElementById('structureSelectedInfo');
    var strRemoveBtn = document.getElementById('structureRemoveBtn');
    var strDebounce = null;

    if (strInput) {
        strInput.addEventListener('input', function () {
            clearTimeout(strDebounce);
            var q = this.value.trim();
            if (q.length < 2) { strResults.style.display = 'none'; return; }

            strDebounce = setTimeout(function () {
                fetch('{{ path("app_appointment_search_structures") }}?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        strResults.innerHTML = '';
                        var list = data.structures || [];
                        if (list.length === 0) {
                            strResults.innerHTML = '<div class="list-group-item text-secondary small">Aucune structure trouvée.</div>';
                        } else {
                            list.forEach(function (s) {
                                var item = document.createElement('button');
                                item.type = 'button';
                                item.className = 'list-group-item list-group-item-action py-2';
                                var loc = [s.postalCode, s.city].filter(Boolean).join(' ');
                                item.innerHTML = '<strong>' + s.name + '</strong>' + (s.type ? ' <span class="badge" style="background:#FFF0CC;color:var(--accent-color);font-size:.65rem;">' + s.type + '</span>' : '') + (loc ? '<br><span class="small text-secondary">' + loc + '</span>' : '');
                                item.addEventListener('click', function () {
                                    strIdInput.value = s.id;
                                    strSelectedName.textContent = s.name;
                                    strSelectedInfo.textContent = [s.street, s.postalCode, s.city].filter(Boolean).join(', ');
                                    strSelected.style.display = 'block';
                                    strInput.style.display = 'none';
                                    strResults.style.display = 'none';
                                });
                                strResults.appendChild(item);
                            });
                        }
                        strResults.style.display = 'block';
                    });
            }, 300);
        });

        strRemoveBtn.addEventListener('click', function () {
            strIdInput.value = '';
            strSelected.style.display = 'none';
            strInput.style.display = '';
            strInput.value = '';
            strInput.focus();
        });

        document.addEventListener('click', function (e) {
            if (!strInput.contains(e.target) && !strResults.contains(e.target)) {
                strResults.style.display = 'none';
            }
        });
    }

    // ── Recherche professionnel ──
    var proInput = document.getElementById('proSearchInput');
    var proResults = document.getElementById('proSearchResults');
    var proSelected = document.getElementById('proSelected');
    var proIdInput = document.getElementById('proIdInput');
    var proSelectedName = document.getElementById('proSelectedName');
    var proSelectedInfo = document.getElementById('proSelectedInfo');
    var proRemoveBtn = document.getElementById('proRemoveBtn');
    var proDebounce = null;

    if (proInput) {
        proInput.addEventListener('input', function () {
            clearTimeout(proDebounce);
            var q = this.value.trim();
            if (q.length < 2) { proResults.style.display = 'none'; return; }

            proDebounce = setTimeout(function () {
                fetch('{{ path("api_professionals_search") }}?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        proResults.innerHTML = '';
                        if (data.length === 0) {
                            proResults.innerHTML = '<div class="list-group-item text-secondary small">Aucun professionnel trouvé.</div>';
                        } else {
                            data.forEach(function (pro) {
                                var item = document.createElement('button');
                                item.type = 'button';
                                item.className = 'list-group-item list-group-item-action py-2';
                                item.innerHTML = '<strong>' + pro.fullName + '</strong><br><span class="small text-secondary">' + pro.email + (pro.city ? ' — ' + pro.city : '') + '</span>';
                                item.addEventListener('click', function () {
                                    proIdInput.value = pro.id;
                                    proSelectedName.textContent = pro.fullName;
                                    proSelectedInfo.textContent = pro.email + (pro.city ? ' — ' + pro.city : '');
                                    proSelected.style.display = 'block';
                                    proInput.style.display = 'none';
                                    proResults.style.display = 'none';
                                });
                                proResults.appendChild(item);
                            });
                        }
                        proResults.style.display = 'block';
                    });
            }, 300);
        });

        proRemoveBtn.addEventListener('click', function () {
            proIdInput.value = '';
            proSelected.style.display = 'none';
            proInput.style.display = 'block';
            proInput.value = '';
        });

        document.addEventListener('click', function (e) {
            if (!proInput.contains(e.target) && !proResults.contains(e.target)) {
                proResults.style.display = 'none';
            }
        });
    }

    // ── Rappels dynamiques ──
    var container = document.getElementById('remindersContainer');
    var addBtn = document.getElementById('addReminderBtn');

    if (addBtn && container) {
        addBtn.addEventListener('click', function () {
            var row = document.createElement('div');
            row.className = 'reminder-row border rounded-3 p-3 mb-2';
            row.style.backgroundColor = '#fffdf5';
            row.innerHTML =
                '<div class="row g-2 align-items-end">' +
                    '<div class="col-12 col-md-5">' +
                        '<label class="form-label small fw-bold">Motif</label>' +
                        '<input type="text" name="reminder_title[]" class="form-control form-control-sm" placeholder="Ex : Vaccin, Vermifuge..." required>' +
                    '</div>' +
                    '<div class="col-6 col-md-3">' +
                        '<label class="form-label small fw-bold">Date</label>' +
                        '<input type="datetime-local" name="reminder_date[]" class="form-control form-control-sm" required>' +
                    '</div>' +
                    '<div class="col-6 col-md-3">' +
                        '<label class="form-label small fw-bold">Recurrence</label>' +
                        '<select name="reminder_recurrence[]" class="form-select form-select-sm">' +
                            '<option value="">Aucune</option>' +
                            '<option value="weekly">Hebdomadaire</option>' +
                            '<option value="monthly">Mensuel</option>' +
                            '<option value="quarterly">Trimestriel</option>' +
                            '<option value="biannual">Semestriel</option>' +
                            '<option value="annual">Annuel</option>' +
                        '</select>' +
                    '</div>' +
                    '<div class="col-auto col-md-1 d-flex align-items-end">' +
                        '<button type="button" class="btn btn-outline-danger btn-sm remove-reminder-btn" title="Supprimer">' +
                            '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
                        '</button>' +
                    '</div>' +
                '</div>';
            container.appendChild(row);
            row.querySelector('.remove-reminder-btn').addEventListener('click', function () { row.remove(); });
        });
    }
});
</script>
