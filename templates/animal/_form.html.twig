{{ form_start(form, {
    'attr': {
        'class': 'anicare-form needs-validation',
        'novalidate': 'novalidate'
    }
}) }}

{% if form_errors(form) %}
    <div class="alert alert-danger shadow-sm mb-4">
        {{ form_errors(form) }}
    </div>
{% endif %}

{# Macro pour un champ avec gestion d'erreur inline #}
{% macro field(f, class, extra_attr) %}
    {% set has_error = f.vars.errors|length %}
    {% set css = (class|default('form-control')) ~ (has_error ? ' is-invalid' : '') %}
    {{ form_widget(f, {'attr': (extra_attr|default({}))|merge({'class': css})}) }}
    {% if has_error %}
        <div class="text-danger small mt-1">{{ form_errors(f) }}</div>
    {% endif %}
{% endmacro %}

{# Macro pour un label avec étoile rouge si requis #}
{% macro label(f, required) %}
    <label class="form-label" for="{{ f.vars.id }}">
        {{ f.vars.label }}{% if required|default(false) %} <span class="text-danger">*</span>{% endif %}
    </label>
{% endmacro %}

<div class="row g-4">
    {# ══════════════════════════════════════════════════════════
       COLONNE GAUCHE — Le cheval
       ══════════════════════════════════════════════════════════ #}
    <div class="col-12 col-lg-7">
        <div class="p-4 rounded-3" style="background-color: #F7F3ED; border-left: 4px solid #0d9488;">
            {# ── Identité ── #}
            <p class="page-eyebrow mb-2">Identité</p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    {{ _self.label(form.name, true) }}
                    {{ _self.field(form.name) }}
                </div>

                <div class="col-12 col-md-6">
                    {{ form_label(form.breed, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ _self.field(form.breed) }}
                </div>

                <div class="col-12 col-md-6">
                    {{ form_label(form.coat, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ _self.field(form.coat, 'form-select') }}
                </div>

                <div class="col-12 col-md-6" id="coatCustomGroup" style="{{ form.coat.vars.data != 'Autre' ? 'display:none;' : '' }}">
                    {{ form_label(form.coatCustom, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ _self.field(form.coatCustom) }}
                </div>

                <div class="col-12 col-md-3">
                    {{ form_label(form.birthDate, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ _self.field(form.birthDate) }}
                    <div class="form-text text-secondary">Remplir la date ou l'âge.</div>
                </div>

                <div class="col-12 col-md-3">
                    {{ form_label(form.age, null, {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        {{ _self.field(form.age) }}
                        <span class="input-group-text">ans</span>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">{{ form.gender.vars.label }} <span class="text-danger">*</span></label>
                    <div class="anicare-radio-group">
                        {% for choice in form.gender %}
                            <div class="form-check form-check-inline anicare-radio-item">
                                {{ form_widget(choice, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(choice, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        {% endfor %}
                    </div>
                    {% if form.gender.vars.errors|length %}
                        <div class="text-danger small mt-1">{{ form_errors(form.gender) }}</div>
                    {% endif %}
                </div>
            </div>

            {# ── Mensurations ── #}
            <p class="page-eyebrow mb-2">Mensurations</p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    {{ form_label(form.height, null, {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        {{ _self.field(form.height) }}
                        <span class="input-group-text">m</span>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    {{ form_label(form.weight, null, {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        {{ _self.field(form.weight) }}
                        <span class="input-group-text">kg</span>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    {{ form_label(form.averageWeight, null, {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        {{ _self.field(form.averageWeight) }}
                        <span class="input-group-text">kg</span>
                    </div>
                </div>
            </div>

            {# ── Identification ── #}
            <p class="page-eyebrow mb-2">Identification</p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    {{ form_label(form.identificationNumber, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ _self.field(form.identificationNumber) }}
                </div>

                <div class="col-12 col-md-6">
                    {{ form_label(form.microchipNumber, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ _self.field(form.microchipNumber) }}
                </div>
            </div>

            {# ── Photo & Documents ── #}
            <p class="page-eyebrow mb-2">Photo & Documents</p>
            <div class="row g-3">
                <div class="col-12">
                    <div class="file-upload-card">
                        {{ form_label(form.photoFile, null, {'label_attr': {'class': 'form-label'}}) }}

                        {% if form.vars.data.photo is defined and form.vars.data.photo %}
                            <div class="mb-2">
                                <img src="{{ asset('uploads/photos/' ~ form.vars.data.photo) }}"
                                     alt="Photo actuelle"
                                     class="rounded-3 border"
                                     style="max-height: 120px; object-fit: cover;">
                                <span class="text-secondary small d-block mt-1">Photo actuelle — sélectionnez un fichier pour la remplacer.</span>
                            </div>
                        {% endif %}

                        {{ _self.field(form.photoFile) }}

                        {% if form.photoFile.vars.help %}
                            <div class="form-text">{{ form.photoFile.vars.help }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-12">
                    <div class="file-upload-card">
                        {{ form_label(form.attachments, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.attachments) }}

                        {% if form.attachments.vars.help %}
                            <div class="form-text">{{ form.attachments.vars.help }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ══════════════════════════════════════════════════════════
       COLONNE DROITE — Lieu de vie
       ══════════════════════════════════════════════════════════ #}
    <div class="col-12 col-lg-5">
        <div class="d-flex flex-column gap-4">
            {# ── Contact de confiance ── #}
            <div class="p-4 rounded-3 border border-anicare bg-white mb-4" style="border-left: 4px solid #dc3545 !important;">
                <p class="page-eyebrow mb-2" style="color: #dc3545;">Contact de confiance</p>
                <p class="text-secondary small mb-3">Personne à contacter en cas d'urgence concernant ce cheval.</p>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        {{ form_label(form.trustedContactLastName, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.trustedContactLastName) }}
                    </div>

                    <div class="col-12 col-md-6">
                        {{ form_label(form.trustedContactFirstName, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.trustedContactFirstName) }}
                    </div>

                    <div class="col-12">
                        {{ form_label(form.trustedContactPhone, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.trustedContactPhone) }}
                    </div>
                </div>
            </div>

            {# ── Lieu de vie ── #}
            <div class="p-4 rounded-3 border border-anicare bg-white" style="border-left: 4px solid #C8973E !important;">
                <p class="page-eyebrow mb-2" style="color: #C8973E; border-bottom-color: #C8973E;">Lieu de vie</p>
                <div class="row g-3">
                    <div class="col-12">
                        {{ form_label(form.livingPlaceName, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceName) }}
                    </div>

                    <div class="col-12 col-md-6">
                        {{ form_label(form.livingPlaceManagerLastName, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceManagerLastName) }}
                    </div>

                    <div class="col-12 col-md-6">
                        {{ form_label(form.livingPlaceManagerFirstName, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceManagerFirstName) }}
                    </div>

                    <div class="col-12 col-md-6">
                        {{ form_label(form.livingPlaceManagerPhone, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceManagerPhone) }}
                    </div>

                    <div class="col-12 col-md-6">
                        {{ form_label(form.livingPlaceManagerEmail, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceManagerEmail) }}
                    </div>

                    <div class="col-12">
                        {{ form_label(form.livingPlaceStreet, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceStreet) }}
                    </div>

                    <div class="col-12">
                        {{ form_label(form.livingPlaceComplement, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceComplement) }}
                    </div>

                    <div class="col-12 col-md-4">
                        {{ form_label(form.livingPlacePostalCode, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlacePostalCode) }}
                    </div>

                    <div class="col-12 col-md-4">
                        {{ form_label(form.livingPlaceCity, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceCity) }}
                    </div>

                    <div class="col-12 col-md-4">
                        {{ form_label(form.livingPlaceCountry, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ _self.field(form.livingPlaceCountry, 'form-select') }}
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════════════
   LIGNE PLEINE LARGEUR — Professionnel & Rappels
   ══════════════════════════════════════════════════════════ #}
<div class="row g-4 mt-0">
    {# ── Inviter un professionnel ── #}
    <div class="col-12 col-lg-6">
        <div class="p-4 rounded-3 border border-anicare bg-white h-100" style="border-left: 4px solid var(--primary-color) !important;">
            <p class="page-eyebrow mb-2" style="color: var(--primary-color);">Inviter un professionnel</p>
            <p class="text-secondary small mb-3">Recherchez dans l'annuaire pour partager la fiche du cheval avec un professionnel.</p>

            <div class="position-relative mb-2">
                <input type="text" id="proSearchInput" class="form-control" placeholder="Rechercher un professionnel..." autocomplete="off">
                <div id="proSearchResults" class="list-group position-absolute w-100 shadow-sm" style="z-index: 10; display: none; max-height: 200px; overflow-y: auto;"></div>
            </div>

            <div id="proSelected" style="display: none;">
                <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background-color: var(--soft-teal);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <div class="flex-grow-1">
                        <strong id="proSelectedName" class="small" style="color: var(--primary-hover);"></strong>
                        <span id="proSelectedInfo" class="d-block small text-secondary"></span>
                    </div>
                    <button type="button" id="proRemoveBtn" class="btn btn-sm btn-outline-danger border-0" style="font-size: 0.8rem;">&#10005;</button>
                </div>
                <input type="hidden" name="professional_id" id="proIdInput" value="">
            </div>
        </div>
    </div>

    {# ── Rappels ── #}
    <div class="col-12 col-lg-6">
        <div class="p-4 rounded-3 border border-anicare bg-white h-100" style="border-left: 4px solid var(--warning-color) !important;">
            <p class="page-eyebrow mb-2" style="color: var(--warning-color);">Rappels</p>
            <p class="text-secondary small mb-3">Planifiez des rappels qui apparaitront dans votre agenda.</p>

            <div id="remindersContainer"></div>

            <button type="button" id="addReminderBtn" class="btn btn-outline-secondary btn-sm w-100 mt-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Ajouter un rappel
            </button>
        </div>
    </div>
</div>

{{ form_rest(form) }}

<button type="submit" class="btn btn-primary btn-lg w-100 mt-4">
    {{ button_label|default('Enregistrer') }}
</button>

{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Robe "Autre" toggle
    const coatSelect = document.getElementById('{{ form.coat.vars.id }}');
    const coatCustomGroup = document.getElementById('coatCustomGroup');
    if (coatSelect && coatCustomGroup) {
        coatSelect.addEventListener('change', function () {
            coatCustomGroup.style.display = this.value === 'Autre' ? '' : 'none';
        });
    }

    // Synchronisation date de naissance ↔ âge
    const birthDateInput = document.getElementById('{{ form.birthDate.vars.id }}');
    const ageInput = document.getElementById('{{ form.age.vars.id }}');

    if (birthDateInput && ageInput) {
        let syncing = false;

        birthDateInput.addEventListener('change', function () {
            if (syncing) return;
            syncing = true;
            if (this.value) {
                const birth = new Date(this.value);
                const today = new Date();
                let age = today.getFullYear() - birth.getFullYear();
                const m = today.getMonth() - birth.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
                ageInput.value = Math.max(0, age);
            } else {
                ageInput.value = '';
            }
            syncing = false;
        });

        ageInput.addEventListener('input', function () {
            if (syncing) return;
            syncing = true;
            if (this.value !== '' && !isNaN(this.value)) {
                const age = parseInt(this.value, 10);
                const year = new Date().getFullYear() - age;
                birthDateInput.value = year + '-01-01';
            } else {
                birthDateInput.value = '';
            }
            syncing = false;
        });

        if (birthDateInput.value && !ageInput.value) {
            birthDateInput.dispatchEvent(new Event('change'));
        }
    }

    // ── Recherche professionnel (autocomplete) ──
    const proInput = document.getElementById('proSearchInput');
    const proResults = document.getElementById('proSearchResults');
    const proSelected = document.getElementById('proSelected');
    const proIdInput = document.getElementById('proIdInput');
    const proSelectedName = document.getElementById('proSelectedName');
    const proSelectedInfo = document.getElementById('proSelectedInfo');
    const proRemoveBtn = document.getElementById('proRemoveBtn');
    let proDebounce = null;

    if (proInput) {
        proInput.addEventListener('input', function () {
            clearTimeout(proDebounce);
            const q = this.value.trim();
            if (q.length < 2) { proResults.style.display = 'none'; return; }

            proDebounce = setTimeout(function () {
                fetch('{{ path("api_professionals_search") }}?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        proResults.innerHTML = '';
                        if (data.length === 0) {
                            proResults.innerHTML = '<div class="list-group-item text-secondary small">Aucun professionnel trouve.</div>';
                        } else {
                            data.forEach(function (pro) {
                                var item = document.createElement('button');
                                item.type = 'button';
                                item.className = 'list-group-item list-group-item-action py-2';
                                item.innerHTML = '<strong>' + pro.fullName + '</strong><br><span class="small text-secondary">' + pro.email + (pro.city ? ' — ' + pro.city : '') + '</span>';
                                item.addEventListener('click', function () {
                                    proIdInput.value = pro.id;
                                    proSelectedName.textContent = pro.fullName;
                                    proSelectedInfo.textContent = pro.email + (pro.city ? ' — ' + pro.city : '');
                                    proSelected.style.display = 'block';
                                    proInput.style.display = 'none';
                                    proResults.style.display = 'none';
                                });
                                proResults.appendChild(item);
                            });
                        }
                        proResults.style.display = 'block';
                    });
            }, 300);
        });

        proRemoveBtn.addEventListener('click', function () {
            proIdInput.value = '';
            proSelected.style.display = 'none';
            proInput.style.display = 'block';
            proInput.value = '';
        });

        document.addEventListener('click', function (e) {
            if (!proInput.contains(e.target) && !proResults.contains(e.target)) {
                proResults.style.display = 'none';
            }
        });
    }

    // ── Rappels dynamiques ──
    var reminderIdx = 0;
    var container = document.getElementById('remindersContainer');
    var addBtn = document.getElementById('addReminderBtn');

    if (addBtn && container) {
        addBtn.addEventListener('click', function () {
            var row = document.createElement('div');
            row.className = 'reminder-row border rounded-3 p-3 mb-2';
            row.style.backgroundColor = '#fffdf5';
            row.innerHTML =
                '<div class="row g-2 align-items-end">' +
                    '<div class="col-12 col-md-5">' +
                        '<label class="form-label small fw-bold">Motif</label>' +
                        '<input type="text" name="reminder_title[]" class="form-control form-control-sm" placeholder="Ex : Vaccin, Vermifuge..." required>' +
                    '</div>' +
                    '<div class="col-6 col-md-3">' +
                        '<label class="form-label small fw-bold">Date</label>' +
                        '<input type="datetime-local" name="reminder_date[]" class="form-control form-control-sm" required>' +
                    '</div>' +
                    '<div class="col-6 col-md-3">' +
                        '<label class="form-label small fw-bold">Recurrence</label>' +
                        '<select name="reminder_recurrence[]" class="form-select form-select-sm">' +
                            '<option value="">Aucune</option>' +
                            '<option value="weekly">Hebdomadaire</option>' +
                            '<option value="monthly">Mensuel</option>' +
                            '<option value="quarterly">Trimestriel</option>' +
                            '<option value="biannual">Semestriel</option>' +
                            '<option value="annual">Annuel</option>' +
                        '</select>' +
                    '</div>' +
                    '<div class="col-auto col-md-1 d-flex align-items-end">' +
                        '<button type="button" class="btn btn-outline-danger btn-sm remove-reminder-btn" title="Supprimer">' +
                            '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
                        '</button>' +
                    '</div>' +
                '</div>';
            container.appendChild(row);

            row.querySelector('.remove-reminder-btn').addEventListener('click', function () {
                row.remove();
            });
        });
    }
});
</script>
