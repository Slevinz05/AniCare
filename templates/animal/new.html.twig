{% extends 'base.html.twig' %}

{% block title %}Ajouter un cheval - AniCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <div class="card form-card">
                <div class="card-body p-0">

                    <div class="mb-4 pb-4 border-bottom" style="border-color: var(--border-color) !important;">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <a href="{{ path('app_animal_index') }}" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px; padding: 0.3rem 0.6rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                            </a>
                            <p class="page-eyebrow mb-0" style="color: var(--accent-color);">Nouveau cheval</p>
                        </div>

                        <h1 class="page-title mb-2">
                            Ajouter un cheval
                        </h1>

                        <p class="page-subtitle mb-0">
                            Créez son profil pour commencer le suivi de son carnet de santé.
                        </p>
                    </div>

                    {{ include('animal/_form.html.twig', {
                        'button_label': 'Créer le profil'
                    }) }}


                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
