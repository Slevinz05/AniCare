{% extends 'base.html.twig' %}

{% block title %}Ajouter un cheval - AniCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <div class="card form-card">
                <div class="card-body p-0">

                    <div class="mb-4 pb-4 border-bottom" style="border-color: var(--border-color) !important;">
                        <p class="page-eyebrow mb-2" style="color: var(--accent-color);">Nouveau cheval</p>

                        <h1 class="page-title mb-2">
                            Ajouter un cheval
                        </h1>

                        <p class="page-subtitle mb-0">
                            Créez son profil pour commencer le suivi de son carnet de santé.
                        </p>
                    </div>

                    {{ include('animal/_form.html.twig', {
                        'button_label': 'Créer le profil'
                    }) }}

                    <div class="mt-4 pt-4 border-top" style="border-color: var(--border-color) !important;">
                        <a href="{{ path('app_animal_index') }}" class="btn btn-outline-secondary">
                            Retour
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
