{# templates/animal/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Mes animaux - AniCare{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="page-hero p-4 p-lg-5 mb-5">
        <div class="row align-items-center gy-3">
            <div class="col-12 col-lg">
                <p class="page-eyebrow mb-2">Carnet de santé numérique</p>
                <h1 class="page-title mb-2">🐾 Mes animaux</h1>
                <p class="page-subtitle mb-0">
                    Retrouvez les profils de vos compagnons et accédez rapidement à leur suivi médical.
                </p>
            </div>

            <div class="col-12 col-lg-auto">
                <a href="{{ path('app_animal_new') }}" class="btn btn-primary shadow-sm">
                    ➕ Ajouter un compagnon
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        {% for animal in animals %}
            <div class="col-12 col-md-6 col-lg-4">
                {{ include('_partials/_animal_card.html.twig', {'animal': animal}) }}
            </div>
        {% else %}
            <div class="col-12">
                <div class="empty-state text-center p-5">
                    <span class="empty-state-icon mb-3">🐱🐶</span>

                    <h2 class="h4 page-title mb-2">
                        Aucun compagnon enregistré
                    </h2>

                    <p class="text-secondary mb-4">
                        Commencez par ajouter un animal pour suivre son livret médical en ligne.
                    </p>

                    <a href="{{ path('app_animal_new') }}" class="btn btn-primary">
                        Créer un premier profil
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}