{% extends 'base.html.twig' %}

{% block title %}Liste des animaux - AniCare{% endblock %}

{% block body %}
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1>Mes Animaux</h1>
        <a href="{{ path('app_animal_new') }}" class="btn">+ Ajouter un animal</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Espèce</th>
                <th>Race</th>
                <th>Genre</th>
                <th>Poids</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for animal in animals %}
            <tr>
                <td><strong>{{ animal.name }}</strong></td>
                <td>{{ animal.species }}</td>
                <td>{{ animal.breed ?: '-' }}</td>
                <td>
                    {# Appel du composant partiel #}
                    {{ include('_partials/_gender_badge.html.twig', {'gender': animal.gender}) }}
                </td>
                <td>{{ animal.weight ? animal.weight ~ ' kg' : '-' }}</td>
                <td>
                    <a href="{{ path('app_animal_show', {'id': animal.id}) }}" class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.9rem;">Voir</a>
                    <a href="{{ path('app_animal_edit', {'id': animal.id}) }}" class="btn" style="padding: 5px 10px; font-size: 0.9rem; background-color: #64748b;">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" style="text-align: center; padding: 30px; color: #64748b;">
                    Aucun animal enregistré pour le moment.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}