{% extends 'base.html.twig' %}
{% block title %}Conversation avec {{ recipient.fullName }} - AniCare{% endblock %}
{% block body %}
<div class="container py-4">
    <div class="card anicare-card overflow-hidden">
        <div class="card-header medical-header p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; background-color: var(--primary-color); color: #fff; font-weight: 700; font-size: 1rem;">
                        {{ recipient.firstName|first|upper }}{{ recipient.lastName|first|upper }}
                    </div>
                    <div>
                        <p class="page-eyebrow mb-1">Messagerie</p>
                        <h1 class="page-title mb-0">{{ recipient.fullName }}</h1>
                        {% if recipient.specialty %}
                            <span class="badge mt-1" style="background-color: var(--primary-color); font-size: 0.65rem;">{{ recipient.specialty }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_message_index') }}" class="btn btn-outline-primary btn-sm">Toutes les conversations</a>
                    <a href="{{ path('app_directory') }}" class="btn btn-outline-primary btn-sm">Annuaire</a>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="message-thread mb-4" id="messageThread" style="max-height: 500px; overflow-y: auto;">
                {% if messages is empty %}
                    <div class="text-center text-secondary py-5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="mb-3" style="opacity: 0.4;">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <p class="mb-1">Aucun message pour le moment.</p>
                        <p class="small">Envoyez un premier message a {{ recipient.fullName }}.</p>
                    </div>
                {% else %}
                    {% for msg in messages %}
                        {% set is_mine = msg.sender == app.user %}
                        <div class="d-flex mb-3 {{ is_mine ? 'justify-content-end' : 'justify-content-start' }}">
                            {% if not is_mine %}
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-2" style="width: 32px; height: 32px; background-color: var(--primary-color); color: #fff; font-weight: 600; font-size: 0.7rem; align-self: flex-end;">
                                    {{ msg.sender.firstName|first|upper }}{{ msg.sender.lastName|first|upper }}
                                </div>
                            {% endif %}
                            <div class="p-3 rounded-3 {{ is_mine ? 'bg-anicare-soft' : 'bg-light' }}" style="max-width: 75%;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small {{ is_mine ? 'text-teal' : 'text-dark' }}">
                                        {{ is_mine ? 'Vous' : msg.sender.fullName }}
                                    </strong>
                                    <span class="text-secondary small ms-3">
                                        {{ msg.createdAt|date('d/m H:i') }}
                                    </span>
                                </div>
                                {% if msg.content %}
                                    <p class="mb-0">{{ msg.content|e('html')|nl2br }}</p>
                                {% endif %}
                                {% if msg.attachmentFilename %}
                                    <div class="mt-2 p-2 rounded bg-white border d-inline-flex align-items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                                        <a href="{{ path('app_message_download', {'id': msg.id}) }}" class="small text-teal fw-bold text-decoration-none">
                                            {{ msg.attachmentOriginalName ?? msg.attachmentFilename }}
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="border-top border-anicare pt-4">
                {{ form_start(form, {'attr': {'class': 'anicare-form', 'enctype': 'multipart/form-data'}}) }}
                    <div class="d-flex gap-2 align-items-end">
                        <div class="flex-grow-1">
                            {{ form_widget(form.content, {'attr': {'class': 'form-control', 'rows': 2, 'placeholder': 'Votre message...'}}) }}
                        </div>
                        <button type="submit" class="btn btn-primary">Envoyer</button>
                    </div>
                    <div class="mt-2">
                        <div class="d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-secondary"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                            {{ form_widget(form.attachmentFile) }}
                        </div>
                    </div>
                    {{ form_rest(form) }}
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var thread = document.getElementById('messageThread');
    if (thread) thread.scrollTop = thread.scrollHeight;
});
</script>
{% endblock %}
