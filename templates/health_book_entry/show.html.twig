{% extends 'base.html.twig' %}

{% block title %}Détail de la consultation - AniCare{% endblock %}

{% block body %}
{% set entry_type = health_book_entry.type|default('')|lower %}

<div class="container py-4">
    <div class="card anicare-card overflow-hidden">
        <div class="card-header medical-header p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <p class="page-eyebrow mb-2">Détail de la consultation</p>

                    <h1 class="page-title mb-1">
                        {{ health_book_entry.title }}
                    </h1>

                    <p class="page-subtitle mb-0">
                        Consultation n°{{ health_book_entry.id }}
                    </p>
                </div>

                <div>
                    {% if entry_type == 'vaccination' or entry_type == 'vaccin' %}
                        <span class="badge-medical badge-vaccin">Vaccination</span>
                    {% elseif entry_type == 'chirurgie' %}
                        <span class="badge-medical badge-surgery">Chirurgie</span>
                    {% elseif entry_type == 'consultation' %}
                        <span class="badge-medical badge-consultation">Consultation</span>
                    {% else %}
                        <span class="badge-medical badge-neutral">
                            {{ health_book_entry.type ?: 'Non renseigné' }}
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="table-responsive mb-5">
                <table class="table table-hover table-medical align-middle mb-0">
                    <tbody>
                        <tr>
                            <th style="width: 35%;">Cheval concerné</th>
                            <td>
                                <strong class="text-teal">
                                    {{ health_book_entry.animal.name ?? 'Non spécifié' }}
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <th>Intitulé de la consultation</th>
                            <td>{{ health_book_entry.title }}</td>
                        </tr>

                        <tr>
                            <th>Type de consultation</th>
                            <td>
                                {% if entry_type == 'vaccination' or entry_type == 'vaccin' %}
                                    <span class="badge-medical badge-vaccin">Vaccination</span>
                                {% elseif entry_type == 'chirurgie' %}
                                    <span class="badge-medical badge-surgery">Chirurgie</span>
                                {% elseif entry_type == 'consultation' %}
                                    <span class="badge-medical badge-consultation">Consultation</span>
                                {% else %}
                                    <span class="badge-medical badge-neutral">
                                        {{ health_book_entry.type ?: 'Non renseigné' }}
                                    </span>
                                {% endif %}
                            </td>
                        </tr>

                        <tr>
                            <th>Date de la consultation</th>
                            <td>
                                {{ health_book_entry.date ? health_book_entry.date|date('d/m/Y') : 'Non renseignée' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Intervenant</th>
                            <td>
                                {% if health_book_entry.veterinarian %}
                                    <a href="{{ path('app_professional_show', {'id': health_book_entry.veterinarian.id}) }}" class="text-decoration-none fw-bold" style="color: var(--primary-color);">
                                        {{ health_book_entry.veterinarian.fullName }}
                                    </a>
                                    {% if health_book_entry.veterinarian.specialty %}
                                        <span class="badge ms-1" style="background-color: var(--primary-color); font-size: 0.65rem;">{{ health_book_entry.veterinarian.specialty }}</span>
                                    {% endif %}
                                    {% if health_book_entry.veterinarian.phone %}
                                        <br><a href="tel:{{ health_book_entry.veterinarian.phone }}" class="small text-decoration-none text-secondary">{{ health_book_entry.veterinarian.phone }}</a>
                                    {% endif %}
                                {% elseif health_book_entry.veterinarianName %}
                                    {{ health_book_entry.veterinarianName }}
                                {% else %}
                                    Non renseigné
                                {% endif %}
                            </td>
                        </tr>

                        {% if health_book_entry.dosage %}
                            <tr>
                                <th>Posologie</th>
                                <td>{{ health_book_entry.dosage }}</td>
                            </tr>
                        {% endif %}

                        {% if health_book_entry.frequency %}
                            <tr>
                                <th>Fréquence</th>
                                <td>{{ health_book_entry.frequency }}</td>
                            </tr>
                        {% endif %}

                        {% if health_book_entry.endDate %}
                            <tr>
                                <th>Date de fin</th>
                                <td>{{ health_book_entry.endDate|date('d/m/Y') }}</td>
                            </tr>
                        {% endif %}

                        {% if health_book_entry.batchNumber %}
                            <tr>
                                <th>Numéro de lot</th>
                                <td>{{ health_book_entry.batchNumber }}</td>
                            </tr>
                        {% endif %}

                        {% if health_book_entry.nextReminderAt %}
                            <tr>
                                <th>Prochain rappel</th>
                                <td>
                                    {{ health_book_entry.nextReminderAt|date('d/m/Y') }}
                                    {% if health_book_entry.isOverdueReminder %}
                                        <span class="badge bg-danger ms-2">En retard</span>
                                    {% elseif health_book_entry.isDueSoon %}
                                        <span class="badge bg-warning text-dark ms-2">Bientôt</span>
                                    {% endif %}
                                    {% if health_book_entry.recurrenceLabel %}
                                        <span class="text-secondary small ms-2">({{ health_book_entry.recurrenceLabel }})</span>
                                    {% elseif health_book_entry.recurrenceMonths %}
                                        <span class="text-secondary small ms-2">(tous les {{ health_book_entry.recurrenceMonths }} mois)</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endif %}

                        <tr>
                            <th>Description / observations</th>
                            <td>
                                {% if health_book_entry.description %}
                                    <div class="health-entry-note">
                                        {{ health_book_entry.description|e('html')|nl2br }}
                                    </div>
                                {% else %}
                                    <span class="text-secondary">
                                        Aucune observation renseignée.
                                    </span>
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            {% if health_book_entry.anatomicalLocations is not empty %}
            <section class="mb-5">
                <p class="page-eyebrow mb-2">Localisation anatomique</p>
                <h2 class="h4 page-title mb-3">Zones identifiées</h2>
                <div class="d-flex flex-wrap gap-2">
                    {% for loc in health_book_entry.anatomicalLocations %}
                        <span class="badge rounded-pill {{ loc.type == 'bone' ? 'text-bg-primary' : '' }}" style="{{ loc.type == 'ligament' ? 'background-color: var(--accent-color); color: #fff;' : '' }}">
                            {{ loc.name }}
                        </span>
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            <section class="mb-5">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <div>
                        <p class="page-eyebrow mb-2">Documents</p>

                        <h2 class="h4 page-title mb-0">
                            Documents associés
                        </h2>
                    </div>

                    <a href="{{ path('app_health_book_entry_edit', {'id': health_book_entry.id}) }}" class="btn btn-outline-primary btn-sm">
                        Ajouter un document
                    </a>
                </div>

                {% if health_book_entry.documents is empty %}
                    <div class="alert bg-anicare-soft border border-anicare text-secondary mb-0">
                        Aucun document n'est encore associé à cette consultation.
                    </div>
                {% else %}
                    <div class="document-list">
                        {% for document in health_book_entry.documents %}
                            <div class="document-item d-flex justify-content-between align-items-center flex-wrap gap-2 py-2 {{ not loop.last ? 'border-bottom border-light' : '' }}">
                                <div>
                                    <a href="{{ path('app_document_download_health_entry', {'entryId': health_book_entry.id, 'fileName': document.fileName}) }}"
                                       target="_blank" rel="noopener" class="document-name text-decoration-none">
                                        {{ document.originalName|default(document.fileName) }}
                                    </a>
                                    <span class="document-meta d-block small text-secondary">
                                        {% if document.size is defined %}
                                            {{ (document.size / 1024)|round(0, 'ceil') }} Ko
                                        {% endif %}
                                        {% if document.uploadedAt is defined %}
                                            · {{ document.uploadedAt|date('d/m/Y') }}
                                        {% endif %}
                                    </span>
                                </div>
                                <form method="post"
                                      action="{{ path('app_health_book_entry_document_delete', {'id': health_book_entry.id, 'fileName': document.fileName}) }}"
                                      onsubmit="return confirm('Supprimer ce document ?');"
                                      style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_doc' ~ document.fileName) }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Supprimer">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </form>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-4 border-top border-anicare">
                <div class="d-flex gap-2">
                    <a href="{{ path('app_health_book_entry_index') }}" class="btn btn-outline-primary">
                        Retour
                    </a>
                    <a href="{{ path('app_health_book_entry_import') }}" class="btn btn-outline-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="me-1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        Importer
                    </a>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('app_health_book_entry_edit', {'id': health_book_entry.id}) }}" class="btn btn-primary">
                        Modifier
                    </a>

                    {{ include('health_book_entry/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
