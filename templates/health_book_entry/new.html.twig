{% extends 'base.html.twig' %}

{% block title %}Nouvelle consultation - AniCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card form-card">
                <div class="card-body p-0">

                    <div class="mb-4 pb-4 border-bottom border-anicare">
                        <p class="page-eyebrow mb-2">Consultations</p>

                        <h1 class="page-title mb-2">
                            Nouvelle consultation
                        </h1>

                        <p class="page-subtitle mb-0">
                            Renseignez un soin, une consultation, un vaccin ou une intervention.
                        </p>
                    </div>

                    {{ include('health_book_entry/_form.html.twig', {
                        'button_label': 'Enregistrer la consultation'
                    }) }}

                    <div class="mt-4 pt-4 border-top border-anicare">
                        <a href="{{ path('app_health_book_entry_index') }}" class="btn btn-outline-primary">
                            Retour
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
