        <legend class="page-eyebrow mb-0" style="font-size: 0.75rem;">
            <button type="button" class="btn btn-sm w-100 text-start d-flex align-items-center justify-content-between text-white fw-bold rounded-2 px-3 py-2" style="background: linear-gradient(135deg, var(--primary-color, #1a4d45), var(--primary-hover, #153d37));" data-bs-toggle="collapse" data-bs-target="#bilanStatiqueCollapse" aria-expanded="false" aria-controls="bilanStatiqueCollapse">
                Bilan de l'examen statique / palpation
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="bilan-chevron"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
        </legend>
        <div class="collapse" id="bilanStatiqueCollapse">
            <div class="pt-3">
                <div class="col-12">
                    <div class="dictaphone-wrap">
                        {{ form_widget(form.staticExamination, {'attr': {'class': 'form-control dictaphone-target'}}) }}
                        <button type="button" class="btn-dictaphone" title="Dicter">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                        </button>
                    </div>
                    {{ form_errors(form.staticExamination) }}
                </div>
            </div>
        </div>
    </fieldset>

    {# ── Section : Localisation anatomique (SVG cheval interactif) ── #}
    {% if is_granted('ROLE_PRO') %}
    <fieldset class="mb-4 pb-4 border-bottom border-light">
        {{ include('_partials/_horse_anatomy.html.twig') }}
    </fieldset>
    {% endif %}

    {# ── Section : Rééducation ── #}
    <fieldset class="mb-4 pb-4 border-bottom border-light">
        <legend class="page-eyebrow mb-0" style="font-size: 0.75rem;">
            <button type="button" class="btn btn-sm w-100 text-start d-flex align-items-center justify-content-between text-white fw-bold rounded-2 px-3 py-2" style="background: linear-gradient(135deg, var(--primary-color, #1a4d45), var(--primary-hover, #153d37));" data-bs-toggle="collapse" data-bs-target="#reeducationCollapse" aria-expanded="false" aria-controls="reeducationCollapse">
                Rééducation
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="bilan-chevron"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
        </legend>
        <div class="collapse" id="reeducationCollapse">
            <div class="pt-3">
                <div class="col-12 mb-3">
                    {{ form_label(form.rehabilitationType, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {% set rehab_tpls = app.user.rehabilitationTemplates|default([]) %}
                    {{ form_widget(form.rehabilitationType, {'attr': {
                        'class': 'form-select',
                        'id': 'rehab-type-select',
                        'data-templates': rehab_tpls|json_encode
                    }}) }}
                    {{ form_errors(form.rehabilitationType) }}
                </div>
                <div class="col-12">
                    <div class="dictaphone-wrap">
                        {{ form_widget(form.rehabilitation, {'attr': {'class': 'form-control dictaphone-target', 'placeholder': 'Programme de rééducation, exercices, consignes...'}}) }}
                        <button type="button" class="btn-dictaphone" title="Dicter">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                        </button>
                    </div>
                    {{ form_errors(form.rehabilitation) }}
