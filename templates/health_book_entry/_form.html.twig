{{ form_start(form, {
    'attr': {
        'class': 'health-entry-form anicare-form needs-validation',
        'novalidate': 'novalidate'
    }
}) }}

    {# ── Section 1 : Informations principales ── #}
    <fieldset class="mb-4 pb-4 border-bottom border-light">
        <legend class="page-eyebrow mb-3" style="font-size: 0.75rem;">Informations principales</legend>
        <div class="row g-3">
            {% if form.animal is defined %}
                <div class="col-12">
                    {{ form_label(form.animal, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.animal, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.animal) }}
                </div>
            {% endif %}

            <div class="col-12 col-md-6">
                {{ form_label(form.type, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.type, {'attr': {'class': 'form-select', 'id': 'health_type_select'}}) }}
                {{ form_errors(form.type) }}
            </div>

            <div class="col-12 col-md-6" id="typeCustomGroup" style="{{ form.type.vars.data != 'Autre' ? 'display:none;' : '' }}">
                {{ form_label(form.typeCustom, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.typeCustom, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.typeCustom) }}
            </div>

            <div class="col-12">
                {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="col-12 col-md-7">
                {{ form_label(form.date, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                <div style="display:none;">{{ form_widget(form.date, {'attr': {'id': 'health_book_entry_date'}}) }}</div>
                <div class="d-flex align-items-center gap-2">
                    <input type="date" id="hbe-date" class="form-control" style="flex: 1 1 auto;">
                    <div class="input-group" style="flex: 0 0 auto; width: auto;">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="hbe-h-down" title="-1h">−</button>
                        <span class="input-group-text time-picker-display" id="hbe-hours">00</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="hbe-h-up" title="+1h">+</button>
                        <span class="input-group-text time-picker-colon">:</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="hbe-m-down" title="-5 min">−</button>
                        <span class="input-group-text time-picker-display" id="hbe-minutes">00</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="hbe-m-up" title="+5 min">+</button>
                    </div>
                </div>
                {{ form_errors(form.date) }}
            </div>

            <div class="col-12 col-md-5">
                {{ form_label(form.appointment, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.appointment, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.appointment) }}
            </div>

            <div class="col-12 col-md-6">
                {{ form_label(form.veterinarian, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.veterinarian, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.veterinarian) }}
            </div>
        </div>
    </fieldset>

    {# ── Section 2 : Anamnèse ── #}
    <fieldset class="mb-4 pb-4 border-bottom border-light">
        <legend class="page-eyebrow mb-0" style="font-size: 0.75rem;">
            <button type="button" class="btn btn-sm w-100 text-start d-flex align-items-center justify-content-between text-white fw-bold rounded-2 px-3 py-2" style="background: linear-gradient(135deg, var(--primary-color, #1a4d45), var(--primary-hover, #153d37));" data-bs-toggle="collapse" data-bs-target="#anamneseCollapse" aria-expanded="false" aria-controls="anamneseCollapse">
                Anamnèse / Commémoratif
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="bilan-chevron"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
        </legend>
        <div class="collapse" id="anamneseCollapse">
            <div class="pt-3">
                <div class="col-12">
                    <div class="dictaphone-wrap">
                        {{ form_widget(form.anamnesis, {'attr': {'class': 'form-control dictaphone-target'}}) }}
                        <button type="button" class="btn-dictaphone" title="Dicter">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                        </button>
                    </div>
                    {{ form_errors(form.anamnesis) }}
                </div>
            </div>
        </div>
    </fieldset>



    {# ── Section : Bilan statique / palpation ── #}
