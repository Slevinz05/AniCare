    {# ── Section 3 : Traitement ── #}
    <fieldset class="mb-4 pb-4 border-bottom border-light">
        <legend class="page-eyebrow mb-3" style="font-size: 0.75rem;">Traitement</legend>
        <div class="row g-3">
            <div class="col-12 col-md-6">
                {{ form_label(form.dosage, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.dosage, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.dosage) }}
            </div>

            <div class="col-12 col-md-6">
                {{ form_label(form.frequency, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.frequency, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.frequency) }}
            </div>

            <div class="col-12 col-md-4">
                {{ form_label(form.endDate, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.endDate, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.endDate) }}
            </div>

            <div class="col-12 col-md-4">
                {{ form_label(form.batchNumber, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.batchNumber, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.batchNumber) }}
            </div>
        </div>
    </fieldset>

    {# ── Section 4 : Rappels ── #}
    <fieldset class="mb-4 pb-4 border-bottom border-light">
        <legend class="page-eyebrow mb-3" style="font-size: 0.75rem;">Rappels</legend>
        <div class="row g-3">
            <div class="col-12 col-md-6">
                {{ form_label(form.nextReminderAt, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.nextReminderAt, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.nextReminderAt) }}
            </div>

            <div class="col-12 col-md-6">
                {{ form_label(form.recurrenceType, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.recurrenceType, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.recurrenceType) }}
            </div>
        </div>
    </fieldset>

    {# ── Section 5 : Documents ── #}
    <fieldset class="mb-4">
        <legend class="page-eyebrow mb-3" style="font-size: 0.75rem;">Documents</legend>
        <div class="file-upload-card p-3 rounded-3 border border-dashed bg-light">
            {{ form_label(form.attachments, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(form.attachments, {'attr': {'class': 'form-control'}}) }}
            {% if form.attachments.vars.help %}
                <div class="form-text mt-1">{{ form.attachments.vars.help }}</div>
            {% endif %}
            {{ form_errors(form.attachments) }}
        </div>
    </fieldset>

    {{ form_rest(form) }}

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
            {{ button_label|default('Enregistrer la consultation') }}
        </button>
        {% if is_granted('ROLE_PRO') %}
            <button type="submit" name="save_draft" class="btn btn-outline-secondary btn-lg" title="Enregistrer comme brouillon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Brouillon
            </button>
        {% endif %}
    </div>

{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const typeSelect = document.getElementById('health_type_select');
    const typeCustomGroup = document.getElementById('typeCustomGroup');
    if (typeSelect && typeCustomGroup) {
        typeSelect.addEventListener('change', function () {
            typeCustomGroup.style.display = this.value === 'Autre' ? '' : 'none';
        });
    }

    // ── Date + heure picker (heures ±1, minutes ±5) ──
    (function() {
        var hiddenDate = document.getElementById('health_book_entry_date');
        var hbeDate = document.getElementById('hbe-date');
        var hbeH = document.getElementById('hbe-hours');
        var hbeM = document.getElementById('hbe-minutes');
        if (!hiddenDate || !hbeDate || !hbeH || !hbeM) return;

        var h = 0, m = 0;
        function pad2(n) { return String(n).padStart(2, '0'); }

        function render() {
            hbeH.textContent = pad2(h);
            hbeM.textContent = pad2(m);
        }

        function sync() {
            if (!hbeDate.value) return;
            hiddenDate.value = hbeDate.value + 'T' + pad2(h) + ':' + pad2(m);
        }

        var now;
        if (hiddenDate.value) {
            now = new Date(hiddenDate.value);
            if (isNaN(now.getTime())) now = new Date();
        } else {
            now = new Date();
            now.setMinutes(Math.round(now.getMinutes() / 5) * 5, 0, 0);
        }
        hbeDate.value = now.getFullYear() + '-' + pad2(now.getMonth() + 1) + '-' + pad2(now.getDate());
        h = now.getHours();
        m = now.getMinutes();
        render();
        sync();

        hbeDate.addEventListener('change', sync);

        document.getElementById('hbe-h-up').addEventListener('click', function() {
            h = (h + 1) % 24; render(); sync();
        });
        document.getElementById('hbe-h-down').addEventListener('click', function() {
            h = (h - 1 + 24) % 24; render(); sync();
        });
        document.getElementById('hbe-m-up').addEventListener('click', function() {
            m += 5;
            if (m >= 60) { m = 0; h = (h + 1) % 24; }
            render(); sync();
        });
        document.getElementById('hbe-m-down').addEventListener('click', function() {
            m -= 5;
            if (m < 0) { m = 55; h = (h - 1 + 24) % 24; }
            render(); sync();
        });

        var apptSelect = document.getElementById('health_book_entry_appointment');
        if (apptSelect) {
            // Store full labels and short labels
            for (var i = 0; i < apptSelect.options.length; i++) {
                var o = apptSelect.options[i];
                o.dataset.fullLabel = o.textContent;
                var parts = o.textContent.split(' — ');
                o.dataset.shortLabel = parts.length > 1 ? parts.slice(1).join(' — ') : o.textContent;
            }

            function showShortLabel() {
                var sel = apptSelect.options[apptSelect.selectedIndex];
                if (sel && sel.value) sel.textContent = sel.dataset.shortLabel;
            }

            function restoreFullLabels() {
                for (var i = 0; i < apptSelect.options.length; i++) {
                    apptSelect.options[i].textContent = apptSelect.options[i].dataset.fullLabel;
                }
            }

            apptSelect.addEventListener('focus', restoreFullLabels);
            apptSelect.addEventListener('mousedown', restoreFullLabels);
            apptSelect.addEventListener('change', function() {
                var opt = this.options[this.selectedIndex];
                if (opt && opt.value && opt.dataset.date) {
                    hbeDate.value = opt.dataset.date;
                    h = parseInt(opt.dataset.hour) || 0;
                    m = parseInt(opt.dataset.minute) || 0;
                    render(); sync();
                }
                showShortLabel();
            });
            apptSelect.addEventListener('blur', showShortLabel);

            showShortLabel();
        }
    })();

    var rehabSelect = document.getElementById('health_book_entry_rehabilitationType');
    if (rehabSelect) {
        var templates = [];
        try { templates = JSON.parse(rehabSelect.dataset.templates || '[]'); } catch(e) {}
        var rehabTextarea = document.getElementById('health_book_entry_rehabilitation');

        rehabSelect.addEventListener('change', function() {
            var selected = this.value;
            if (!selected || !rehabTextarea) return;

            var tpl = templates.find(function(t) { return t.name === selected; });
            if (!tpl || !tpl.description) return;

            var current = rehabTextarea.value.trim();
            var header = '▸ ' + tpl.name;
            var block = header + '\n' + tpl.description;

            if (current) {
                rehabTextarea.value = current + '\n\n' + block;
            } else {
                rehabTextarea.value = block;
            }

            rehabTextarea.dispatchEvent(new Event('input', { bubbles: true }));
            this.value = '';
        });
    }
});
</script>

<style>
.time-picker-display {
    font-weight: 700;
    font-size: 0.95rem;
    min-width: 32px;
    justify-content: center;
    padding: 0.25rem 0.3rem;
}
.time-picker-colon {
    min-width: auto;
    padding: 0.25rem 0.1rem;
    border-left: 0;
    border-right: 0;
    font-weight: 700;
    font-size: 0.95rem;
}
.bilan-chevron {
    transition: transform 0.3s;
}
[aria-expanded="true"] .bilan-chevron {
    transform: rotate(180deg);
}
.dictaphone-wrap {
    position: relative;
}
.dictaphone-wrap textarea {
    padding-right: 3rem;
}
.btn-dictaphone {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: none;
    border: 1.5px solid #ccc;
    border-radius: 50%;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #8a7f72;
    transition: all 0.2s;
    padding: 0;
}
.btn-dictaphone:hover {
    border-color: var(--primary-color, #1a4d45);
    color: var(--primary-color, #1a4d45);
    background: var(--soft-teal, #eef7f5);
}
.btn-dictaphone.recording {
    border-color: #ef4444;
    color: #ef4444;
    background: #fef2f2;
    animation: dictPulse 1.2s ease-in-out infinite;
}
@keyframes dictPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.3); }
    50% { box-shadow: 0 0 0 6px rgba(239,68,68,0); }
}
</style>

<script>
(function() {
    var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        document.querySelectorAll('.btn-dictaphone').forEach(function(btn) { btn.style.display = 'none'; });
        return;
    }

    document.querySelectorAll('.btn-dictaphone').forEach(function(btn) {
        var textarea = btn.closest('.dictaphone-wrap').querySelector('.dictaphone-target');
        if (!textarea) return;
        var recognition = null;

        btn.addEventListener('click', function() {
            if (btn.classList.contains('recording')) {
                if (recognition) recognition.stop();
                return;
            }

            recognition = new SpeechRecognition();
            recognition.lang = 'fr-FR';
            recognition.continuous = true;
            recognition.interimResults = true;

            var baseText = textarea.value;
            var finalTranscript = '';
            btn.classList.add('recording');

            recognition.onresult = function(e) {
                var interim = '';
                for (var i = e.resultIndex; i < e.results.length; i++) {
                    if (e.results[i].isFinal) {
                        var chunk = e.results[i][0].transcript;
                        if (finalTranscript && chunk) {
                            if (!finalTranscript.endsWith(' ')) finalTranscript += ' ';
                            chunk = chunk.charAt(0).toLowerCase() + chunk.slice(1);
                        }
                        finalTranscript += chunk;
                    } else {
                        interim += e.results[i][0].transcript;
                    }
                }
                var sep = baseText && !baseText.endsWith(' ') && !baseText.endsWith('\n') ? ' ' : '';
                textarea.value = baseText + sep + finalTranscript + (interim ? ' ' + interim + ' [...]' : '');
            };

            recognition.onend = function() {
                btn.classList.remove('recording');
                var sep = baseText && !baseText.endsWith(' ') && !baseText.endsWith('\n') ? ' ' : '';
                textarea.value = baseText + sep + finalTranscript;
                textarea.dispatchEvent(new Event('input', { bubbles: true }));
                recognition = null;
            };

            recognition.onerror = function(e) {
                btn.classList.remove('recording');
                recognition = null;
                if (e.error !== 'aborted' && e.error !== 'no-speech') {
                    console.warn('Dictaphone:', e.error);
                }
            };

            recognition.start();
        });
    });
})();
</script>
