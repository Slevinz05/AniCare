{% extends 'base.html.twig' %}
{% block title %}Détail du partage - AniCare{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card anicare-card overflow-hidden">
                <div class="card-header medical-header p-4">
                    <p class="page-eyebrow mb-2">Collaboration</p>
                    <h1 class="page-title mb-0">Partage de {{ animal_share.animal.name }}</h1>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-medical align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th style="width: 40%;">Animal</th>
                                    <td><strong class="text-teal">{{ animal_share.animal.name }}</strong></td>
                                </tr>
                                <tr>
                                    <th>Partagé avec</th>
                                    <td>{{ animal_share.sharedWithEmail }}</td>
                                </tr>
                                <tr>
                                    <th>Niveau d'accès</th>
                                    <td>
                                        {% if animal_share.permissionLevel == 'WRITE' %}
                                            <span class="badge bg-success">Modification</span>
                                        {% else %}
                                            <span class="badge bg-info text-dark">Lecture seule</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Partagé le</th>
                                    <td>{{ animal_share.createdAt ? animal_share.createdAt|date('d/m/Y') : '-' }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-4 border-top border-anicare">
                        <a href="{{ path('app_animal_share_index') }}" class="btn btn-outline-primary">Retour aux partages</a>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_animal_share_edit', {'id': animal_share.id}) }}" class="btn btn-primary">Modifier</a>
                            <form method="post" action="{{ path('app_animal_share_delete', {'id': animal_share.id}) }}" onsubmit="return confirm('Supprimer ce partage ?');" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal_share.id) }}">
                                <button class="btn btn-outline-danger">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
