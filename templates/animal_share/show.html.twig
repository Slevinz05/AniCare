{% extends 'base.html.twig' %}

{% block title %}AnimalShare
{% endblock %}

{% block body %}
	<h1>AnimalShare</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ animal_share.id }}</td>
			</tr>
			<tr>
				<th>Animal concerné</th>
				<td>{{ animal_share.animal.name }}</td>
			</tr>
			<tr>
				<th>SharedWithEmail</th>
				<td>{{ animal_share.sharedWithEmail }}</td>
			</tr>
			<tr>
				<th>PermissionLevel</th>
				{{ include('animal_share/_permission_badge.html.twig', {'permission': animal_share.permissionLevel}) }}
			</tr>
			<tr>
				<th>CreatedAt</th>
				<td>{{ animal_share.createdAt ? animal_share.createdAt|date('Y-m-d') : '' }}</td>
			</tr>
		</tbody>
	</table>

	<a href="{{ path('app_animal_share_index') }}">back to list</a>

	<a href="{{ path('app_animal_share_edit', {'id': animal_share.id}) }}">edit</a>

	{{ include('animal_share/_delete_form.html.twig') }}
{% endblock %}
