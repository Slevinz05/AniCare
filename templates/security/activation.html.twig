{% extends 'base.html.twig' %}

{% block title %}Activer mon compte - AniCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="form-card shadow-anicare">
                <div class="text-center mb-4">
                    <span class="fs-1">🐾</span>
                    <h1 class="page-title mt-2 mb-1">Activer mon compte</h1>
                    <p class="page-subtitle small">Bienvenue {{ user.firstName }} ! Choisissez votre mot de passe pour accéder à AniCare.</p>
                </div>

                {% if error %}
                    <div class="alert alert-danger shadow-sm border-0 small">
                        {{ error }}
                    </div>
                {% endif %}

                <div class="alert alert-info small mb-3 border-0">
                    <strong>Votre email :</strong> {{ user.email }}<br>
                    <strong>Type de compte :</strong>
                    {% if user.accountType == 'PRO' %}
                        <span class="badge" style="background: var(--primary-color); color: #fff;">Professionnel</span>
                    {% elseif user.accountType == 'STRUCTURE' %}
                        <span class="badge" style="background: var(--accent-color); color: #fff;">Structure</span>
                    {% elseif user.accountType == 'Propriétaire' %}
                        <span class="badge bg-secondary">Propriétaire</span>
                    {% else %}
                        <span class="badge bg-secondary">{{ user.accountType }}</span>
                    {% endif %}
                </div>

                <form method="post">
                    <div class="mb-3">
                        <label for="inputPassword" class="form-label">Mot de passe</label>
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="new-password" placeholder="Minimum 8 caractères" required autofocus minlength="8">
                    </div>

                    <div class="mb-4">
                        <label for="inputPasswordConfirm" class="form-label">Confirmer le mot de passe</label>
                        <input type="password" name="password_confirm" id="inputPasswordConfirm" class="form-control" autocomplete="new-password" placeholder="Confirmez votre mot de passe" required minlength="8">
                    </div>

                    <button class="btn btn-primary w-100 py-2 shadow-sm fs-6" type="submit">
                        Activer mon compte
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3">
                    <p class="text-muted small mb-0">Vous avez déjà un mot de passe ?</p>
                    <a href="{{ path('app_login') }}" class="small fw-bold text-teal text-decoration-none">Se connecter</a>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
