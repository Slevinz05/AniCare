{# templates/security/login.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Connexion - AniCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            
            <div class="form-card shadow-anicare">
                <div class="text-center mb-4">
                    <span class="fs-1">🐾</span>
                    <h1 class="page-title mt-2 mb-1">Connexion</h1>
                    <p class="page-subtitle small">Accédez au suivi médical de vos chevaux</p>
                </div>

                <form method="post">
                    {% if error %}
                        <div class="alert alert-danger shadow-sm border-0 small">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-info small mb-3">
                            Vous êtes déjà connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>. 
                            <a href="{{ path('app_logout') }}" class="fw-bold text-decoration-none">Se déconnecter</a>
                        </div>
                    {% endif %}

                    <div class="mb-3">
                        <label for="inputEmail" class="form-label">Adresse e-mail</label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" placeholder="votre@email.fr" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label for="inputPassword" class="form-label">Mot de passe</label>
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" placeholder="Saisissez votre mot de passe" required>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <div class="form-check mb-4">
                        <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                        <label class="form-check-label text-secondary small fw-semibold" style="cursor: pointer;" for="_remember_me">
                            Se souvenir de moi
                        </label>
                    </div>

                    <button class="btn btn-primary w-100 py-2 shadow-sm fs-6" type="submit">
                        Se connecter
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3">
                    <p class="text-muted small mb-0">Vous n'avez pas encore de compte ?</p>
                    <a href="{{ path('app_register') }}" class="small fw-bold text-teal text-decoration-none">Créer un compte AniCare</a>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}