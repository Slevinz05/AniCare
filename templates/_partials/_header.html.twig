{# templates/_header.html.twig #}
{% set current_route = app.request.attributes.get('_route') %}

<nav class="navbar navbar-expand-xl navbar-light anicare-navbar sticky-top">
    <div class="container-fluid container-xxl px-3 px-lg-4 py-2">

        <a class="navbar-brand d-flex align-items-center gap-2 flex-shrink-0" href="{{ path('app_home') }}">
            <span class="navbar-brand-icon">🐾</span>
            <span class="navbar-brand-text">AniCare</span>
        </a>

        <button
            class="navbar-toggler ms-auto border-primary-subtle"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Ouvrir le menu"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse mt-3 mt-xl-0" id="navbarNav">

            {# Changement de mx-xl-auto à me-xl-auto pour aligner la navigation à gauche après le logo #}
            <ul class="navbar-nav me-xl-auto mb-3 mb-xl-0 gap-xl-1">
                <li class="nav-item">
                    <a
                        class="nav-link text-nowrap {{ current_route == 'app_home' ? 'active' : '' }}"
                        href="{{ path('app_home') }}">
                        Accueil
                    </a>
                </li>

                {# ==========================================================================
                   LIENS PUBLICS (Visibles connectés OU déconnectés)
                   ========================================================================== #}
                <li class="nav-item">
                    <a
                        class="nav-link text-nowrap {{ current_route == 'app_about' ? 'active' : '' }}"
                        href="{{ path('app_about'|default('#')) }}">
                        À propos
                    </a>
                </li>

                {# ==========================================================================
                   LIENS MÉTIER PRIVÉS (Visibles uniquement si connecté)
                   ========================================================================== #}
                {% if app.user %}
                    <li class="nav-item">
                        <a
                            class="nav-link text-nowrap {{ (current_route starts with 'app_animal_') and not (current_route starts with 'app_animal_share') ? 'active' : '' }}"
                            href="{{ path('app_animal_index') }}"
                        >
                            {# Libellé dynamique selon le rôle de l'utilisateur #}
                            {% if is_granted('ROLE_PRO') %}
                                🩺 Animaux suivis
                            {% else %}
                                Mes animaux
                            {% endif %}
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link text-nowrap {{ current_route starts with 'app_health_book_entry' ? 'active' : '' }}"
                            href="{{ path('app_health_book_entry_index') }}"
                        >
                            Activités médicales
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link text-nowrap {{ current_route starts with 'app_message' ? 'active' : '' }}"
                            href="{{ path('app_message_index') }}"
                        >
                            💬 Messagerie
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a
                            class="nav-link dropdown-toggle text-nowrap {{ current_route == 'app_calendar' or current_route starts with 'app_appointment' ? 'active' : '' }}"
                            href="#"
                            role="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            📅 Planning
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item {{ current_route == 'app_calendar' ? 'active' : '' }}" href="{{ path('app_calendar') }}">
                                    Calendrier
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item {{ current_route starts with 'app_appointment' ? 'active' : '' }}" href="{{ path('app_appointment_index') }}">
                                    Rendez-vous
                                </a>
                            </li>
                        </ul>
                    </li>
                {% endif %}
            </ul>

            <div class="navbar-actions d-flex flex-column flex-xl-row align-items-stretch align-items-xl-center gap-2 ms-xl-3">
                {% if app.user %}
                    <span class="navbar-user small d-none d-xxl-inline-flex text-nowrap align-items-center">
                        Bonjour, 
                        <strong class="ms-1">{{ app.user.userIdentifier }}</strong>
                        
                        {# Badge distinctif pour les professionnels #}
                        {% if is_granted('ROLE_PRO') %}
                            <span class="badge bg-anicare-soft text-teal border-anicare ms-2" style="font-size: 0.7rem; font-weight: 800;">PRO</span>
                        {% endif %}
                    </span>

                    <a class="btn btn-outline-danger btn-sm px-3 text-nowrap" href="{{ path('app_logout') }}">
                        Déconnexion
                    </a>
                {% else %}
                    <a class="btn btn-outline-primary btn-sm px-3 text-nowrap" href="{{ path('app_login') }}">
                        Connexion
                    </a>

                    <a class="btn btn-primary btn-sm px-3 shadow-sm text-nowrap" href="{{ path('app_register') }}">
                        Inscription
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
</nav>