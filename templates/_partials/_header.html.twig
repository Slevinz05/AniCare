{# templates/_header.html.twig #}
{% set current_route = app.request.attributes.get('_route') %}

<nav class="navbar navbar-dark anicare-navbar sticky-top">
    <div class="container-fluid container-xxl px-3 px-lg-4 py-2">

        <div class="d-flex align-items-center gap-3 flex-grow-1">
            <a class="navbar-brand d-flex align-items-center gap-2 flex-shrink-0 me-0" href="{{ path('app_home') }}">
                <span class="navbar-brand-text">AniCare</span>
            </a>

            {% if app.user %}
                {# ── Hamburger Menu ── #}
                <div class="dropdown">
                    <button
                        class="btn btn-navbar-menu d-flex align-items-center gap-2"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                        <span class="d-none d-md-inline" style="font-size: 0.85rem; font-weight: 700;">Menu</span>
                    </button>
                    <ul class="dropdown-menu nav-dropdown-menu">
                        {% if is_granted('ROLE_PRO') %}
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                    Mon espace
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route == 'app_calendar' or current_route starts with 'app_appointment' ? 'active' : '' }}" href="{{ path('app_calendar') }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    Agenda
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route starts with 'app_repertoire' ? 'active' : '' }}" href="{{ path('app_repertoire_reseau') }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    Répertoire
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route starts with 'app_factures' ? 'active' : '' }}" href="{{ path('app_factures') }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="18" rx="2"/><line x1="2" y1="7" x2="22" y2="7"/><line x1="2" y1="11" x2="22" y2="11"/></svg>
                                    Factures
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route starts with 'app_health_book_entry' ? 'active' : '' }}" href="{{ path('app_health_book_entry_index') }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    Historique
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route == 'app_contact' ? 'active' : '' }}" href="{{ path('app_contact') }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                    Centre d'Aide
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ (current_route starts with 'app_animal_') and not (current_route starts with 'app_animal_share') ? 'active' : '' }}" href="{{ path('app_animal_index') }}">
                                    {{ is_granted('ROLE_STRUCTURE') ? 'Chevaux de la structure' : 'Mes chevaux' }}
                                </a>
                            </li>
                            {% if not is_granted('ROLE_STRUCTURE') %}
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route starts with 'app_health_book_entry' ? 'active' : '' }}" href="{{ path('app_health_book_entry_index') }}">
                                    Consultations
                                </a>
                            </li>
                            {% endif %}
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route == 'app_calendar' or current_route starts with 'app_appointment' ? 'active' : '' }}" href="{{ path('app_calendar') }}">
                                    Agenda
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route == 'app_directory' ? 'active' : '' }}" href="{{ path('app_directory') }}">
                                    Annuaire
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route starts with 'app_animal_share' ? 'active' : '' }}" href="{{ path('app_animal_share_index') }}">
                                    Mes partages
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route starts with 'app_structure' ? 'active' : '' }}" href="{{ path('app_structure_index') }}">
                                    Structures
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route starts with 'app_message' ? 'active' : '' }}" href="{{ path('app_message_index') }}">
                                    Messagerie
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 {{ current_route == 'app_contact' ? 'active' : '' }}" href="{{ path('app_contact') }}">
                                    Centre d'aide
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>

                {# ── Search bar ── #}
                <div class="navbar-search-wrapper d-none d-md-flex flex-grow-1" style="max-width: 480px;">
                    <div class="position-relative w-100">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); pointer-events: none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" class="navbar-search-input" placeholder="Rechercher un cheval, un client, une structure..." autocomplete="off" id="globalSearchInput">
                        <div class="navbar-search-results" id="globalSearchResults" style="display: none;"></div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# ── Right actions ── #}
        <div class="d-flex align-items-center gap-2 ms-2">
            {% if app.user %}
                {% if is_granted('ROLE_PRO') %}
                    {# ── Quick Add + ── #}
                    <div class="dropdown">
                        <button class="btn btn-navbar-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Création rapide">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end quick-add-menu">
                            <li class="dropdown-header" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); padding: 0.4rem 0.85rem 0.3rem;">Création rapide</li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_health_book_entry_new') }}">
                                    <span class="quick-add-icon" style="background: var(--soft-teal); color: var(--primary-color);">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                    </span>
                                    <span style="color: var(--primary-color); font-weight: 800;">+</span> consultation
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_animal_new') }}">
                                    <span class="quick-add-icon" style="background: var(--soft-teal); color: var(--primary-color);">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 512 512" fill="currentColor"><path d="M0 464V316.9C0 208.5 68.3 111.8 170.5 75.6L340.2 15.5C361.6 7.9 384 23.8 384 46.4c0 11-5.5 21.2-14.6 27.3L336 96c48.1 0 91.2 29.8 108.1 74.9l48.6 129.5c11.8 31.4 4.1 66.8-19.6 90.5c-16 16-37.8 25.1-60.5 25.1h-3.4c-26.1 0-50.9-11.6-67.6-31.7l-32.3-38.7c-11.7 4.1-24.2 6.4-37.3 6.4c-6.3 0-12.5-.5-18.6-1.5c-3.6-.6-7.2-1.4-10.7-2.3c-28.9-7.8-53.1-26.8-67.8-52.2c-4.4-7.6-14.2-10.3-21.9-5.8s-10.3 14.2-5.8 21.9c24 41.5 68.3 70 119.3 71.9l47.2 70.8c4 6.1 6.2 13.2 6.2 20.4c0 20.3-16.5 36.8-36.8 36.8H48c-26.5 0-48-21.5-48-48zm328-240a24 24 0 1 0 0-48 24 24 0 1 0 0 48z"/></svg>
                                    </span>
                                    <span style="color: var(--primary-color); font-weight: 800;">+</span> fiche animal
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_repertoire_reseau') }}">
                                    <span class="quick-add-icon" style="background: #dbeafe; color: #2563eb;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    </span>
                                    <span style="color: #2563eb; font-weight: 800;">+</span> fiche utilisateur
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_structure_new') }}">
                                    <span class="quick-add-icon" style="background: #fef3c7; color: #d97706;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                    </span>
                                    <span style="color: #d97706; font-weight: 800;">+</span> structure
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_appointment_new') }}">
                                    <span class="quick-add-icon" style="background: #dcfce7; color: #16a34a;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    </span>
                                    <span style="color: #16a34a; font-weight: 800;">+</span> rendez-vous
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_factures') }}">
                                    <span class="quick-add-icon" style="background: #ede9fe; color: #7c3aed; font-size: 0.85rem; font-weight: 800;">€</span>
                                    <span style="color: #7c3aed; font-weight: 800;">+</span> facture
                                </a>
                            </li>
                        </ul>
                    </div>
                {% endif %}

                {# ── Notifications bell ── #}
                <a href="{{ is_granted('ROLE_PRO') ? path('app_referent_invitations') : '#' }}" class="btn btn-navbar-circle position-relative" title="Notifications">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    {% set inv_count = pending_invitations_count() %}
                    {% if inv_count > 0 %}
                        <span class="navbar-notif-badge">{{ inv_count }}</span>
                    {% endif %}
                </a>

                {# ── User dropdown ── #}
                <div class="dropdown">
                    <button
                        class="btn btn-navbar-avatar d-flex align-items-center gap-2"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <span class="navbar-avatar-circle">{{ app.user.firstName|default('?')|first|upper }}</span>
                        {% if is_granted('ROLE_PRO') %}
                            <span class="badge bg-white bg-opacity-25" style="font-size: 0.6rem; font-weight: 800;">PRO</span>
                        {% elseif is_granted('ROLE_STRUCTURE') %}
                            <span class="badge bg-white bg-opacity-25" style="font-size: 0.6rem; font-weight: 800;">Structure</span>
                        {% endif %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end profile-dropdown-menu">
                        <li class="dropdown-header profile-dropdown-header">
                            <div class="d-flex align-items-center gap-2">
                                <span class="profile-dropdown-avatar">{{ app.user.firstName|default('?')|first|upper }}</span>
                                <div>
                                    <div class="fw-bold" style="font-size: 0.85rem;">{{ app.user.fullName }}</div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">{{ app.user.email }}</div>
                                </div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_profile') }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Mon profil
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_profile_edit') }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Modifier le profil
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_profile_password') }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                Mot de passe
                            </a>
                        </li>
                        {% if stripe_enabled %}
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_subscription') }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                                {{ app.user.hasActiveSubscription() ? 'Mon abonnement' : 'Passer PRO' }}
                            </a>
                        </li>
                        {% endif %}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="{{ path('app_logout') }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                Se déconnecter
                            </a>
                        </li>
                    </ul>
                </div>
            {% else %}
                <a class="btn btn-navbar-outline btn-sm px-3 text-nowrap" href="{{ path('app_login') }}">
                    Connexion
                </a>
                <a class="btn btn-navbar-accent btn-sm px-3 text-nowrap" href="{{ path('app_register') }}">
                    Inscription
                </a>
            {% endif %}
        </div>

    </div>
</nav>
