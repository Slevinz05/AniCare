{# templates/_partials/_animal_card.html.twig #}

<div class="card animal-card h-100 border-0 overflow-hidden">
    <div class="animal-card-photo-wrapper">
        {% if animal.photo %}
            <a href="{{ path('app_animal_show', {'id': animal.id}) }}">
                <img src="{{ asset('uploads/photos/' ~ animal.photo) }}"
                     alt="Photo de {{ animal.name }}"
                     class="card-img-top"
                     style="height: 180px; object-fit: cover;">
            </a>
        {% else %}
            <a href="{{ path('app_animal_edit', {'id': animal.id}) }}" class="text-decoration-none">
                <div class="animal-card-default-photo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="animal-card-placeholder-icon">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                    </svg>
                    <span class="animal-card-placeholder-text">Ajouter une photo</span>
                </div>
            </a>
        {% endif %}
        <a href="{{ path('app_animal_edit', {'id': animal.id}) }}" class="animal-card-camera-btn" title="Ajouter / modifier la photo">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
            </svg>
        </a>
    </div>

    <div class="card-body p-4 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <p class="animal-card-kicker mb-0">Fiche du cheval</p>
                <h3 class="animal-card-title mb-0">{{ animal.name }}</h3>
            </div>
            {{ include('_partials/_gender_badge.html.twig', {'gender': animal.gender}) }}
        </div>

        <div class="animal-info-list mb-3">
            <div class="animal-info-row">
                <span class="animal-info-label">Race</span>
                <span class="animal-info-value">{{ animal.breed ?: 'Non renseignée' }}</span>
            </div>

            {% if animal.coat %}
                <div class="animal-info-row">
                    <span class="animal-info-label">Robe</span>
                    <span class="animal-info-value">{{ animal.coat }}</span>
                </div>
            {% endif %}

            {% if animal.age is not null %}
                <div class="animal-info-row">
                    <span class="animal-info-label">Âge</span>
                    <span class="animal-info-value">{{ animal.age }} an{{ animal.age > 1 ? 's' : '' }}</span>
                </div>
            {% endif %}

            <div class="animal-info-row">
                <span class="animal-info-label">Poids</span>
                <span class="animal-info-value">
                    {% if animal.weight %}
                        <span class="badge-medical badge-weight">{{ animal.weight }} kg</span>
                    {% else %}
                        Non renseigné
                    {% endif %}
                </span>
            </div>

            {% if animal.identificationNumber %}
                <div class="animal-info-row">
                    <span class="animal-info-label">SIRE</span>
                    <span class="animal-info-value animal-id">{{ animal.identificationNumber }}</span>
                </div>
            {% endif %}
        </div>

        <div class="d-flex gap-2 mt-auto">
            <a href="{{ path('app_animal_show', {'id': animal.id}) }}" class="btn btn-primary btn-sm flex-fill">
                Consulter
            </a>

            <a href="{{ path('app_animal_edit', {'id': animal.id}) }}" class="btn btn-outline-info btn-sm flex-fill">
                Modifier
            </a>
        </div>
    </div>
</div>
