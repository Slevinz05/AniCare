{# templates/_partials/_animal_card.html.twig #}

<div class="card animal-card h-100 border-0 overflow-hidden" style="cursor: pointer; transition: transform 0.15s, box-shadow 0.15s;" onmouseenter="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 32px rgba(74,63,51,0.15)'" onmouseleave="this.style.transform='';this.style.boxShadow=''" onclick="if(!event.target.closest('.animal-card-edit-btn'))window.location='{{ path('app_animal_show', {'slug': animal.slug}) }}'">
    <div class="animal-card-photo-wrapper position-relative">
        {% if animal.photo %}
            <img src="{{ asset('uploads/photos/' ~ animal.photo) }}"
                 alt="Photo de {{ animal.name }}"
                 class="card-img-top"
                 style="height: 180px; object-fit: cover;">
        {% else %}
            <form method="post" action="{{ path('app_animal_quick_photo', {'slug': animal.slug}) }}" enctype="multipart/form-data" class="animal-card-photo-form" onclick="event.stopPropagation();">
                <input type="hidden" name="_token" value="{{ csrf_token('quick_photo' ~ animal.id) }}">
                <input type="file" name="photo" accept="image/*" class="d-none" id="quick-photo-{{ animal.id }}" onchange="this.closest('form').submit();">
                <label for="quick-photo-{{ animal.id }}" class="animal-card-default-photo" style="cursor: pointer; margin: 0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="animal-card-placeholder-icon">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                    </svg>
                    <span class="animal-card-placeholder-text">Ajouter une photo</span>
                </label>
            </form>
        {% endif %}
        <a href="{{ path('app_animal_edit', {'slug': animal.slug}) }}" class="animal-card-edit-btn" title="Modifier la fiche" style="position: absolute; bottom: -16px; right: 16px; width: 36px; height: 36px; border-radius: 50%; background-color: var(--primary-color); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.15); z-index: 2; transition: background-color 0.15s;" onmouseenter="this.style.backgroundColor='var(--secondary-color)'" onmouseleave="this.style.backgroundColor='var(--primary-color)'">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
        </a>
    </div>

    <div class="card-body p-4 d-flex flex-column" style="padding-top: 1.5rem !important;">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <p class="animal-card-kicker mb-0">Fiche du cheval</p>
                <h3 class="animal-card-title mb-0">{{ animal.name }}</h3>
            </div>
            {{ include('_partials/_gender_badge.html.twig', {'gender': animal.gender}) }}
        </div>

        <div class="animal-info-list mb-3">
            <div class="animal-info-row">
                <span class="animal-info-label">Race</span>
                <span class="animal-info-value">{{ animal.breed ?: 'Non renseignée' }}</span>
            </div>

            {% if animal.coat %}
                <div class="animal-info-row">
                    <span class="animal-info-label">Robe</span>
                    <span class="animal-info-value">{{ animal.coat }}</span>
                </div>
            {% endif %}

            {% if animal.age is not null %}
                <div class="animal-info-row">
                    <span class="animal-info-label">Age</span>
                    <span class="animal-info-value">{{ animal.age }} an{{ animal.age > 1 ? 's' : '' }}</span>
                </div>
            {% endif %}

            <div class="animal-info-row">
                <span class="animal-info-label">Poids</span>
                <span class="animal-info-value">
                    {% if animal.weight %}
                        <span class="badge-medical badge-weight">{{ animal.weight }} kg</span>
                    {% else %}
                        Non renseigné
                    {% endif %}
                </span>
            </div>

            {% if animal.identificationNumber %}
                <div class="animal-info-row">
                    <span class="animal-info-label">SIRE</span>
                    <span class="animal-info-value animal-id">{{ animal.identificationNumber }}</span>
                </div>
            {% endif %}
        </div>

        <div class="mt-auto">
            <a href="{{ path('app_animal_show', {'slug': animal.slug}) }}" class="btn btn-primary btn-sm w-100">
                Consulter
            </a>
        </div>
    </div>
</div>
