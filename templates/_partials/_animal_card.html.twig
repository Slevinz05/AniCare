{# templates/_partials/_animal_card.html.twig #}

<div class="card animal-card h-100 border-0 overflow-hidden">
    {% if animal.photo %}
        <a href="{{ path('app_animal_show', {'id': animal.id}) }}">
            <img src="{{ asset('uploads/photos/' ~ animal.photo) }}"
                 alt="Photo de {{ animal.name }}"
                 class="card-img-top"
                 style="height: 180px; object-fit: cover;">
        </a>
    {% else %}
        <a href="{{ path('app_animal_show', {'id': animal.id}) }}" class="text-decoration-none">
            <div class="d-flex align-items-center justify-content-center bg-light" style="height: 180px;">
                <span style="font-size: 3.5rem; opacity: 0.4;">
                    {% if animal.species|lower == 'chien' %}🐕
                    {% elseif animal.species|lower == 'chat' %}🐈
                    {% elseif animal.species|lower == 'cheval' %}🐴
                    {% elseif animal.species|lower == 'lapin' %}🐇
                    {% elseif animal.species|lower == 'oiseau' %}🐦
                    {% else %}🐾
                    {% endif %}
                </span>
            </div>
        </a>
    {% endif %}

    <div class="card-body p-4 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h3 class="animal-card-title mb-0">{{ animal.name }}</h3>
                <span class="text-secondary small">{{ animal.species }}{% if animal.breed %} — {{ animal.breed }}{% endif %}</span>
            </div>
            {{ include('_partials/_gender_badge.html.twig', {'gender': animal.gender}) }}
        </div>

        <div class="animal-info-list mb-3">
            <div class="animal-info-row">
                <span class="animal-info-label">Poids</span>
                <span class="animal-info-value">
                    {{ animal.weight ? animal.weight ~ ' kg' : 'Non renseigné' }}
                </span>
            </div>

            {% if animal.identificationNumber %}
                <div class="animal-info-row">
                    <span class="animal-info-label">Identification</span>
                    <span class="animal-info-value animal-id">
                        {{ animal.identificationNumber }}
                    </span>
                </div>
            {% endif %}
        </div>

        <div class="d-flex gap-2 mt-auto">
            <a href="{{ path('app_animal_show', {'id': animal.id}) }}" class="btn btn-outline-primary btn-sm flex-fill">
                Consulter
            </a>

            <a href="{{ path('app_animal_edit', {'id': animal.id}) }}" class="btn btn-primary btn-sm flex-fill">
                Modifier
            </a>
        </div>
    </div>
</div>
