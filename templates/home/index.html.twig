{% extends 'base.html.twig' %}

{% block title %}{% if app.user %}Tableau de bord{% else %}Bienvenue{% endif %} - AniCare{% endblock %}

{% block body %}
<div class="container py-4">

    {% if app.user %}
        {# ======================================================================
           TABLEAU DE BORD CONNECTÉ
           ====================================================================== #}
        <div class="page-hero p-4 p-lg-5 mb-5">
            <div class="row align-items-center gy-3">
                <div class="col-12 col-lg">
                    <p class="page-eyebrow mb-2">Tableau de bord</p>
                    <h1 class="page-title mb-1">
                        {% if is_granted('ROLE_PRO') %}
                            Bonjour, Docteur
                        {% else %}
                            Ravi de vous revoir !
                        {% endif %}
                    </h1>
                    <p class="page-subtitle mb-0">{{ app.user.userIdentifier }}
                        {% if is_granted('ROLE_PRO') %}
                            <span class="badge bg-anicare-soft text-teal border-anicare ms-2" style="font-size: 0.7rem; font-weight: 800;">PRO</span>
                        {% endif %}
                    </p>
                </div>
                <div class="col-12 col-lg-auto d-flex gap-2 flex-wrap">
                    {% if is_granted('ROLE_PRO') %}
                        <a href="{{ path('app_animal_index') }}" class="btn btn-primary shadow-sm">Animaux suivis</a>
                    {% else %}
                        <a href="{{ path('app_animal_new') }}" class="btn btn-primary shadow-sm">Enregistrer un animal</a>
                    {% endif %}
                </div>
            </div>
        </div>

        {# --- Accès rapide --- #}
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <a href="{{ path('app_health_book_entry_new') }}" class="btn btn-primary w-100 py-3 shadow-sm">
                    <span style="font-size: 1.3rem; display: block;">📋</span>
                    Nouvel acte
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_appointment_index') }}" class="btn btn-primary w-100 py-3 shadow-sm">
                    <span style="font-size: 1.3rem; display: block;">📅</span>
                    Rendez-vous
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_calendar') }}" class="btn btn-primary w-100 py-3 shadow-sm">
                    <span style="font-size: 1.3rem; display: block;">🗓️</span>
                    Planning
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_animal_share_new') }}" class="btn btn-primary w-100 py-3 shadow-sm">
                    <span style="font-size: 1.3rem; display: block;">🤝</span>
                    Partager
                </a>
            </div>
        </div>

        <div class="row g-4">
            {# --- Mes compagnons --- #}
            <div class="col-12 col-lg-7">
                <div class="card anicare-card h-100">
                    <div class="card-body p-4">
                        <p class="page-eyebrow mb-2">Mes animaux</p>
                        <h2 class="h5 page-title mb-3">
                            {% if is_granted('ROLE_PRO') %}
                                Animaux suivis
                            {% else %}
                                Mes compagnons
                            {% endif %}
                        </h2>

                        {% if animals is empty %}
                            <p class="text-secondary">Aucun animal enregistré pour le moment.</p>
                        {% else %}
                            <div class="row row-cols-1 row-cols-sm-2 g-3 mb-3">
                                {% for animal in animals %}
                                    <div class="col">
                                        <a href="{{ path('app_animal_show', {'id': animal.id}) }}" class="text-decoration-none">
                                            <div class="p-3 rounded-3 bg-light border d-flex align-items-center gap-3 h-100" style="transition: all 0.15s ease;">
                                                {% if animal.photo %}
                                                    <img src="{{ asset('uploads/photos/' ~ animal.photo) }}"
                                                         alt="{{ animal.name }}"
                                                         class="rounded-circle"
                                                         style="width: 50px; height: 50px; object-fit: cover; flex-shrink: 0;">
                                                {% else %}
                                                    <div class="rounded-circle bg-white border d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; flex-shrink: 0;">
                                                        <span style="font-size: 1.3rem;">
                                                            {% if animal.species|lower == 'chien' %}🐕{% elseif animal.species|lower == 'chat' %}🐈{% elseif animal.species|lower == 'cheval' %}🐴{% else %}🐾{% endif %}
                                                        </span>
                                                    </div>
                                                {% endif %}
                                                <div>
                                                    <h4 class="h6 fw-bold text-dark mb-0">{{ animal.name }}</h4>
                                                    <span class="text-secondary small">{{ animal.species }}{% if animal.breed %} — {{ animal.breed }}{% endif %}</span>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="d-flex gap-2 mt-auto">
                            <a href="{{ path('app_animal_index') }}" class="btn btn-outline-primary btn-sm">Tous les animaux</a>
                            <a href="{{ path('app_animal_share_index') }}" class="btn btn-outline-primary btn-sm">Mes partages</a>
                        </div>
                    </div>
                </div>
            </div>

            {# --- Rappels médicaux --- #}
            <div class="col-12 col-lg-5">
                <div class="card anicare-card h-100">
                    <div class="card-body p-4">
                        <p class="page-eyebrow mb-2">Alertes</p>
                        <h2 class="h5 page-title mb-3">Prochains rappels</h2>

                        {% if upcoming_reminders is empty %}
                            <div class="text-center py-4">
                                <p class="text-secondary mb-0">Tout est à jour ! Aucun rappel ou soin de prévu.</p>
                            </div>
                        {% else %}
                            {% for reminder in upcoming_reminders %}
                                <div class="d-flex justify-content-between align-items-start py-2 {{ not loop.last ? 'border-bottom border-anicare' : '' }}">
                                    <div>
                                        <strong class="d-block text-dark">{{ reminder.title }}</strong>
                                        <span class="text-secondary small">{{ reminder.animal.name }}</span>
                                    </div>
                                    <span class="badge {{ reminder.date < date() ? 'bg-danger' : 'bg-warning text-dark' }} ms-2">
                                        {{ reminder.date|date('d/m/Y') }}
                                    </span>
                                </div>
                            {% endfor %}
                        {% endif %}

                        <a href="{{ path('app_health_book_entry_index') }}" class="btn btn-outline-primary btn-sm w-100 mt-3">Carnet de santé</a>
                    </div>
                </div>
            </div>
        </div>

    {% else %}
        {# ======================================================================
           PAGE VITRINE VISITEUR DÉCONNECTÉ
           ====================================================================== #}

        {# Hero #}
        <section class="py-5">
            <div class="row align-items-center gy-5">
                <div class="col-12 col-lg-6">
                    <h1 class="fw-bold mb-3" style="font-size: 2.8rem; line-height: 1.15;">
                        Le carnet de santé <span class="text-teal">de vos animaux</span>, toujours avec vous
                    </h1>
                    <p class="lead text-secondary mb-4">
                        AniCare centralise le suivi médical, les vaccins, les traitements et les rendez-vous
                        de vos compagnons. Partagez leur dossier avec votre vétérinaire en un clic.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-4 shadow-sm">Créer mon compte</a>
                        <a href="{{ path('app_about') }}" class="btn btn-outline-primary btn-lg px-4">En savoir plus</a>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <img src="{{ asset('images/hero-owner.jpg') }}"
                         alt="Propriétaire avec son chien dans un parc"
                         class="img-fluid rounded-3 shadow" loading="lazy">
                </div>
            </div>
        </section>

        {# Fonctionnalités #}
        <section class="py-5">
            <div class="text-center mb-5">
                <p class="page-eyebrow mb-2">Fonctionnalités</p>
                <h2 class="h3 page-title">Tout ce dont vos animaux ont besoin</h2>
            </div>

            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">📋</div>
                            <h3 class="h6 fw-bold mb-2">Carnet de santé</h3>
                            <p class="text-secondary small mb-0">Historique complet des consultations, vaccins, chirurgies et traitements.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">📊</div>
                            <h3 class="h6 fw-bold mb-2">Courbe de poids</h3>
                            <p class="text-secondary small mb-0">Suivez l'évolution du poids de votre animal avec un graphique interactif.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">🚨</div>
                            <h3 class="h6 fw-bold mb-2">Fiche d'urgence</h3>
                            <p class="text-secondary small mb-0">Allergies, traitements actifs et informations vitales en un coup d'oeil.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">🤝</div>
                            <h3 class="h6 fw-bold mb-2">Partage sécurisé</h3>
                            <p class="text-secondary small mb-0">Donnez accès au dossier à votre véto, un pet-sitter ou un proche.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# Section image + texte #}
        <section class="py-5">
            <div class="row align-items-center gy-4">
                <div class="col-12 col-lg-5">
                    <img src="{{ asset('images/cat-orange.jpg') }}"
                         alt="Chat roux regardant la caméra"
                         class="img-fluid rounded-3 shadow" loading="lazy">
                </div>
                <div class="col-12 col-lg-7">
                    <article>
                        <p class="page-eyebrow mb-2">Pour les propriétaires</p>
                        <h2 class="h3 page-title mb-3">Ne perdez plus jamais un rendez-vous</h2>
                        <p class="text-secondary">
                            Combien de fois avez-vous oublié la date du prochain rappel de vaccin ?
                            Perdu l'ordonnance du vétérinaire ? Hésité sur la posologie d'un traitement ?
                        </p>
                        <p class="text-secondary">
                            AniCare résout ces problèmes en centralisant tout au même endroit.
                            Enregistrez un acte médical, définissez un rappel, et retrouvez
                            l'information instantanément quand vous en avez besoin.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="py-5">
            <div class="row align-items-center gy-4">
                <div class="col-12 col-lg-7">
                    <aside>
                        <p class="page-eyebrow mb-2">Pour les professionnels</p>
                        <h2 class="h3 page-title mb-3">Un outil adapté à votre pratique</h2>
                        <p class="text-secondary">
                            Les vétérinaires, cliniques et refuges bénéficient d'un espace dédié.
                            Consultez les dossiers partagés par vos clients, ajoutez des actes médicaux,
                            et suivez les traitements en cours depuis une interface pensée pour le terrain.
                        </p>
                        <p class="text-secondary">
                            Le mode professionnel affiche une vue consolidée de tous les animaux
                            que vous suivez, avec un accès direct au planning et aux rappels.
                        </p>
                    </aside>
                </div>
                <div class="col-12 col-lg-5">
                    <img src="{{ asset('images/vet-dog.jpg') }}"
                         alt="Vétérinaire avec un chien"
                         class="img-fluid rounded-3 shadow" loading="lazy">
                </div>
            </div>
        </section>

        {# CTA final #}
        <section class="py-5">
            <div class="card anicare-card text-center">
                <div class="card-body p-5">
                    <h2 class="h3 page-title mb-3">Prêt à commencer ?</h2>
                    <p class="text-secondary mb-4">Inscription gratuite, aucune carte bancaire requise.</p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-5 shadow-sm">Créer mon compte</a>
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-lg px-5">Se connecter</a>
                    </div>
                </div>
            </div>
        </section>

    {% endif %}

</div>
{% endblock %}
