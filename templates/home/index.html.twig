{% extends 'base.html.twig' %}

{% block title %}{% if app.user %}Tableau de bord{% else %}Bienvenue{% endif %} - AniCare{% endblock %}

{% block body %}
<div class="container py-4">

    {% if app.user %}
        {# ======================================================================
           TABLEAU DE BORD CONNECTÉ
           ====================================================================== #}
        <style>
            .dashboard-hero {
                background: linear-gradient(135deg, #0d9488 0%, #0f766e 60%, #115e59 100%);
                border-radius: var(--radius-lg);
                padding: 2.5rem 2rem;
                color: #fff;
                position: relative;
                overflow: hidden;
                box-shadow: 0 8px 32px rgba(13, 148, 136, 0.3);
            }
            .dashboard-hero::before {
                content: '';
                position: absolute;
                top: -40px; right: -40px;
                width: 200px; height: 200px;
                border-radius: 50%;
                background: rgba(255,255,255,0.06);
            }
            .dashboard-hero::after {
                content: '';
                position: absolute;
                bottom: -60px; left: 30%;
                width: 300px; height: 300px;
                border-radius: 50%;
                background: rgba(255,255,255,0.04);
            }
            .dashboard-hero .hero-content { position: relative; z-index: 1; }
            .dashboard-hero .hero-greeting { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.03em; }
            .dashboard-hero .hero-email { opacity: 0.75; font-size: 0.9rem; }
            .dashboard-hero .btn-hero {
                background: rgba(255,255,255,0.15);
                border: 2px solid rgba(255,255,255,0.3);
                color: #fff; font-weight: 700;
                border-radius: var(--radius-sm);
                padding: 0.6rem 1.4rem;
                transition: all 0.2s;
                backdrop-filter: blur(4px);
            }
            .dashboard-hero .btn-hero:hover {
                background: rgba(255,255,255,0.25);
                border-color: rgba(255,255,255,0.5);
                transform: translateY(-1px);
            }

            .quick-action {
                display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
                padding: 1.4rem 1rem;
                border-radius: var(--radius-md);
                text-decoration: none;
                font-weight: 700; font-size: 0.85rem;
                transition: all 0.2s ease;
                border: 1px solid var(--border-color);
                position: relative;
                overflow: hidden;
            }
            .quick-action::before {
                content: '';
                position: absolute; inset: 0;
                opacity: 0;
                transition: opacity 0.2s;
                border-radius: inherit;
            }
            .quick-action:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            }
            .quick-action .qa-icon {
                width: 44px; height: 44px;
                border-radius: 12px;
                display: flex; align-items: center; justify-content: center;
                font-size: 1.2rem;
                transition: transform 0.2s;
            }
            .quick-action:hover .qa-icon { transform: scale(1.1); }

            .qa-consultation { background: var(--soft-teal); color: var(--primary-color); }
            .qa-consultation .qa-icon { background: var(--primary-color); color: #fff; }
            .qa-consultation:hover { border-color: var(--primary-color); }

            .qa-rdv { background: #fff; color: var(--secondary-color); }
            .qa-rdv .qa-icon { background: var(--accent-color); color: #fff; }
            .qa-rdv:hover { border-color: var(--accent-color); }

            .qa-planning { background: #fff; color: var(--secondary-color); }
            .qa-planning .qa-icon { background: var(--secondary-color); color: #fff; }
            .qa-planning:hover { border-color: var(--secondary-color); }

            .qa-partager { background: #fff; color: var(--secondary-color); }
            .qa-partager .qa-icon { background: #e0796b; color: #fff; }
            .qa-partager:hover { border-color: #e0796b; }

            .horse-mini-card {
                display: flex; align-items: center; gap: 1rem;
                padding: 0.85rem 1rem;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border-color);
                background: #fff;
                text-decoration: none;
                transition: all 0.2s ease;
            }
            .horse-mini-card:hover {
                border-color: var(--primary-color);
                background: var(--soft-teal);
                transform: translateX(4px);
                box-shadow: 0 4px 12px rgba(13, 148, 136, 0.1);
            }
            .horse-mini-card .horse-avatar {
                width: 48px; height: 48px;
                border-radius: 14px;
                object-fit: cover;
                flex-shrink: 0;
                border: 2px solid var(--border-color);
            }
            .horse-mini-card:hover .horse-avatar {
                border-color: var(--primary-color);
            }
            .horse-mini-card .horse-placeholder {
                width: 48px; height: 48px;
                border-radius: 14px;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--soft-teal) 0%, #e0f2f1 100%);
                display: flex; align-items: center; justify-content: center;
                font-size: 1.3rem;
                border: 2px solid var(--border-color);
            }

            .reminder-item {
                display: flex; justify-content: space-between; align-items: center;
                padding: 0.9rem 1rem;
                border-radius: var(--radius-sm);
                transition: background 0.15s;
                gap: 0.75rem;
            }
            .reminder-item:hover { background: var(--soft-teal); }
            .reminder-item + .reminder-item { border-top: 1px solid var(--border-color); }
            .reminder-icon {
                width: 36px; height: 36px;
                border-radius: 10px;
                display: flex; align-items: center; justify-content: center;
                flex-shrink: 0;
                font-size: 0.95rem;
            }
            .reminder-overdue .reminder-icon { background: #fef2f2; color: var(--danger-color); }
            .reminder-upcoming .reminder-icon { background: var(--soft-warm); color: var(--accent-color); }

            .section-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                box-shadow: var(--shadow-subtle);
                overflow: hidden;
            }
            .section-card-header {
                padding: 1.25rem 1.5rem;
                border-bottom: 1px solid var(--border-color);
                display: flex; justify-content: space-between; align-items: center;
                background: linear-gradient(180deg, #fff 0%, #fafaf8 100%);
            }
            .section-card-body { padding: 1rem 1.5rem 1.5rem; }

            .stat-pill {
                display: inline-flex; align-items: center; gap: 0.35rem;
                padding: 0.3rem 0.75rem;
                border-radius: 2rem;
                font-size: 0.75rem; font-weight: 700;
            }
        </style>

        {# --- Hero --- #}
        <div class="dashboard-hero mb-4">
            <div class="hero-content">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <p class="hero-greeting mb-1">
                            {% set hour = "now"|date("H") %}
                            {% if hour < 12 %}
                                Bonjour{% if is_granted('ROLE_PRO') %}, Docteur{% endif %} !
                            {% elseif hour < 18 %}
                                Bon après-midi{% if is_granted('ROLE_PRO') %}, Docteur{% endif %} !
                            {% else %}
                                Bonsoir{% if is_granted('ROLE_PRO') %}, Docteur{% endif %} !
                            {% endif %}
                        </p>
                        <p class="hero-email mb-0">
                            {{ app.user.userIdentifier }}
                            {% if is_granted('ROLE_PRO') %}
                                <span style="background: rgba(200,151,62,0.3); border: 1px solid rgba(200,151,62,0.5); padding: 0.15rem 0.5rem; border-radius: 2rem; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.05em; margin-left: 0.5rem;">PRO</span>
                            {% endif %}
                        </p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        {% if is_granted('ROLE_PRO') %}
                            <a href="{{ path('app_animal_index') }}" class="btn-hero text-decoration-none d-inline-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                                Chevaux suivis
                            </a>
                        {% else %}
                            <a href="{{ path('app_animal_new') }}" class="btn-hero text-decoration-none d-inline-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Enregistrer un cheval
                            </a>
                        {% endif %}
                    </div>
                </div>

                {% if animals is not empty %}
                    <div class="d-flex gap-2 mt-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.15); flex-wrap: wrap;">
                        <span style="font-size: 0.75rem; opacity: 0.6; align-self: center;">{{ animals|length }} {{ animals|length > 1 ? 'chevaux' : 'cheval' }}</span>
                        {% for animal in animals|slice(0, 4) %}
                            <a href="{{ path('app_animal_show', {'slug': animal.slug}) }}" title="{{ animal.name }}" style="text-decoration: none;">
                                {% if animal.photo %}
                                    <img src="{{ asset('uploads/photos/' ~ animal.photo) }}" alt="{{ animal.name }}" style="width: 32px; height: 32px; border-radius: 10px; object-fit: cover; border: 2px solid rgba(255,255,255,0.4);">
                                {% else %}
                                    <span style="width: 32px; height: 32px; border-radius: 10px; background: rgba(255,255,255,0.15); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; border: 2px solid rgba(255,255,255,0.3);">🐴</span>
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        {# --- Accès rapide --- #}
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <a href="{{ path('app_health_book_entry_new') }}" class="quick-action qa-consultation">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                    </span>
                    Nouvelle consultation
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_appointment_index') }}" class="quick-action qa-rdv">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </span>
                    Rendez-vous
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_calendar') }}" class="quick-action qa-planning">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    </span>
                    Planning
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_animal_share_new') }}" class="quick-action qa-partager">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    </span>
                    Partager
                </a>
            </div>
        </div>

        <div class="row g-4">
            {# --- Mes chevaux --- #}
            <div class="col-12 col-lg-7">
                <div class="section-card h-100 d-flex flex-column">
                    <div class="section-card-header">
                        <div>
                            <p class="page-eyebrow mb-0">
                                {% if is_granted('ROLE_PRO') %}Chevaux suivis{% else %}Mes chevaux{% endif %}
                            </p>
                        </div>
                        {% if animals is not empty %}
                            <span class="stat-pill" style="background: var(--soft-teal); color: var(--primary-color);">
                                {{ animals|length }} {{ animals|length > 1 ? 'chevaux' : 'cheval' }}
                            </span>
                        {% endif %}
                    </div>
                    <div class="section-card-body flex-grow-1 d-flex flex-column">
                        {% if animals is empty %}
                            <div class="text-center py-5 flex-grow-1 d-flex flex-column justify-content-center">
                                <div style="font-size: 2.5rem; margin-bottom: 0.75rem; opacity: 0.4;">🐴</div>
                                <p class="text-secondary mb-3">Aucun cheval enregistré pour le moment.</p>
                                <a href="{{ path('app_animal_new') }}" class="btn btn-primary btn-sm mx-auto px-4">Ajouter mon premier cheval</a>
                            </div>
                        {% else %}
                            <div class="d-flex flex-column gap-2 mb-3">
                                {% for animal in animals %}
                                    <a href="{{ path('app_animal_show', {'slug': animal.slug}) }}" class="horse-mini-card">
                                        {% if animal.photo %}
                                            <img src="{{ asset('uploads/photos/' ~ animal.photo) }}"
                                                 alt="{{ animal.name }}"
                                                 class="horse-avatar">
                                        {% else %}
                                            <div class="horse-placeholder">🐴</div>
                                        {% endif %}
                                        <div class="flex-grow-1">
                                            <h4 class="fw-bold mb-0" style="font-size: 0.95rem; color: var(--secondary-color);">{{ animal.name }}</h4>
                                            <span class="text-secondary" style="font-size: 0.8rem;">
                                                {{ animal.breed ?: 'Race non renseignée' }}
                                                {% if animal.age is not null %} · {{ animal.age }} an{{ animal.age > 1 ? 's' : '' }}{% endif %}
                                            </span>
                                        </div>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--taupe)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0; opacity: 0.4;"><polyline points="9 18 15 12 9 6"/></svg>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="d-flex gap-2 mt-auto pt-2">
                            <a href="{{ path('app_animal_index') }}" class="btn btn-outline-primary btn-sm">Tous les chevaux</a>
                            <a href="{{ path('app_animal_share_index') }}" class="btn btn-outline-secondary btn-sm">Mes partages</a>
                        </div>
                    </div>
                </div>
            </div>

            {# --- Rappels médicaux --- #}
            <div class="col-12 col-lg-5">
                <div class="section-card h-100 d-flex flex-column">
                    <div class="section-card-header">
                        <div>
                            <p class="page-eyebrow mb-0">Prochains rappels</p>
                        </div>
                        {% if upcoming_reminders is not empty %}
                            {% set overdue_count = 0 %}
                            {% for r in upcoming_reminders %}
                                {% if r.date < date() %}{% set overdue_count = overdue_count + 1 %}{% endif %}
                            {% endfor %}
                            {% if overdue_count > 0 %}
                                <span class="stat-pill" style="background: #fef2f2; color: var(--danger-color);">
                                    {{ overdue_count }} en retard
                                </span>
                            {% else %}
                                <span class="stat-pill" style="background: var(--soft-warm); color: var(--accent-color);">
                                    {{ upcoming_reminders|length }} à venir
                                </span>
                            {% endif %}
                        {% endif %}
                    </div>
                    <div class="section-card-body flex-grow-1 d-flex flex-column">
                        {% if upcoming_reminders is empty %}
                            <div class="text-center py-5 flex-grow-1 d-flex flex-column justify-content-center">
                                <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">✅</div>
                                <p class="fw-bold mb-1" style="color: var(--primary-color);">Tout est à jour !</p>
                                <p class="text-secondary small mb-0">Aucun rappel ou soin de prévu.</p>
                            </div>
                        {% else %}
                            <div class="d-flex flex-column">
                                {% for reminder in upcoming_reminders %}
                                    <div class="reminder-item {{ reminder.date < date() ? 'reminder-overdue' : 'reminder-upcoming' }}">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="reminder-icon">
                                                {% if reminder.date < date() %}
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                                {% else %}
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <strong class="d-block" style="font-size: 0.9rem; color: var(--secondary-color);">{{ reminder.title }}</strong>
                                                <span class="text-secondary" style="font-size: 0.78rem;">{{ reminder.animal.name }}</span>
                                            </div>
                                        </div>
                                        <span class="stat-pill {{ reminder.date < date() ? '' : '' }}" style="background: {{ reminder.date < date() ? '#fef2f2' : 'var(--soft-warm)' }}; color: {{ reminder.date < date() ? 'var(--danger-color)' : 'var(--accent-color)' }}; font-size: 0.72rem;">
                                            {{ reminder.date|date('d/m/Y') }}
                                        </span>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <a href="{{ path('app_health_book_entry_index') }}" class="btn btn-outline-primary btn-sm w-100 mt-auto pt-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="me-1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            Carnet de santé
                        </a>
                    </div>
                </div>
            </div>
        </div>

    {% else %}
        {# ======================================================================
           PAGE VITRINE VISITEUR DÉCONNECTÉ
           ====================================================================== #}

        {# Hero #}
        <section class="py-5">
            <div class="row align-items-center gy-5">
                <div class="col-12 col-lg-6">
                    <h1 class="fw-bold mb-3" style="font-size: 2.8rem; line-height: 1.15;">
                        Le carnet de santé <span class="text-teal">de vos chevaux</span>, toujours avec vous
                    </h1>
                    <p class="lead text-secondary mb-4">
                        AniCare centralise le suivi médical, les vaccins, les traitements et les rendez-vous
                        de vos chevaux. Partagez leur dossier avec votre vétérinaire en un clic.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-4 shadow-sm">Créer mon compte</a>
                        <a href="{{ path('app_about') }}" class="btn btn-outline-primary btn-lg px-4">En savoir plus</a>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <img src="{{ asset('images/hero-owner.jpg') }}"
                         alt="Propriétaire avec son chien dans un parc"
                         class="img-fluid rounded-3 shadow" loading="lazy">
                </div>
            </div>
        </section>

        {# Fonctionnalités #}
        <section class="py-5">
            <div class="text-center mb-5">
                <p class="page-eyebrow mb-2">Fonctionnalités</p>
                <h2 class="h3 page-title">Tout ce dont vos chevaux ont besoin</h2>
            </div>

            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">📋</div>
                            <h3 class="h6 fw-bold mb-2">Carnet de santé</h3>
                            <p class="text-secondary small mb-0">Historique complet des consultations, vaccins, chirurgies et traitements.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">📊</div>
                            <h3 class="h6 fw-bold mb-2">Courbe de poids</h3>
                            <p class="text-secondary small mb-0">Suivez l'évolution du poids de votre cheval avec un graphique interactif.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">🚨</div>
                            <h3 class="h6 fw-bold mb-2">Fiche d'urgence</h3>
                            <p class="text-secondary small mb-0">Allergies, traitements actifs et informations vitales en un coup d'oeil.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">🤝</div>
                            <h3 class="h6 fw-bold mb-2">Partage sécurisé</h3>
                            <p class="text-secondary small mb-0">Donnez accès au dossier à votre véto, un pet-sitter ou un proche.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# Section image + texte #}
        <section class="py-5">
            <div class="row align-items-center gy-4">
                <div class="col-12 col-lg-5">
                    <img src="{{ asset('images/cat-orange.jpg') }}"
                         alt="Chat roux regardant la caméra"
                         class="img-fluid rounded-3 shadow" loading="lazy">
                </div>
                <div class="col-12 col-lg-7">
                    <article>
                        <p class="page-eyebrow mb-2">Pour les propriétaires</p>
                        <h2 class="h3 page-title mb-3">Ne perdez plus jamais un rendez-vous</h2>
                        <p class="text-secondary">
