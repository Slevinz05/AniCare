{% extends 'base.html.twig' %}

{% block title %}{% if app.user %}Tableau de bord{% else %}Bienvenue{% endif %} - AniCare{% endblock %}

{% block body %}
<div class="container py-4">

    {% if app.user %}
        {# ======================================================================
           TABLEAU DE BORD CONNECTÉ
           ====================================================================== #}
        <style>
            .dashboard-hero {
                background: linear-gradient(135deg, #1a4d45 0%, #153d37 60%, #0f2e28 100%);
                border-radius: var(--radius-lg);
                padding: 2.5rem 2rem;
                color: #fff;
                position: relative;
                overflow: hidden;
                box-shadow: 0 8px 32px rgba(26, 77, 69, 0.3);
            }
            .dashboard-hero::before {
                content: '';
                position: absolute;
                top: -40px; right: -40px;
                width: 200px; height: 200px;
                border-radius: 50%;
                background: rgba(255,255,255,0.06);
            }
            .dashboard-hero::after {
                content: '';
                position: absolute;
                bottom: -60px; left: 30%;
                width: 300px; height: 300px;
                border-radius: 50%;
                background: rgba(255,255,255,0.04);
            }
            .dashboard-hero .hero-content { position: relative; z-index: 1; }
            .dashboard-hero .hero-greeting { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.03em; }
            .dashboard-hero .hero-email { opacity: 0.75; font-size: 0.9rem; }
            .dashboard-hero .btn-hero {
                background: rgba(255,255,255,0.15);
                border: 2px solid rgba(255,255,255,0.3);
                color: #fff; font-weight: 700;
                border-radius: var(--radius-sm);
                padding: 0.6rem 1.4rem;
                transition: all 0.2s;
                backdrop-filter: blur(4px);
            }
            .dashboard-hero .btn-hero:hover {
                background: rgba(255,255,255,0.25);
                border-color: rgba(255,255,255,0.5);
                transform: translateY(-1px);
            }

            .quick-action {
                display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
                padding: 1.4rem 1rem;
                border-radius: var(--radius-md);
                text-decoration: none;
                font-weight: 700; font-size: 0.85rem;
                transition: all 0.2s ease;
                border: 1px solid var(--border-color);
                position: relative;
                overflow: hidden;
            }
            .quick-action:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            }
            .quick-action .qa-icon {
                width: 56px; height: 56px;
                border-radius: 14px;
                display: flex; align-items: center; justify-content: center;
                font-size: 1.2rem;
                transition: transform 0.2s;
            }
            .quick-action:hover .qa-icon { transform: scale(1.1); }
            .qa-badge {
                position: absolute;
                top: 8px; right: 8px;
                min-width: 22px; height: 22px;
                border-radius: 11px;
                background: var(--danger-color);
                color: #fff;
                font-size: 0.7rem;
                font-weight: 800;
                display: flex; align-items: center; justify-content: center;
                padding: 0 5px;
                box-shadow: 0 2px 8px rgba(220, 38, 38, 0.4);
                animation: badge-pulse 2s infinite;
            }
            @keyframes badge-pulse {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.1); }
            }

            .qa-fiche { background: #fff; color: var(--secondary-color); }
            .qa-fiche .qa-icon { background: var(--soft-teal); color: var(--primary-color); }
            .qa-fiche:hover { border-color: var(--primary-color); background: var(--soft-teal); }

            .qa-repertoire { background: #fff; color: var(--secondary-color); }
            .qa-repertoire .qa-icon { background: var(--soft-teal); color: var(--primary-color); }
            .qa-repertoire:hover { border-color: var(--primary-color); background: var(--soft-teal); }

            .qa-consultation { background: var(--soft-teal); color: var(--primary-color); border: 2px dashed rgba(26,77,69,0.35); }
            .qa-consultation .qa-icon { background: rgba(26,77,69,0.12); color: var(--primary-color); }
            .qa-consultation:hover { border-color: var(--primary-color); background: #e0f2f0; box-shadow: 0 8px 24px rgba(26, 77, 69, 0.15); }

            .qa-agenda { background: #fff; color: var(--secondary-color); }
            .qa-agenda .qa-icon { background: var(--soft-warm); color: var(--accent-color); }
            .qa-agenda:hover { border-color: var(--accent-color); background: var(--soft-warm); }

            .qa-factures { background: #fff; color: var(--secondary-color); }
            .qa-factures .qa-icon { background: rgba(26,77,69,0.08); color: var(--secondary-color); }
            .qa-factures:hover { border-color: var(--secondary-color); background: #f5f5f3; }

            .qa-rdv { background: #fff; color: var(--secondary-color); }
            .qa-rdv .qa-icon { background: var(--accent-color); color: #fff; }
            .qa-rdv:hover { border-color: var(--accent-color); }

            .qa-planning { background: #fff; color: var(--secondary-color); }
            .qa-planning .qa-icon { background: var(--secondary-color); color: #fff; }
            .qa-planning:hover { border-color: var(--secondary-color); }

            .qa-partager { background: #fff; color: var(--secondary-color); }
            .qa-partager .qa-icon { background: #e0796b; color: #fff; }
            .qa-partager:hover { border-color: #e0796b; }

            .horse-mini-card {
                display: flex; align-items: center; gap: 1rem;
                padding: 0.85rem 1rem;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border-color);
                background: #fff;
                text-decoration: none;
                transition: all 0.2s ease;
            }
            .horse-mini-card:hover {
                border-color: var(--primary-color);
                background: var(--soft-teal);
                transform: translateX(4px);
                box-shadow: 0 4px 12px rgba(26, 77, 69, 0.1);
            }
            .horse-mini-card .horse-avatar {
                width: 48px; height: 48px;
                border-radius: 14px;
                object-fit: cover;
                flex-shrink: 0;
                border: 2px solid var(--border-color);
            }
            .horse-mini-card:hover .horse-avatar {
                border-color: var(--primary-color);
            }
            .horse-mini-card .horse-placeholder {
                width: 48px; height: 48px;
                border-radius: 14px;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--soft-teal) 0%, #e0f2f1 100%);
                display: flex; align-items: center; justify-content: center;
                font-size: 1.3rem;
                border: 2px solid var(--border-color);
            }

            .reminder-item {
                display: flex; justify-content: space-between; align-items: center;
                padding: 0.9rem 1rem;
                border-radius: var(--radius-sm);
                transition: background 0.15s;
                gap: 0.75rem;
            }
            .reminder-item:hover { background: var(--soft-teal); }
            .reminder-item + .reminder-item { border-top: 1px solid var(--border-color); }
            .reminder-icon {
                width: 36px; height: 36px;
                border-radius: 10px;
                display: flex; align-items: center; justify-content: center;
                flex-shrink: 0;
                font-size: 0.95rem;
            }
            .reminder-overdue .reminder-icon { background: #fef2f2; color: var(--danger-color); }
            .reminder-upcoming .reminder-icon { background: var(--soft-warm); color: var(--accent-color); }

            .section-card {
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                box-shadow: var(--shadow-subtle);
                overflow: hidden;
                position: relative;
                background: #fff;
            }
            .section-card::after {
                content: none;
                z-index: 0;
            }
            .section-card > * { position: relative; z-index: 1; }
            .section-card-header {
                padding: 1.25rem 1.5rem;
                border-bottom: 1px solid rgba(0,0,0,0.06);
                display: flex; justify-content: space-between; align-items: center;
            }
            .section-card-body { padding: 1rem 1.5rem 1.5rem; }

            .section-card.card-teal,
            .section-card.card-purple,
            .section-card.card-amber,
            .section-card.card-blue {
                background: #fff;
                border-color: var(--border-color);
            }
            .section-card.card-teal::after,
            .section-card.card-purple::after,
            .section-card.card-amber::after,
            .section-card.card-blue::after { background: none; }
            .section-card.card-teal .section-card-header,
            .section-card.card-purple .section-card-header,
            .section-card.card-amber .section-card-header,
            .section-card.card-blue .section-card-header { border-bottom-color: var(--border-color); }

            .section-icon {
                width: 32px; height: 32px;
                border-radius: 10px;
                display: flex; align-items: center; justify-content: center;
                flex-shrink: 0;
            }

            .stat-pill {
                display: inline-flex; align-items: center; gap: 0.35rem;
                padding: 0.3rem 0.75rem;
                border-radius: 2rem;
                font-size: 0.75rem; font-weight: 700;
            }

            .agenda-filter-btn {
                padding: 0.35rem 1rem;
                border-radius: 2rem;
                font-size: 0.8rem;
                font-weight: 700;
                border: 1px solid var(--border-color);
                background: #fff;
                color: var(--secondary-color);
                text-decoration: none;
                transition: all 0.2s;
            }
            .agenda-filter-btn:hover {
                border-color: var(--primary-color);
                color: var(--primary-color);
            }
            .agenda-filter-btn.active {
                background: var(--primary-color);
                border-color: var(--primary-color);
                color: #fff;
            }

            .agenda-event {
                display: flex; align-items: center; gap: 0.75rem;
                padding: 0.75rem 1rem;
                border-radius: var(--radius-sm);
                border-left: 3px solid var(--primary-color);
                background: #fff;
                transition: all 0.15s;
                text-decoration: none;
            }
            .agenda-event:hover {
                background: var(--soft-teal);
                transform: translateX(2px);
            }
            .agenda-event.event-appointment { border-left-color: var(--accent-color); }
            .agenda-event.event-consultation { border-left-color: var(--primary-color); }
            .agenda-event.event-past {
                opacity: 0.5;
                background: #f8f8f8 !important;
            }
            .agenda-event.event-past:hover { opacity: 0.75; }
            .agenda-separator {
                display: flex; align-items: center; gap: 0.75rem;
                margin: 0.5rem 0;
                font-size: 0.75rem; font-weight: 700;
                color: var(--primary-color);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }
            .agenda-separator::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border-color);
            }

            .draft-item {
                display: flex; align-items: center; gap: 0.75rem;
                padding: 0.75rem 1rem;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border-color);
                background: #fff;
                text-decoration: none;
                transition: all 0.15s;
            }
            .draft-item:hover {
                border-color: var(--accent-color);
                background: var(--soft-warm);
                transform: translateX(2px);
            }
            .draft-icon {
                width: 32px; height: 32px;
                border-radius: 8px;
                display: flex; align-items: center; justify-content: center;
                background: var(--soft-warm);
                color: var(--accent-color);
                flex-shrink: 0;
            }

            .evt-row {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.65rem 0.75rem;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border-color);
                background: #fff;
                transition: all 0.15s;
            }
            .evt-row:hover {
                border-color: var(--primary-color);
                background: var(--soft-teal);
                transform: translateX(2px);
            }
            .evt-date-badge {
                width: 48px; min-width: 48px; height: 48px;
                border-radius: 12px;
                display: flex; flex-direction: column;
                align-items: center; justify-content: center;
                flex-shrink: 0;
                font-weight: 800;
            }
            .evt-day { font-size: 1.2rem; line-height: 1; }
            .evt-month { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.8; }
            .min-width-0 { min-width: 0; }

            .evt-row-link {
                position: absolute;
                inset: 0;
                z-index: 1;
            }
            .evt-accept-form { flex-shrink: 0; }
            .evt-accept-btn {
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
                padding: 0.35rem 0.75rem;
                border-radius: 2rem;
                border: none;
                background: var(--primary-color);
                color: #fff;
                font-size: 0.72rem;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.15s;
                white-space: nowrap;
                box-shadow: 0 2px 8px rgba(26, 77, 69, 0.25);
            }
            .evt-accept-btn:hover {
                background: #153d37;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(26, 77, 69, 0.35);
            }
            .evt-accept-btn:active { transform: translateY(0); }
        </style>

        {# --- Hero --- #}
        <div class="dashboard-hero mb-4">
            <div class="hero-content">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <p class="hero-greeting mb-1">
                            Bonjour, {{ app.user.firstName|default(app.user.fullName) }} !
                        </p>
                        <p class="hero-email mb-0">
                            {{ app.user.userIdentifier }}
                            {% if app.user.isInProSpace() %}
                                <span style="background: rgba(200,151,62,0.3); border: 1px solid rgba(200,151,62,0.5); padding: 0.15rem 0.5rem; border-radius: 2rem; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.05em; margin-left: 0.5rem;">PRO</span>
                            {% endif %}
                        </p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        {% if app.user.isInProSpace() %}
                            <a href="{{ path('app_profile_pro_settings') }}" class="btn-hero text-decoration-none d-inline-flex align-items-center justify-content-center" style="width: 42px; height: 42px; padding: 0; border-radius: 50%;" title="Paramètres">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                            </a>
                        {% else %}
                            <a href="{{ path('app_animal_new') }}" class="btn-hero text-decoration-none d-inline-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Enregistrer un cheval
                            </a>
                        {% endif %}
                    </div>
                </div>

                {% if not app.user.isInProSpace() and animals is not empty %}
                    <div class="d-flex gap-2 mt-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.15); flex-wrap: wrap;">
                        <span style="font-size: 0.75rem; opacity: 0.6; align-self: center;">{{ animals|length }} {{ animals|length > 1 ? 'chevaux' : 'cheval' }}</span>
                        {% for animal in animals|slice(0, 4) %}
                            <a href="{{ path('app_animal_show', {'slug': animal.slug}) }}" title="{{ animal.name }}" style="text-decoration: none;">
                                {% if animal.photo %}
                                    <img src="{{ asset('uploads/photos/' ~ animal.photo) }}" alt="{{ animal.name }}" style="width: 32px; height: 32px; border-radius: 10px; object-fit: cover; border: 2px solid rgba(255,255,255,0.4);">
                                {% else %}
                                    <span style="width: 32px; height: 32px; border-radius: 10px; background: rgba(255,255,255,0.15); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; border: 2px solid rgba(255,255,255,0.3);">🐴</span>
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        {% if app.user.isInProSpace() %}
        {# ======================================================================
           DASHBOARD PRO
           ====================================================================== #}

        {# --- Accès rapide PRO (5 cards) --- #}
        <div class="row g-3 mb-4">
            <div class="col-6 col-md">
                <a href="{{ path('app_animal_search') }}" class="quick-action qa-fiche">
                    <span class="qa-icon">
                        <img src="{{ asset('images/horse-icon.svg') }}" alt="Cheval" width="30" height="30">
                    </span>
                    Nouvelle fiche
                </a>
            </div>
            <div class="col-6 col-md">
                <a href="{{ path('app_repertoire_reseau') }}" class="quick-action qa-repertoire">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span>
                    Répertoire
                </a>
            </div>
            <div class="col-12 col-md">
                <a href="{{ path('app_health_book_entry_new') }}" class="quick-action qa-consultation">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                    </span>
                    Nouvelle consultation
                </a>
            </div>
            <div class="col-6 col-md">
                <a href="{{ path('app_calendar') }}" class="quick-action qa-agenda">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
                    </span>
                    Agenda
                </a>
            </div>
            <div class="col-6 col-md">
                <a href="{{ path('app_factures') }}" class="quick-action qa-factures">
                    <span class="qa-icon" style="font-size: 1.4rem; font-weight: 800;">€</span>
                    Factures
                </a>
            </div>
        </div>

        {# --- Agenda --- #}
        <div class="section-card card-teal mb-4">
            <div class="section-card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-icon" style="background: rgba(26,77,69,0.15); color: var(--primary-color);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </span>
                    <p class="page-eyebrow mb-0">Agenda</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_home', {agenda: 'day'}) }}" class="agenda-filter-btn {{ pro.agenda_view == 'day' ? 'active' : '' }}">Jour</a>
                    <a href="{{ path('app_home', {agenda: 'week'}) }}" class="agenda-filter-btn {{ pro.agenda_view == 'week' ? 'active' : '' }}">Semaine</a>
                    <a href="{{ path('app_home', {agenda: 'month'}) }}" class="agenda-filter-btn {{ pro.agenda_view == 'month' ? 'active' : '' }}">Mois</a>
                </div>
            </div>
            <div class="section-card-body">
                <p class="text-secondary small mb-3">
                    {% if pro.agenda_view == 'day' %}
                        {{ pro.agenda_start|format_datetime('full', 'none', locale='fr') }}
                    {% elseif pro.agenda_view == 'week' %}
                        Semaine du {{ pro.agenda_start|format_datetime(pattern='dd MMMM', locale='fr') }} au {{ pro.agenda_end|format_datetime(pattern='dd MMMM yyyy', locale='fr') }}
                    {% else %}
                        {{ pro.agenda_start|format_datetime(pattern='MMMM Y', locale='fr') }}
                    {% endif %}
                </p>

                {% set all_events = [] %}
                {% for appt in pro.agenda_appointments %}
                    {% set all_events = all_events|merge([{type: 'appointment', date: appt.scheduledAt, title: appt.reason, animal: appt.animals|length > 1 ? appt.animals|length ~ ' chevaux' : (appt.animals|length == 1 ? appt.animals|first.name : (appt.animal ? appt.animal.name : appt.eventTypeShortLabel)), status: appt.status, id: appt.id}]) %}
                {% endfor %}
                {% for entry in pro.agenda_entries %}
                    {% set all_events = all_events|merge([{type: 'consultation', date: entry.date, title: entry.title, animal: entry.animal.name, entryType: entry.type, id: entry.id}]) %}
                {% endfor %}

                {% set now = "now"|date("U") %}
                {% set past_events = [] %}
                {% set upcoming_events = [] %}
                {% for event in all_events %}
                    {% if event.date|date("U") < now %}
                        {% set past_events = past_events|merge([event]) %}
                    {% else %}
                        {% set upcoming_events = upcoming_events|merge([event]) %}
                    {% endif %}
                {% endfor %}

                {% if all_events is empty %}
                    <div class="text-center py-4">
                        <div style="font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.3;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                        <p class="text-secondary small mb-0">Aucun événement sur cette période.</p>
                    </div>
                {% else %}
                    <div class="d-flex flex-column gap-2">
                        {# À venir #}
                        {% if upcoming_events|length > 0 and pro.agenda_view != 'day' %}
                            <div class="agenda-separator">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                À venir ({{ upcoming_events|length }})
                            </div>
                        {% endif %}
                        {% for event in upcoming_events|slice(0, 8) %}
                            {% if event.type == 'appointment' and event.status == 'CONFIRMED' %}
                                {% set ev_bg = 'var(--soft-teal)' %}
                                {% set ev_color = 'var(--primary-color)' %}
                                {% set ev_border = 'var(--primary-color)' %}
                                {% set ev_pill_label = 'Confirmé' %}
                            {% elseif event.type == 'appointment' %}
                                {% set ev_bg = 'var(--soft-warm)' %}
                                {% set ev_color = 'var(--accent-color)' %}
                                {% set ev_border = 'var(--accent-color)' %}
                                {% set ev_pill_label = 'En attente' %}
                            {% else %}
                                {% set ev_bg = 'var(--soft-teal)' %}
                                {% set ev_color = 'var(--primary-color)' %}
                                {% set ev_border = 'var(--primary-color)' %}
                                {% set ev_pill_label = event.entryType %}
                            {% endif %}
                            <a href="{{ event.type == 'appointment' ? path('app_appointment_show', {id: event.id}) : path('app_health_book_entry_show', {id: event.id}) }}"
                               class="agenda-event" style="border-left: 3px solid {{ ev_border }}; background: {{ ev_bg }};">
                                <div class="flex-grow-1">
                                    <strong style="font-size: 0.88rem; color: var(--secondary-color);">{{ event.title }}</strong>
                                    <span class="d-block text-secondary" style="font-size: 0.78rem;">
                                        {{ event.animal }} · {{ event.date|date('d/m H:i') }}
                                    </span>
                                </div>
                                <span class="stat-pill" style="background: {{ ev_bg }}; color: {{ ev_color }};">
                                    {{ ev_pill_label }}
                                </span>
                            </a>
                        {% endfor %}

                        {# Passés #}
                        {% if past_events|length > 0 and pro.agenda_view != 'day' %}
                            <div class="agenda-separator" style="color: var(--text-light);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                                Passés ({{ past_events|length }})
                            </div>
                        {% endif %}
                        {% for event in past_events|slice(0, 8) %}
                            {% if event.type == 'appointment' and event.status == 'CONFIRMED' %}
                                {% set ev_border = 'var(--primary-color)' %}
                                {% set ev_pill_label = 'Confirmé' %}
                            {% elseif event.type == 'appointment' %}
                                {% set ev_border = 'var(--accent-color)' %}
                                {% set ev_pill_label = 'En attente' %}
                            {% else %}
                                {% set ev_border = 'var(--primary-color)' %}
                                {% set ev_pill_label = event.entryType %}
                            {% endif %}
                            <a href="{{ event.type == 'appointment' ? path('app_appointment_show', {id: event.id}) : path('app_health_book_entry_show', {id: event.id}) }}"
                               class="agenda-event event-past" style="border-left: 3px solid {{ ev_border }};">
                                <div class="flex-grow-1">
                                    <strong style="font-size: 0.88rem; color: var(--secondary-color);">{{ event.title }}</strong>
                                    <span class="d-block text-secondary" style="font-size: 0.78rem;">
                                        {{ event.animal }} · {{ event.date|date('d/m H:i') }}
                                    </span>
                                </div>
                                <span class="stat-pill" style="background: #f0f0f0; color: var(--text-light);">
                                    {{ ev_pill_label }}
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                    {% if all_events|length > 16 %}
                        <a href="{{ path('app_calendar') }}" class="btn btn-outline-primary btn-sm w-100 mt-3">
                            Voir tout le planning
                        </a>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        <div class="row g-4 mb-4">
            {# --- Rendez-vous à venir --- #}
            <div class="col-12 col-lg-6">
                <div class="section-card card-teal h-100 d-flex flex-column">
                    <div class="section-card-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="section-icon" style="background: rgba(26,77,69,0.15); color: var(--primary-color);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
                            </span>
                            <p class="page-eyebrow mb-0">Rendez-vous à confirmer / à prévoir</p>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            {% set pro_pending = pro.upcoming_appointments|filter(a => a.status == 'PENDING')|length %}
                            {% if pro_pending > 0 %}
                                <span class="stat-pill" style="background: var(--soft-warm); color: var(--accent-color);">
                                    {{ pro_pending }} en attente
                                </span>
                            {% endif %}
                            {% set pro_confirmed = pro.upcoming_appointments|filter(a => a.status == 'CONFIRMED')|length %}
                            {% if pro_confirmed > 0 %}
                                <span class="stat-pill" style="background: var(--soft-teal); color: var(--primary-color);">
                                    {{ pro_confirmed }} confirmé{{ pro_confirmed > 1 ? 's' : '' }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="section-card-body flex-grow-1 d-flex flex-column">
                        {% if pro.upcoming_appointments is empty %}
                            <div class="text-center py-4 flex-grow-1 d-flex flex-column justify-content-center">
                                <div style="font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.3;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                </div>
                                <p class="text-secondary small mb-0">Aucun rendez-vous à venir.</p>
                            </div>
                        {% else %}
                            <div class="d-flex flex-column gap-2" style="max-height: 320px; overflow-y: auto;">
                                {% for appt in pro.upcoming_appointments %}
                                    {% if appt.status == 'PENDING' %}
                                        {% set appt_badge_bg = 'var(--soft-warm)' %}
                                        {% set appt_badge_color = 'var(--accent-color)' %}
                                        {% set appt_pill_label = 'En attente' %}
                                    {% elseif appt.status == 'CONFIRMED' %}
                                        {% set appt_badge_bg = 'var(--soft-teal)' %}
                                        {% set appt_badge_color = 'var(--primary-color)' %}
                                        {% set appt_pill_label = 'Confirmé' %}
                                    {% elseif appt.status == 'CANCELLED' %}
                                        {% set appt_badge_bg = '#f3f4f6' %}
                                        {% set appt_badge_color = 'var(--taupe)' %}
                                        {% set appt_pill_label = 'Annulé' %}
                                    {% else %}
                                        {% set appt_badge_bg = 'var(--soft-warm)' %}
                                        {% set appt_badge_color = 'var(--accent-color)' %}
                                        {% set appt_pill_label = appt.status %}
                                    {% endif %}
                                    <a href="{{ path('app_appointment_show', {id: appt.id}) }}" class="evt-row" style="text-decoration: none; color: inherit;">
                                        <div class="evt-date-badge" style="background: {{ appt_badge_bg }}; color: {{ appt_badge_color }};">
                                            <span class="evt-day">{{ appt.scheduledAt|date('d') }}</span>
                                            <span class="evt-month">{{ appt.scheduledAt|format_datetime(pattern='MMM', locale='fr') }}</span>
                                        </div>
                                        <div class="flex-grow-1 min-width-0">
                                            <strong class="d-block text-truncate" style="font-size: 0.88rem; color: var(--secondary-color);">{{ appt.reason }}</strong>
                                            <span class="text-secondary text-truncate d-block" style="font-size: 0.75rem;">
                                                <span style="font-weight: 600;">{{ appt.scheduledAt|date('H:i') }}</span>
                                                {% if appt.duration %} — {{ appt.scheduledAt|date_modify('+' ~ appt.duration ~ ' minutes')|date('H:i') }}{% endif %}
                                                · {{ appt.animals|length > 1 ? appt.animals|length ~ ' chevaux' : (appt.animals|length == 1 ? appt.animals|first.name : (appt.animal ? appt.animal.name : '')) }}
                                                {% if appt.client %} · {{ appt.client.fullName }}{% endif %}
                                            </span>
                                        </div>
                                        <span class="stat-pill" style="background: {{ appt_badge_bg }}; color: {{ appt_badge_color }}; font-size: 0.68rem; white-space: nowrap;">
                                            {{ appt_pill_label }}
                                        </span>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <a href="{{ path('app_appointment_index') }}" class="btn btn-outline-primary btn-sm w-100 mt-auto pt-2">
                            Tous les rendez-vous
                        </a>
                    </div>
                </div>
            </div>

            {# --- Brouillons --- #}
            <div class="col-12 col-lg-6">
                <div class="section-card card-purple h-100 d-flex flex-column">
                    <div class="section-card-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="section-icon" style="background: var(--soft-warm); color: var(--accent-color);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            </span>
                            <p class="page-eyebrow mb-0">Brouillons</p>
                        </div>
                        {% if pro.drafts is not empty %}
                            <span class="stat-pill" style="background: var(--soft-warm); color: var(--accent-color);">
                                {{ pro.drafts|length }}
                            </span>
                        {% endif %}
                    </div>
                    <div class="section-card-body flex-grow-1 d-flex flex-column">
                        {% if pro.drafts is empty %}
                            <div class="text-center py-4 flex-grow-1 d-flex flex-column justify-content-center">
                                <div style="font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.3;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                </div>
                                <p class="text-secondary small mb-0">Aucun brouillon en cours.</p>
                            </div>
                        {% else %}
                            <div class="d-flex flex-column gap-2">
                                {% for draft in pro.drafts %}
                                    <a href="{{ path('app_health_book_entry_edit', {id: draft.id}) }}" class="draft-item">
                                        <div class="draft-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </div>
                                        <div class="flex-grow-1">
                                            <strong style="font-size: 0.88rem; color: var(--secondary-color);">{{ draft.title }}</strong>
                                            <span class="d-block text-secondary" style="font-size: 0.78rem;">
                                                {{ draft.animal.name }} · modifié le {{ draft.updatedAt ? draft.updatedAt|date('d/m/Y H:i') : draft.date|date('d/m/Y') }}
                                            </span>
                                        </div>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="var(--taupe)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0; opacity:0.4;"><polyline points="9 18 15 12 9 6"/></svg>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <a href="{{ path('app_health_book_entry_new') }}" class="btn btn-outline-primary btn-sm w-100 mt-auto pt-2">
                            Nouvelle consultation
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# --- Rappels du jour + en retard --- #}
        {% set all_reminders_today = pro.todays_reminders|merge(pro.standalone_reminders_today|default([])) %}
        {% set overdue_reminders = pro.standalone_reminders_overdue|default([]) %}
        <div class="section-card card-amber mb-4">
            <div class="section-card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-icon" style="background: rgba(26,77,69,0.15); color: var(--primary-color);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    </span>
                    <p class="page-eyebrow mb-0">Rappels</p>
                </div>
                <div class="d-flex gap-2">
                    {% if overdue_reminders is not empty %}
                        <span class="stat-pill" style="background: #fef2f2; color: #dc2626;">
                            {{ overdue_reminders|length }} en retard
                        </span>
                    {% endif %}
                    {% if all_reminders_today is not empty %}
                        <span class="stat-pill" style="background: var(--soft-teal); color: var(--primary-color);">
                            {{ all_reminders_today|length }} aujourd'hui
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="section-card-body">
                {% if overdue_reminders is not empty %}
                    <p style="font-size: .78rem; font-weight: 700; color: #dc2626; margin-bottom: .5rem;">En retard</p>
                    <div class="d-flex flex-column gap-2 mb-3">
                        {% for reminder in overdue_reminders|slice(0, 5) %}
                            <a href="{{ path('app_reminder_show', {id: reminder.id}) }}" class="reminder-item reminder-overdue" style="text-decoration: none; color: inherit;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="reminder-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                    </div>
                                    <div>
                                        <strong class="d-block" style="font-size: 0.88rem; color: var(--secondary-color);">{{ reminder.title }}</strong>
                                        <span class="text-secondary" style="font-size: 0.78rem;">
                                            {{ reminder.animal.name }}
                                            · {{ reminder.scheduledAt|date('d/m/Y') }}
                                            {% if reminder.categoryLabel %} · {{ reminder.categoryLabel }}{% endif %}
                                        </span>
                                    </div>
                                </div>
                                <span class="stat-pill" style="background: #fef2f2; color: #dc2626;">
                                    En retard
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if all_reminders_today is not empty %}
                    {% if overdue_reminders is not empty %}
                        <p style="font-size: .78rem; font-weight: 700; color: var(--primary-color); margin-bottom: .5rem;">Aujourd'hui</p>
                    {% endif %}
                    <div class="d-flex flex-column gap-2">
                        {% for reminder in all_reminders_today %}
                            <div class="reminder-item reminder-upcoming">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="reminder-icon" style="background: var(--soft-teal); color: var(--primary-color);">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                    </div>
                                    <div>
                                        <strong class="d-block" style="font-size: 0.88rem; color: var(--secondary-color);">{{ reminder.title }}</strong>
                                        <span class="text-secondary" style="font-size: 0.78rem;">
                                            {{ reminder.animal.name }}
                                            {% if reminder.animal.owner %}
                                                · {{ reminder.animal.owner.fullName }}
                                            {% endif %}
                                        </span>
                                    </div>
                                </div>
                                <span class="stat-pill" style="background: var(--soft-teal); color: var(--primary-color);">
                                    {% if reminder.type is defined %}{{ reminder.type }}{% elseif reminder.categoryLabel is defined %}{{ reminder.categoryLabel }}{% else %}Rappel{% endif %}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if all_reminders_today is empty and overdue_reminders is empty %}
                    <div class="text-center py-4">
                        <div style="font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.3;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        </div>
                        <p class="text-secondary small mb-0">Aucun rappel prévu pour aujourd'hui.</p>
                    </div>
                {% endif %}

                <a href="{{ path('app_reminder_index') }}" class="btn btn-outline-primary btn-sm w-100 mt-3 d-flex align-items-center justify-content-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    Tous les rappels
                </a>
            </div>
        </div>

        {# --- Historique des consultations --- #}
        <div class="section-card card-blue mb-4">
            <div class="section-card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-icon" style="background: rgba(26,77,69,0.15); color: var(--primary-color);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </span>
                    <p class="page-eyebrow mb-0">Historique des consultations</p>
                </div>
            </div>
            <div class="section-card-body">
                {% if pro.recent_consultations|default([]) is empty %}
                    <div class="text-center py-4">
                        <div style="font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.3;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <p class="text-secondary small mb-0">Aucune consultation récente.</p>
                    </div>
                {% else %}
                    <div class="d-flex flex-column gap-2">
                        {% for entry in pro.recent_consultations %}
                            <a href="{{ path('app_health_book_entry_show', {id: entry.id}) }}" class="agenda-event event-consultation">
                                <div class="flex-grow-1">
                                    <strong style="font-size: 0.88rem; color: var(--secondary-color);">{{ entry.title }}</strong>
                                    <span class="d-block text-secondary" style="font-size: 0.78rem;">
                                        {{ entry.animal.name }} · {{ entry.date|date('d/m/Y') }}
                                    </span>
                                </div>
                                <span class="stat-pill" style="background: var(--soft-teal); color: var(--primary-color);">
                                    {{ entry.type }}
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
                <a href="{{ path('app_health_book_entry_index') }}" class="btn btn-outline-primary btn-sm w-100 mt-3 d-flex align-items-center justify-content-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Voir l'historique complet
                </a>
            </div>
        </div>

        {% else %}
        {# ======================================================================
           DASHBOARD PROPRIETAIRE
           ====================================================================== #}

        {# --- Accès rapide --- #}
        <div class="row g-3 mb-4">
            {% if not is_granted('ROLE_STRUCTURE') %}
            <div class="col-6 col-md-3">
                <a href="{{ path('app_health_book_entry_new') }}" class="quick-action qa-consultation">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                    </span>
                    Nouvelle consultation
                </a>
            </div>
            {% endif %}
            <div class="col-6 col-md-3">
                <a href="{{ path('app_appointment_index') }}" class="quick-action qa-rdv">
                    {% set pending_count = owner_appointments|filter(a => a.status == 'PENDING')|length %}
                    {% if pending_count > 0 %}
                        <span class="qa-badge">{{ pending_count }}</span>
                    {% endif %}
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </span>
                    Rendez-vous
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_calendar') }}" class="quick-action qa-planning">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    </span>
                    Planning
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_animal_share_new') }}" class="quick-action qa-partager">
                    <span class="qa-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    </span>
                    Partager
                </a>
            </div>
        </div>

        <div class="row g-4">
            {# --- Mes chevaux --- #}
            <div class="col-12 col-lg-7">
                <div class="section-card h-100 d-flex flex-column">
                    <div class="section-card-header">
                        <div>
                            <p class="page-eyebrow mb-0">{{ is_granted('ROLE_STRUCTURE') ? 'Chevaux de la structure' : 'Mes chevaux' }}</p>
                        </div>
                        {% if animals is not empty %}
                            <span class="stat-pill" style="background: var(--soft-teal); color: var(--primary-color);">
                                {{ animals|length }} {{ animals|length > 1 ? 'chevaux' : 'cheval' }}
                            </span>
                        {% endif %}
                    </div>
                    <div class="section-card-body flex-grow-1 d-flex flex-column">
                        {% if animals is empty %}
                            <div class="text-center py-5 flex-grow-1 d-flex flex-column justify-content-center">
                                <div style="font-size: 2.5rem; margin-bottom: 0.75rem; opacity: 0.4;">🐴</div>
                                <p class="text-secondary mb-3">Aucun cheval enregistré pour le moment.</p>
                                <a href="{{ path('app_animal_new') }}" class="btn btn-primary btn-sm mx-auto px-4">Ajouter mon premier cheval</a>
                            </div>
                        {% else %}
                            <div class="d-flex flex-column gap-2 mb-3">
                                {% for animal in animals %}
                                    <a href="{{ path('app_animal_show', {'slug': animal.slug}) }}" class="horse-mini-card">
                                        {% if animal.photo %}
                                            <img src="{{ asset('uploads/photos/' ~ animal.photo) }}"
                                                 alt="{{ animal.name }}"
                                                 class="horse-avatar">
                                        {% else %}
                                            <div class="horse-placeholder">🐴</div>
                                        {% endif %}
                                        <div class="flex-grow-1">
                                            <h4 class="fw-bold mb-0" style="font-size: 0.95rem; color: var(--secondary-color);">{{ animal.name }}</h4>
                                            <span class="text-secondary" style="font-size: 0.8rem;">
                                                {{ animal.breed ?: 'Race non renseignée' }}
                                                {% if animal.age is not null %} · {{ animal.age }} an{{ animal.age > 1 ? 's' : '' }}{% endif %}
                                            </span>
                                        </div>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--taupe)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0; opacity: 0.4;"><polyline points="9 18 15 12 9 6"/></svg>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="d-flex gap-2 mt-auto pt-2">
                            <a href="{{ path('app_animal_index') }}" class="btn btn-outline-primary btn-sm">Tous les chevaux</a>
                            <a href="{{ path('app_animal_share_index') }}" class="btn btn-outline-secondary btn-sm">Mes partages</a>
                        </div>
                    </div>
                </div>
            </div>

            {# --- Prochains événements (rappels + RDV) --- #}
            <div class="col-12 col-lg-5">
                <div class="section-card h-100 d-flex flex-column">
                    <div class="section-card-header">
                        <div>
                            <p class="page-eyebrow mb-0">Prochains événements</p>
                        </div>
                        {% set pending_appts = owner_appointments|filter(a => a.status == 'PENDING') %}
                        {% if pending_appts|length > 0 %}
                            <span class="stat-pill" style="background: var(--soft-warm); color: var(--accent-color);">
                                {{ pending_appts|length }} en attente
                            </span>
                        {% endif %}
                    </div>
                    <div class="section-card-body flex-grow-1 d-flex flex-column">
                        {# Build unified timeline sorted by date #}
                        {% set timeline = [] %}
                        {% for appt in owner_appointments|filter(a => a.status != 'CANCELLED') %}
                            {% set timeline = timeline|merge([{
                                sort_key: appt.scheduledAt|date('Y-m-d H:i'),
                                day: appt.scheduledAt|date('d'),
                                month: appt.scheduledAt|format_datetime(pattern='MMM', locale='fr'),
                                time: appt.scheduledAt|date('H:i'),
                                title: appt.reason,
                                subtitle: (appt.animals|length > 1 ? appt.animals|length ~ ' chevaux' : (appt.animals|length == 1 ? appt.animals|first.name : (appt.animal ? appt.animal.name : ''))) ~ (appt.createdBy and appt.createdBy != app.user ? ' · Dr. ' ~ appt.createdBy.fullName : ''),
                                type: 'appointment',
                                status: appt.status,
                                id: appt.id,
                                createdByMe: appt.createdBy == app.user,
                                link: path('app_appointment_show', {id: appt.id})
                            }]) %}
                        {% endfor %}
                        {% for reminder in upcoming_reminders %}
                            {% set timeline = timeline|merge([{
                                sort_key: reminder.date|date('Y-m-d H:i'),
                                day: reminder.date|date('d'),
                                month: reminder.date|format_datetime(pattern='MMM', locale='fr'),
                                time: null,
                                title: reminder.title,
                                subtitle: reminder.animal.name,
                                type: 'reminder',
                                status: reminder.date < date() ? 'OVERDUE' : 'UPCOMING',
                                link: null
                            }]) %}
                        {% endfor %}
                        {% set timeline = timeline|sort((a, b) => a.sort_key <=> b.sort_key) %}

                        {% if timeline is empty %}
                            <div class="text-center py-5 flex-grow-1 d-flex flex-column justify-content-center">
                                <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">✅</div>
                                <p class="fw-bold mb-1" style="color: var(--primary-color);">Tout est à jour !</p>
                                <p class="text-secondary small mb-0">Aucun rendez-vous ni rappel à venir.</p>
                            </div>
                        {% else %}
                            <div class="d-flex flex-column gap-2">
                                {% for event in timeline|slice(0, 6) %}
                                    {% if event.status == 'PENDING' %}
                                        {% set badge_bg = 'var(--soft-warm)' %}
                                        {% set badge_color = 'var(--accent-color)' %}
                                        {% set pill_label = 'En attente' %}
                                    {% elseif event.status == 'CONFIRMED' %}
                                        {% set badge_bg = 'var(--soft-teal)' %}
                                        {% set badge_color = 'var(--primary-color)' %}
                                        {% set pill_label = 'Confirmé' %}
                                    {% elseif event.status == 'OVERDUE' %}
                                        {% set badge_bg = '#fef2f2' %}
                                        {% set badge_color = 'var(--danger-color)' %}
                                        {% set pill_label = 'En retard' %}
                                    {% else %}
                                        {% set badge_bg = 'var(--soft-warm)' %}
                                        {% set badge_color = 'var(--accent-color)' %}
                                        {% set pill_label = 'Rappel' %}
                                    {% endif %}
                                    <div class="evt-row" style="color: inherit; position: relative;">
                                        {% if event.link %}<a href="{{ event.link }}" class="evt-row-link"></a>{% endif %}
                                        <div class="evt-date-badge" style="background: {{ badge_bg }}; color: {{ badge_color }};">
                                            <span class="evt-day">{{ event.day }}</span>
                                            <span class="evt-month">{{ event.month }}</span>
                                        </div>
                                        <div class="flex-grow-1 min-width-0">
                                            <strong class="d-block text-truncate" style="font-size: 0.88rem; color: var(--secondary-color);">{{ event.title }}</strong>
                                            <span class="text-secondary text-truncate d-block" style="font-size: 0.75rem;">
                                                {% if event.time %}<span style="font-weight: 600;">{{ event.time }}</span> · {% endif %}{{ event.subtitle }}
                                            </span>
                                        </div>
                                        {% if event.status == 'PENDING' and event.type == 'appointment' and event.id is defined and not (event.createdByMe ?? false) %}
                                            <form method="post" action="{{ path('app_appointment_confirm', {id: event.id}) }}?redirect=home" class="evt-accept-form" style="position: relative; z-index: 2;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('confirm' ~ event.id) }}">
                                                <button type="submit" class="evt-accept-btn" title="Accepter le rendez-vous">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                                    Accepter
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="stat-pill" style="background: {{ badge_bg }}; color: {{ badge_color }}; font-size: 0.68rem; white-space: nowrap;">
                                                {{ pill_label }}
                                            </span>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="d-flex gap-2 mt-auto pt-3">
                            <a href="{{ path('app_appointment_index') }}" class="btn btn-outline-primary btn-sm flex-fill">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="me-1"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                Rendez-vous
                            </a>
                            {% if not is_granted('ROLE_STRUCTURE') %}
                            <a href="{{ path('app_health_book_entry_index') }}" class="btn btn-outline-secondary btn-sm flex-fill">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="me-1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                Carnet de santé
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% endif %}

    {% else %}
        {# ======================================================================
           PAGE VITRINE VISITEUR DÉCONNECTÉ
           ====================================================================== #}

        {# Hero #}
        <section class="py-5">
            <div class="row align-items-center gy-5">
                <div class="col-12 col-lg-6">
                    <h1 class="fw-bold mb-3" style="font-size: 2.8rem; line-height: 1.15;">
                        Le carnet de santé <span class="text-teal">de vos chevaux</span>, toujours avec vous
                    </h1>
                    <p class="lead text-secondary mb-4">
                        AniCare centralise le suivi médical, les vaccins, les traitements et les rendez-vous
                        de vos chevaux. Partagez leur dossier avec votre vétérinaire en un clic.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-4 shadow-sm">Créer mon compte</a>
                        <a href="{{ path('app_about') }}" class="btn btn-outline-primary btn-lg px-4">En savoir plus</a>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <img src="{{ asset('images/hero-owner.jpg') }}"
                         alt="Propriétaire avec son chien dans un parc"
                         class="img-fluid rounded-3 shadow" loading="lazy">
                </div>
            </div>
        </section>

        {# Fonctionnalités #}
        <section class="py-5">
            <div class="text-center mb-5">
                <p class="page-eyebrow mb-2">Fonctionnalités</p>
                <h2 class="h3 page-title">Tout ce dont vos chevaux ont besoin</h2>
            </div>

            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">📋</div>
                            <h3 class="h6 fw-bold mb-2">Carnet de santé</h3>
                            <p class="text-secondary small mb-0">Historique complet des consultations, vaccins, chirurgies et traitements.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">📊</div>
                            <h3 class="h6 fw-bold mb-2">Courbe de poids</h3>
                            <p class="text-secondary small mb-0">Suivez l'évolution du poids de votre cheval avec un graphique interactif.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">🚨</div>
                            <h3 class="h6 fw-bold mb-2">Fiche d'urgence</h3>
                            <p class="text-secondary small mb-0">Allergies, traitements actifs et informations vitales en un coup d'oeil.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card anicare-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="mb-3" style="font-size: 2rem;">🤝</div>
                            <h3 class="h6 fw-bold mb-2">Partage sécurisé</h3>
                            <p class="text-secondary small mb-0">Donnez accès au dossier à votre véto, un pet-sitter ou un proche.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# Section image + texte #}
        <section class="py-5">
            <div class="row align-items-center gy-4">
                <div class="col-12 col-lg-5">
                    <img src="{{ asset('images/cat-orange.jpg') }}"
                         alt="Chat roux regardant la caméra"
                         class="img-fluid rounded-3 shadow" loading="lazy">
                </div>
                <div class="col-12 col-lg-7">
                    <article>
                        <p class="page-eyebrow mb-2">Pour les propriétaires</p>
                        <h2 class="h3 page-title mb-3">Ne perdez plus jamais un rendez-vous</h2>
                        <p class="text-secondary">
                            Combien de fois avez-vous oublié la date du prochain rappel de vaccin ?
                            Perdu l'ordonnance du vétérinaire ? Hésité sur la posologie d'un traitement ?
                        </p>
                        <p class="text-secondary">
                            AniCare résout ces problèmes en centralisant tout au même endroit.
                            Enregistrez une consultation, définissez un rappel, et retrouvez
                            l'information instantanément quand vous en avez besoin.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="py-5">
            <div class="row align-items-center gy-4">
                <div class="col-12 col-lg-7">
                    <aside>
                        <p class="page-eyebrow mb-2">Pour les professionnels</p>
                        <h2 class="h3 page-title mb-3">Un outil adapté à votre pratique</h2>
                        <p class="text-secondary">
                            Les vétérinaires, cliniques et refuges bénéficient d'un espace dédié.
                            Consultez les dossiers partagés par vos clients, ajoutez des consultations,
                            et suivez les traitements en cours depuis une interface pensée pour le terrain.
                        </p>
                        <p class="text-secondary">
                            Le mode professionnel affiche une vue consolidée de tous les chevaux
                            que vous suivez, avec un accès direct au planning et aux rappels.
                        </p>
                    </aside>
                </div>
                <div class="col-12 col-lg-5">
                    <img src="{{ asset('images/vet-dog.jpg') }}"
                         alt="Vétérinaire avec un chien"
                         class="img-fluid rounded-3 shadow" loading="lazy">
                </div>
            </div>
        </section>

        {# CTA final #}
        <section class="py-5">
            <div class="card anicare-card text-center">
                <div class="card-body p-5">
                    <h2 class="h3 page-title mb-3">Prêt à commencer ?</h2>
                    <p class="text-secondary mb-4">Inscription gratuite, aucune carte bancaire requise.</p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-5 shadow-sm">Créer mon compte</a>
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-lg px-5">Se connecter</a>
                    </div>
                </div>
            </div>
        </section>

    {% endif %}

</div>
{% endblock %}
