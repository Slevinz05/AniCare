{% extends 'base.html.twig' %}

{% block title %}Centre d'aide - AniCare{% endblock %}

{% block body %}
<style>
    .help-hero {
        background: linear-gradient(135deg, #0d9488 0%, #0f766e 60%, #115e59 100%);
        border-radius: var(--radius-lg);
        padding: 2.5rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(13, 148, 136, 0.3);
        text-align: center;
    }
    .help-hero::before {
        content: '';
        position: absolute;
        top: -50px; right: -50px;
        width: 220px; height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,0.06);
    }
    .help-hero::after {
        content: '';
        position: absolute;
        bottom: -70px; left: 25%;
        width: 320px; height: 320px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
    }
    .help-hero > * { position: relative; z-index: 1; }
    .help-hero h1 { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.03em; }
    .help-hero p { opacity: 0.8; font-size: 0.95rem; }

    .faq-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-subtle);
        overflow: hidden;
    }
    .faq-card-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        background: linear-gradient(180deg, #fff 0%, #fafaf8 100%);
        display: flex; align-items: center; gap: 0.75rem;
    }
    .faq-card-header .faq-header-icon {
        width: 36px; height: 36px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .faq-card-body { padding: 0; }

    .faq-item {
        border-bottom: 1px solid var(--border-color);
        transition: background 0.15s;
    }
    .faq-item:last-child { border-bottom: none; }
    .faq-question {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1rem 1.5rem;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--secondary-color);
        transition: color 0.15s, background 0.15s;
        gap: 1rem;
        user-select: none;
    }
    .faq-question:hover { background: var(--soft-teal); color: var(--primary-color); }
    .faq-question svg {
        flex-shrink: 0;
        transition: transform 0.25s;
        color: var(--taupe);
    }
    .faq-item.open .faq-question svg { transform: rotate(180deg); color: var(--primary-color); }
    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, padding 0.3s ease;
        padding: 0 1.5rem;
        font-size: 0.85rem;
        color: var(--taupe);
        line-height: 1.6;
    }
    .faq-item.open .faq-answer {
        max-height: 300px;
        padding: 0 1.5rem 1.25rem;
    }

    .help-topic {
        display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
        padding: 1.5rem 1rem;
        border-radius: var(--radius-md);
        text-decoration: none;
        font-weight: 700; font-size: 0.85rem;
        transition: all 0.2s ease;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        color: var(--secondary-color);
        text-align: center;
    }
    .help-topic:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }
    .help-topic .topic-icon {
        width: 48px; height: 48px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        transition: transform 0.2s;
    }
    .help-topic:hover .topic-icon { transform: scale(1.1); }
    .help-topic .topic-desc {
        font-size: 0.78rem;
        font-weight: 400;
        color: var(--taupe);
        line-height: 1.4;
    }

    .contact-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-subtle);
        overflow: hidden;
    }
    .contact-card-header {
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, var(--soft-teal) 0%, #e0f2f1 100%);
        border-bottom: 1px solid var(--border-color);
        text-align: center;
    }
    .contact-card-body { padding: 2rem; }
</style>

<div class="container py-4">

    {# --- Hero --- #}
    <div class="help-hero mb-4">
        <h1 class="mb-2">Comment pouvons-nous vous aider ?</h1>
        <p class="mb-0">Retrouvez les réponses à vos questions ou contactez notre équipe.</p>
    </div>

    {# --- Thèmes rapides --- #}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="{{ path('app_animal_index') }}" class="help-topic">
                <span class="topic-icon" style="background: var(--soft-teal); color: var(--primary-color);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </span>
                Mes chevaux
                <span class="topic-desc">Ajouter, modifier ou supprimer un cheval</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="{{ path('app_health_book_entry_index') }}" class="help-topic">
                <span class="topic-icon" style="background: var(--soft-warm); color: var(--accent-color);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </span>
                Carnet de santé
                <span class="topic-desc">Consultations, vaccins et traitements</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="{{ path('app_calendar') }}" class="help-topic">
                <span class="topic-icon" style="background: #f3e8ff; color: #7c3aed;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
                Planning
                <span class="topic-desc">Rendez-vous et agenda</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="{{ path('app_directory') }}" class="help-topic">
                <span class="topic-icon" style="background: #fef2f2; color: #e0796b;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                Intervenants
                <span class="topic-desc">Annuaire et partage de dossier</span>
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        {# --- FAQ --- #}
        <div class="col-12 col-lg-7">
            <div class="faq-card h-100">
                <div class="faq-card-header">
                    <div class="faq-header-icon" style="background: var(--soft-teal); color: var(--primary-color);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <div>
                        <p class="page-eyebrow mb-0">Questions fréquentes</p>
                    </div>
                </div>
                <div class="faq-card-body">
                    <div class="faq-item">
                        <div class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>Comment ajouter un nouveau cheval ?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="faq-answer">
                            Depuis votre tableau de bord, cliquez sur <strong>« Enregistrer un cheval »</strong> ou rendez-vous dans <strong>Mes chevaux → Ajouter</strong>. Renseignez le nom, la race, la date de naissance ou l'âge, puis enregistrez.
                        </div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>Comment enregistrer une consultation ?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="faq-answer">
                            Allez dans <strong>Consultations → Nouvelle consultation</strong>. Sélectionnez le cheval, le type d'acte, l'intervenant et ajoutez vos documents (ordonnances, radios…). Vous pouvez aussi définir un rappel automatique.
                        </div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>Comment partager un dossier avec mon vétérinaire ?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="faq-answer">
                            Sur la fiche de votre cheval, cliquez sur <strong>« Inviter un professionnel »</strong> et entrez l'adresse email de votre vétérinaire. Il recevra un accès en lecture au dossier de votre cheval.
                        </div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>Comment fonctionne le système de rappels ?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="faq-answer">
                            Lors de la création d'une consultation, vous pouvez définir une date de rappel et une récurrence (tous les 6 mois, chaque année…). Les rappels à venir et en retard s'affichent sur votre tableau de bord.
                        </div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>Comment trouver un professionnel équin ?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="faq-answer">
                            Utilisez l'<strong>annuaire des intervenants</strong> accessible depuis le menu principal. Filtrez par spécialité (vétérinaire, ostéopathe, maréchal-ferrant…) et par département. Vous pouvez aussi utiliser l'assistant chatbot en bas de page.
                        </div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question" onclick="this.parentElement.classList.toggle('open')">
                            <span>Mes données sont-elles sécurisées ?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="faq-answer">
                            Oui. Vos données sont stockées de manière sécurisée et ne sont accessibles qu'à vous et aux professionnels que vous avez explicitement invités. AniCare ne partage aucune information avec des tiers.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# --- Formulaire de contact --- #}
        <div class="col-12 col-lg-5">
            <div class="contact-card h-100 d-flex flex-column">
                <div class="contact-card-header">
                    <div style="width: 48px; height: 48px; border-radius: 14px; background: var(--primary-color); color: #fff; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 0.75rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </div>
                    <h2 class="h6 fw-bold mb-1" style="color: var(--secondary-color);">Contactez-nous</h2>
                    <p class="small mb-0" style="color: var(--taupe);">Notre équipe vous répond sous 24 à 48h.</p>
                </div>
                <div class="contact-card-body flex-grow-1 d-flex flex-column">
                    <form action="#" method="POST" novalidate class="d-flex flex-column flex-grow-1">
                        <div class="mb-3">
                            <label for="contact_name" class="form-label fw-bold" style="font-size: 0.85rem;">Nom ou raison sociale</label>
                            <input type="text" id="contact_name" name="name" class="form-control" placeholder="Ex : Dr. Martin" required>
                        </div>

                        <div class="mb-3">
                            <label for="contact_email" class="form-label fw-bold" style="font-size: 0.85rem;">Adresse email</label>
                            <input type="email" id="contact_email" name="email" class="form-control" placeholder="nom@exemple.com" required
                                   {% if app.user %}value="{{ app.user.email }}"{% endif %}>
                        </div>

                        <div class="mb-3 flex-grow-1 d-flex flex-column">
                            <label for="contact_message" class="form-label fw-bold" style="font-size: 0.85rem;">Votre message</label>
                            <textarea id="contact_message" name="message" class="form-control flex-grow-1" rows="4" placeholder="Décrivez votre demande..." required style="min-height: 100px; resize: vertical;"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 mt-auto">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                            Envoyer le message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {# --- Infos complémentaires --- #}
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background: var(--card-bg); border: 1px solid var(--border-color);">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: var(--soft-teal); color: var(--primary-color); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                    <strong style="font-size: 0.85rem; color: var(--secondary-color);">Email</strong>
                    <p class="small mb-0" style="color: var(--taupe);">contact@anicare.fr</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background: var(--card-bg); border: 1px solid var(--border-color);">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: var(--soft-warm); color: var(--accent-color); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                    <strong style="font-size: 0.85rem; color: var(--secondary-color);">Horaires</strong>
                    <p class="small mb-0" style="color: var(--taupe);">Lun - Ven, 9h - 18h</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background: var(--card-bg); border: 1px solid var(--border-color);">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: #f3e8ff; color: #7c3aed; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <div>
                    <strong style="font-size: 0.85rem; color: var(--secondary-color);">Chatbot</strong>
                    <p class="small mb-0" style="color: var(--taupe);">Disponible 24h/24 en bas de page</p>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
