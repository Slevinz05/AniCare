{% extends 'base.html.twig' %}

{% block title %}Contactez-nous | AniCare{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0 px-4 py-3">
                <div class="card-body">
                    <h1 class="h2 text-center text-dark mb-3">Une question ? Contactez AniCare</h1>
                    <p class="text-center text-muted mb-4">Notre équipe vous répond sous 24h à 48h.</p>
                    
                    <form action="#" method="POST" novalidate>
                        <div class="mb-3">
                            <label for="contact_name" class="form-label fw-medium">Nom ou Raison Sociale</label>
                            <input type="text" id="contact_name" name="name" class="form-control" placeholder="Ex: Dr. Martin" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="contact_email" class="form-label fw-medium">Adresse email</label>
                            <input type="email" id="contact_email" name="email" class="form-control" placeholder="nom@exemple.com" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="contact_message" class="form-label fw-medium">Votre message</label>
                            <textarea id="contact_message" name="message" class="form-control" rows="5" placeholder="Décrivez votre demande..." required></textarea>
                        </div>
                        
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                Envoyer le message
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}