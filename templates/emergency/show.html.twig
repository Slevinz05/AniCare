{% extends 'base.html.twig' %}
{% block title %}Fiche d'urgence - {{ animal.name }} - AniCare{% endblock %}
{% block body %}
<div class="container py-4">
    <div class="card anicare-card overflow-hidden border-danger">

        {# ── Zone rouge : identité du cheval ── #}
        <div class="card-header p-4" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="mb-1 fw-bold text-uppercase small" style="letter-spacing: 0.1em; opacity: 0.9;">Fiche d'urgence</p>
                    <h1 class="mb-1 fw-bold" style="font-size: 1.8rem;">{{ animal.name }}</h1>
                    <p class="mb-0" style="opacity: 0.9; font-size: 0.95rem;">
                        {% if animal.gender %}{{ animal.gender }}{% endif %}
                        {% if animal.age is not null %} &middot; {{ animal.age }} an{{ animal.age > 1 ? 's' : '' }}{% endif %}
                        {% if animal.breed %} &middot; {{ animal.breed }}{% endif %}
                    </p>
                </div>
                <div class="text-end">
                    {% if animal.identificationNumber %}
                        <p class="mb-0 small fw-bold" style="opacity: 0.8;">SIRE</p>
                        <p class="mb-1 fw-bold" style="font-family: monospace;">{{ animal.identificationNumber }}</p>
                    {% endif %}
                    {% if animal.microchipNumber %}
                        <p class="mb-0 small fw-bold" style="opacity: 0.8;">N° Puce</p>
                        <p class="mb-0 fw-bold" style="font-family: monospace;">{{ animal.microchipNumber }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                {# ── Informations vitales ── #}
                <div class="col-12 col-md-6">
                    <div class="p-3 rounded-3 bg-light h-100">
                        <h2 class="h6 text-uppercase text-danger fw-bold mb-3">Informations vitales</h2>
                        <table class="table table-sm mb-0">
                            {% if animal.birthDate %}
                                <tr>
                                    <th>Date de naissance</th>
                                    <td>
                                        <strong>{{ animal.birthDate|date('d/m/Y') }}</strong>
                                        {% if animal.age is not null %}
                                            <span class="text-secondary small">({{ animal.age }} an{{ animal.age > 1 ? 's' : '' }})</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endif %}
                            <tr>
                                <th>Sexe</th>
                                <td><strong>{{ animal.gender ?: 'Non renseigné' }}</strong></td>
                            </tr>
                            <tr>
                                <th>Poids</th>
                                <td><strong>{{ animal.weight ? animal.weight ~ ' kg' : 'Inconnu' }}</strong></td>
                            </tr>
                            {% if animal.height %}
                                <tr>
                                    <th>Taille</th>
                                    <td><strong>{{ animal.height }} m</strong></td>
                                </tr>
                            {% endif %}
                            {% if animal.identificationNumber %}
                                <tr>
                                    <th>N° SIRE</th>
                                    <td><strong style="font-family: monospace;">{{ animal.identificationNumber }}</strong></td>
                                </tr>
                            {% endif %}
                            {% if animal.microchipNumber %}
                                <tr>
                                    <th>N° Puce</th>
                                    <td><strong style="font-family: monospace;">{{ animal.microchipNumber }}</strong></td>
                                </tr>
                            {% endif %}
                            {% if animal.livingPlaceName %}
                                <tr>
                                    <th>Lieu de vie</th>
                                    <td>
                                        <strong>{{ animal.livingPlaceName }}</strong>
                                        {% if animal.livingPlaceManagerPhone %}
                                            <br><a href="tel:{{ animal.livingPlaceManagerPhone }}" class="small">{{ animal.livingPlaceManagerPhone }}</a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endif %}
                        </table>
                    </div>
                </div>

                {# ── Contacts ── #}
                <div class="col-12 col-md-6">
                    <div class="p-3 rounded-3 bg-light h-100">
                        <h2 class="h6 text-uppercase text-danger fw-bold mb-3">Contacts</h2>

                        {# Propriétaire #}
                        <div class="mb-3 pb-3 border-bottom">
                            <p class="small text-uppercase fw-bold text-secondary mb-2" style="letter-spacing: 0.05em;">Propriétaire</p>
                            <p class="mb-1 fw-bold">{{ animal.owner.fullName }}</p>
                            {% if animal.owner.phone %}
                                <p class="mb-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary me-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                    <a href="tel:{{ animal.owner.phone }}">{{ animal.owner.phone }}</a>
                                </p>
                            {% endif %}
                            <p class="mb-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary me-1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                <a href="mailto:{{ animal.owner.email }}">{{ animal.owner.email }}</a>
                            </p>
                            {% if animal.owner.fullAddress %}
                                <p class="mb-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary me-1"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    <span class="small">{{ animal.owner.fullAddress }}</span>
                                </p>
                            {% endif %}
                        </div>

                        {# Contact de confiance #}
                        <div>
                            <p class="small text-uppercase fw-bold text-secondary mb-2" style="letter-spacing: 0.05em;">Contact de confiance</p>
                            {% if animal.trustedContactFullName %}
                                <p class="mb-1 fw-bold">{{ animal.trustedContactFullName }}</p>
                                {% if animal.trustedContactPhone %}
                                    <p class="mb-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary me-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                        <a href="tel:{{ animal.trustedContactPhone }}">{{ animal.trustedContactPhone }}</a>
                                    </p>
                                {% endif %}
                            {% else %}
                                <p class="text-secondary mb-0 small fst-italic">Non renseigné — <a href="{{ path('app_animal_edit', {'slug': animal.slug}) }}">Ajouter</a></p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# ── Allergies ── #}
                <div class="col-12 col-md-6">
                    <div class="p-3 rounded-3 h-100 {{ allergies is not empty ? 'bg-danger bg-opacity-10 border border-danger' : 'bg-light' }}">
                        <h2 class="h6 text-uppercase text-danger fw-bold mb-3">
                            Allergies connues
                            {% if allergies is not empty %}
                                <span class="badge bg-danger ms-1">{{ allergies|length }}</span>
                            {% endif %}
                        </h2>
                        {% if allergies is empty %}
                            <p class="text-secondary mb-0">Aucune allergie connue.</p>
                        {% else %}
                            {% for a in allergies %}
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>{{ a.name }}</strong>
                                    {% if a.severity == 'SEVERE' %}
                                        <span class="badge bg-danger">Sévère</span>
                                    {% elseif a.severity == 'MODERATE' %}
                                        <span class="badge bg-warning text-dark">Modérée</span>
                                    {% else %}
                                        <span class="badge bg-info text-dark">Légère</span>
                                    {% endif %}
                                </div>
                                {% if a.symptoms %}
                                    <p class="small text-secondary mb-2">{{ a.symptoms }}</p>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>

                {# ── Historique Bilan sanguin ── #}
                <div class="col-12 col-md-6">
                    <div class="p-3 rounded-3 bg-light h-100">
                        <h2 class="h6 text-uppercase text-danger fw-bold mb-3">
                            Historique Bilan sanguin
                            {% if blood_tests is not empty %}
                                <span class="badge bg-secondary ms-1">{{ blood_tests|length }}</span>
                            {% endif %}
                        </h2>
                        {% if blood_tests is empty %}
                            <p class="text-secondary mb-0">Aucun bilan sanguin enregistré.</p>
                        {% else %}
                            <div class="list-group list-group-flush">
                                {% for entry in blood_tests %}
                                    <a href="{{ path('app_health_book_entry_show', {'id': entry.id}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 border-0">
                                        <div>
                                            <strong class="small">{{ entry.title }}</strong>
                                            <br><span class="text-secondary small">{{ entry.date|date('d/m/Y') }}</span>
                                        </div>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><polyline points="9 18 15 12 9 6"/></svg>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# ── Traitements en cours ── #}
                <div class="col-12">
                    <div class="p-3 rounded-3 bg-light">
                        <h2 class="h6 text-uppercase text-danger fw-bold mb-3">Traitements en cours</h2>
                        {% if active_treatments is empty %}
                            <p class="text-secondary mb-0">Aucun traitement en cours.</p>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Acte</th><th>Posologie</th><th>Fréquence</th><th>Depuis</th></tr></thead>
                                    <tbody>
                                        {% for t in active_treatments %}
                                            <tr>
                                                <td><strong>{{ t.title }}</strong></td>
                                                <td>{{ t.dosage ?: '-' }}</td>
                                                <td>{{ t.frequency ?: '-' }}</td>
                                                <td>{{ t.date|date('d/m/Y') }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# ── Rappels en retard ── #}
                {% if overdue_reminders is not empty %}
                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-warning bg-opacity-10 border border-warning">
                            <h2 class="h6 text-uppercase text-warning fw-bold mb-3">Rappels en retard</h2>
                            {% for entry in overdue_reminders %}
                                <div class="mb-1">
                                    <strong>{{ entry.title }}</strong>
                                    <span class="text-secondary small">— rappel prévu le {{ entry.nextReminderAt|date('d/m/Y') }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-4 border-top">
                <a href="{{ path('app_animal_show', {'slug': animal.slug}) }}" class="btn btn-outline-primary">Retour à la fiche</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
