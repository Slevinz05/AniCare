{% extends 'base.html.twig' %}

{% block title %}{{ structure.name }} - AniCare{% endblock %}

{% block body %}
{# ═══════════════════════════════════════════════
   HERO COVER
   ═══════════════════════════════════════════════ #}
<div class="structure-hero" {% if structure.coverPhoto %}style="background-image: url('{{ path('app_structure_cover', {id: structure.id, fileName: structure.coverPhoto}) }}')"{% endif %}>
    <div class="structure-hero-overlay"></div>
    <div class="container position-relative" style="z-index: 2;">
        <div class="d-flex justify-content-between align-items-end">
            <div>
                {% if structure.type %}
                    <span class="badge structure-type-badge mb-2">{{ structure.type }}</span>
                {% endif %}
                <h1 class="structure-hero-title">{{ structure.name }}</h1>
                {% if structure.fullAddress %}
                    <p class="structure-hero-address mb-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {{ structure.fullAddress }}
                    </p>
                {% endif %}
            </div>
            {% if is_granted('STRUCTURE_EDIT', structure) %}
                <a href="{{ path('app_structure_edit', {id: structure.id}) }}" class="btn btn-light btn-sm d-inline-flex align-items-center gap-1" style="border-radius: 8px; font-weight: 600;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Modifier
                </a>
            {% endif %}
        </div>
    </div>
</div>

<div class="container py-4">
    {% if not structure.hasManager %}
        <div class="alert d-flex align-items-center gap-3 mb-4" style="background: #fef7ed; border: 1px solid #fde68a; border-radius: var(--radius-md); padding: 1rem 1.25rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="#d97706" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div style="flex: 1;">
                <strong style="font-size: .9rem; color: #92400e;">Structure sans gérant inscrit</strong>
                <p class="mb-0" style="font-size: .82rem; color: #b45309;">Cette fiche-lieu n'a pas de gérant inscrit. Vous pouvez revendiquer la gérance avec le code de rattachement.</p>
            </div>
            {% if structure.claimCode %}
                <a href="{{ path('app_structure_claim') }}" class="btn btn-sm" style="background: #d97706; color: #fff; border-radius: var(--radius-sm); font-weight: 600; font-size: .82rem; white-space: nowrap;">
                    Revendiquer
                </a>
            {% endif %}
        </div>
    {% endif %}

    {# ═══════════════════════════════════════════════
       DESCRIPTION + QUICK INFO
       ═══════════════════════════════════════════════ #}
    {% if structure.description or structure.phone or structure.email %}
    <div class="row g-4 mb-4">
        {% if structure.description %}
        <div class="col-12 col-lg-8">
            <div class="card anicare-card h-100">
                <div class="card-body p-4">
                    <p class="page-eyebrow mb-2">À propos</p>
                    <div class="structure-description">{{ structure.description|e('html')|nl2br }}</div>
                </div>
            </div>
        </div>
        {% endif %}

        <div class="{{ structure.description ? 'col-12 col-lg-4' : 'col-12' }}">
            <div class="card anicare-card h-100">
                <div class="card-body p-4">
                    <p class="page-eyebrow mb-3">Contact</p>
                    <div class="d-flex flex-column gap-3">
                        {% if structure.phone %}
                        <div class="d-flex align-items-center gap-3">
                            <div class="structure-contact-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            </div>
                            <div>
                                <div class="small text-secondary">Téléphone</div>
                                <div class="fw-semibold" style="color: var(--secondary-color);">{{ structure.phone }}</div>
                            </div>
                        </div>
                        {% endif %}
                        {% if structure.email %}
                        <div class="d-flex align-items-center gap-3">
                            <div class="structure-contact-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            </div>
                            <div>
                                <div class="small text-secondary">E-mail</div>
                                <div class="fw-semibold" style="color: var(--secondary-color);">{{ structure.email }}</div>
                            </div>
                        </div>
                        {% endif %}
                        {% if structure.siret %}
                        <div class="d-flex align-items-center gap-3">
                            <div class="structure-contact-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                            </div>
                            <div>
                                <div class="small text-secondary">SIRET</div>
                                <div class="fw-semibold" style="color: var(--secondary-color);">{{ structure.siret }}</div>
                            </div>
                        </div>
                        {% endif %}
                        <div class="d-flex align-items-center gap-3">
                            <div class="structure-contact-icon" style="background: var(--soft-warm, #fffbeb);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="var(--accent-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div>
                                <div class="small text-secondary">Créée le</div>
                                <div class="fw-semibold" style="color: var(--secondary-color);">{{ structure.createdAt|date('d/m/Y') }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# ═══════════════════════════════════════════════
       CHEVAUX + MEMBRES
       ═══════════════════════════════════════════════ #}
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card anicare-card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <p class="page-eyebrow mb-1">Pensionnaires</p>
                            <h2 class="h5 page-title mb-0">Chevaux ({{ animals|length }})</h2>
                        </div>
                        {% if is_granted('STRUCTURE_EDIT', structure) %}
                        <a href="{{ path('app_animal_new') }}" class="btn btn-sm d-inline-flex align-items-center gap-1" style="background: var(--primary-color); color: #fff; border-radius: 8px; font-weight: 600;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            Ajouter
                        </a>
                        {% endif %}
                    </div>

                    {% if animals is empty %}
                        <div class="text-center py-4">
                            <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🐴</div>
                            <p class="text-muted small mb-0">Aucun cheval rattaché à cette structure.</p>
                        </div>
                    {% else %}
                        <div class="d-flex flex-column gap-2">
                            {% for animal in animals %}
                            <a href="{{ path('app_animal_show', {slug: animal.slug}) }}" class="structure-animal-card text-decoration-none">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="structure-animal-avatar">
                                        {% if animal.photo %}
                                            <img src="{{ asset('uploads/photos/' ~ animal.photo) }}" alt="{{ animal.name }}">
                                        {% else %}
                                            🐴
                                        {% endif %}
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold" style="color: var(--secondary-color);">{{ animal.name }}</div>
                                        <div class="small text-secondary">{{ animal.breed ?? 'Race non renseignée' }}</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="small text-secondary">{{ animal.owner.fullName ?? animal.owner.email }}</div>
                                    </div>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                                </div>
                            </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card anicare-card mb-4">
                <div class="card-body p-4">
                    <p class="page-eyebrow mb-2">Équipe</p>
                    <h2 class="h5 page-title mb-3">Membres ({{ members|length }})</h2>

                    {% for membership in members %}
                        <div class="d-flex align-items-center gap-3 {{ not loop.last ? 'mb-3 pb-3 border-bottom' : '' }}">
                            <div class="structure-member-avatar">
                                {{ membership.user.firstName|default('?')|first|upper }}
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold small" style="color: var(--secondary-color);">{{ membership.user.fullName ?? membership.user.email }}</div>
                                <div class="text-muted" style="font-size: 0.75rem;">{{ membership.user.email }}</div>
                            </div>
                            <span class="badge {{ membership.role == 'MANAGER' ? 'structure-badge-manager' : (membership.role == 'PRO' ? 'structure-badge-pro' : 'structure-badge-owner') }}">
                                {{ membership.role == 'MANAGER' ? 'Gérant' : (membership.role == 'PRO' ? 'Pro' : 'Propriétaire') }}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if structure.claimCode and not structure.hasManager %}
            <div class="card anicare-card mb-4">
                <div class="card-body p-4">
                    <p class="page-eyebrow mb-2">Code de rattachement</p>
                    <p class="text-secondary mb-3" style="font-size: 0.8rem;">Cette structure n'a pas encore de gérant. Partagez ce code pour permettre à quelqu'un de revendiquer la gérance.</p>
                    <div class="d-flex align-items-center gap-2">
                        <code class="structure-claim-code">{{ structure.claimCode }}</code>
                        <button type="button" class="btn btn-sm btn-outline-secondary border-0" onclick="navigator.clipboard.writeText('{{ structure.claimCode }}'); this.innerHTML='✓'; setTimeout(() => this.innerHTML='Copier', 1500);" style="font-size: 0.75rem;">Copier</button>
                    </div>
                </div>
            </div>
            {% endif %}

        </div>
    </div>
</div>

<style>
.structure-hero {
    position: relative;
    background: linear-gradient(135deg, var(--primary-color) 0%, #2d6a5f 50%, var(--secondary-color) 100%);
    background-size: cover;
    background-position: center;
    padding: 3rem 0 2rem;
    min-height: 200px;
    display: flex;
    align-items: flex-end;
}
.structure-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.05) 100%);
    z-index: 1;
}
.structure-hero-title {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
}
.structure-hero-address {
    color: rgba(255,255,255,0.85);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.3rem;
}
.structure-type-badge {
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.25);
}
.structure-description {
    color: var(--secondary-color);
    font-size: 0.92rem;
    line-height: 1.7;
}
.structure-contact-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--soft-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.structure-contact-icon svg {
    stroke: var(--primary-color);
}
.structure-animal-card {
    display: block;
    padding: 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    transition: all 0.15s;
}
.structure-animal-card:hover {
    background: var(--soft-teal);
    border-color: var(--primary-color);
    transform: translateX(2px);
}
.structure-animal-avatar {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
    overflow: hidden;
}
.structure-animal-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.structure-member-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-color), #2d6a5f);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.structure-badge-manager {
    background: linear-gradient(135deg, var(--accent-color), #b8862f);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
}
.structure-badge-pro {
    background: linear-gradient(135deg, var(--primary-color), #153d37);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
}
.structure-badge-owner {
    background: var(--soft-teal);
    color: var(--primary-color);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
}
.structure-claim-code {
    background: var(--soft-teal);
    color: var(--primary-color);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    border: 1px dashed var(--primary-color);
}
</style>
{% endblock %}
