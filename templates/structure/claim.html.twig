{% extends 'base.html.twig' %}

{% block title %}Rejoindre une structure - AniCare{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 720px;">
    <a href="{{ path('app_structure_index') }}" class="btn btn-sm btn-outline-secondary mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-arrow-left me-1" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/></svg>
        Retour
    </a>

    <div class="card anicare-card mb-4">
        <div class="card-body p-4 p-lg-5">
            <p class="page-eyebrow mb-2">Gestion</p>
            <h1 class="page-title mb-4">Devenir gérant d'une structure</h1>

            <p class="text-muted mb-4">
                Saisissez le code qui vous a été communiqué par AniCare pour prendre la gestion de votre structure.
            </p>

            <form method="post" action="{{ path('app_structure_claim') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('claim_structure') }}">

                <div class="mb-3">
                    <label for="claim_code" class="form-label fw-semibold">Code de structure</label>
                    <div class="input-group">
                        <input type="text" name="claim_code" id="claim_code" class="form-control form-control-lg font-monospace text-center" placeholder="XXXXXXXX" maxlength="8" style="letter-spacing: 3px;" required>
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-key me-1" viewBox="0 0 16 16"><path d="M0 8a4 4 0 0 1 7.465-2H14a.5.5 0 0 1 .354.146l1.5 1.5a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0L13 9.207l-.646.647a.5.5 0 0 1-.708 0L11 9.207l-.646.647a.5.5 0 0 1-.708 0L9 9.207l-.646.647A.5.5 0 0 1 8 10h-.535A4 4 0 0 1 0 8m4-3a3 3 0 1 0 2.959 3.5H8a.5.5 0 0 0 .354-.146l.646-.647.646.647a.5.5 0 0 0 .708 0l.646-.647.646.647a.5.5 0 0 0 .708 0l.646-.647.646.647a.5.5 0 0 0 .708 0l1.146-1.147-1.146-1.147a.5.5 0 0 0-.708 0L13 6.793l-.646-.647a.5.5 0 0 0-.708 0L11 6.793l-.646-.647a.5.5 0 0 0-.708 0L9 6.793l-.646-.647A.5.5 0 0 0 8 6H6.959A3 3 0 0 0 4 5m-1 3a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/></svg>
                            Valider
                        </button>
                    </div>
                    <div class="form-text">Ce code vous est communiqué par l'équipe AniCare.</div>
                </div>
            </form>

            <hr class="my-4">

            <div class="text-center">
                <p class="small text-muted mb-2">Vous n'avez pas encore de code ?</p>
                <p class="small text-muted">
                    Contactez l'équipe AniCare pour obtenir le code de votre structure.
                    Si votre structure n'est pas encore référencée, vous pouvez la
                    <a href="{{ path('app_structure_new') }}" class="fw-semibold">créer vous-même</a>.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
