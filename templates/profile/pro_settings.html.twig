    <form method="post" action="{{ path('app_profile_pro_settings', {tab: 'profil'}) }}" id="profilForm">
        <input type="hidden" name="_section" value="profil">

        {# ── Complétude ── #}
        <div class="pf-progress" id="profileProgress">
            <div class="pf-progress-head">
                <div>
                    <p class="pf-progress-title">Votre profil professionnel</p>
                    <p class="pf-progress-desc">Les informations qui présentent votre activité.</p>
                </div>
                <span class="pf-progress-value"><span id="progressPct">0</span> %</span>
            </div>
            <div class="pf-progress-bar"><span id="progressBar"></span></div>
            <div class="pf-progress-items">
                <button type="button" class="pf-progress-item" data-check="company" data-focus="companyName"><span class="pf-check"></span>Nom de l'entreprise</button>
                <button type="button" class="pf-progress-item" data-check="siren" data-focus="siren"><span class="pf-check"></span>SIREN</button>
                <button type="button" class="pf-progress-item" data-check="description" data-focus="profileDescription"><span class="pf-check"></span>Présentation</button>
                <button type="button" class="pf-progress-item" data-check="depts" data-focus="deptInput"><span class="pf-check"></span>Zones d'intervention</button>
            </div>
        </div>

        {# ═══ 1. Activité ═══ #}
        <div class="pa-section-title"><span class="pa-step">1</span>Votre activité</div>
        <div class="row g-3 mb-4">
            {# ── Entreprise ── #}
            <div class="col-12 col-xl-6">
                <div class="ps-card pa-card" style="--pa-accent: var(--primary-color);">
                    <div class="ps-card-header">
                        <div class="ps-card-icon" style="background: rgba(26,77,69,0.1); color: var(--primary-color);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                        </div>
                        <div>
                            <p class="ps-card-title">Entreprise</p>
                            <p class="ps-card-desc">Raison sociale et identifiant de votre activité.</p>
                            <span class="pa-pill pa-card-pill" id="pillCompany"><span class="dot"></span><span class="txt">—</span></span>
                        </div>
                    </div>

                    <label class="ps-label" for="companyName">Nom de l'entreprise</label>
                    <input type="text" name="company_name" id="companyName" class="form-control form-control-sm" value="{{ user.companyName }}" placeholder="Nom de votre entreprise" autocomplete="organization">

                    <label class="ps-label mt-3" for="siren">SIREN</label>
                    <div class="pf-field-status">
                        <input type="text" name="siren" id="siren" class="form-control form-control-sm" value="{{ user.siren }}" placeholder="123 456 789" maxlength="14" inputmode="numeric" autocomplete="off">
                        <span class="pf-field-icon" id="sirenIcon" aria-hidden="true"></span>
                    </div>
                    <p class="ps-help" id="sirenHelp">9 chiffres, indiqués sur votre avis de situation INSEE.</p>

                    <label class="pa-toggle mt-2" for="showCompany" id="showCompanyRow">
                        <span class="pa-toggle-text">
                            <span class="pa-toggle-title">Afficher le nom de l'entreprise sur mes comptes rendus</span>
                            <span class="pa-toggle-desc" id="showCompanyDesc" hidden>Renseignez d'abord le nom de l'entreprise.</span>
                        </span>
                        <input type="checkbox" class="pa-switch" name="show_company_name" value="1" id="showCompany" {{ user.showCompanyName ? 'checked' : '' }}>
                    </label>
