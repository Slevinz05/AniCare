<script>
document.addEventListener('DOMContentLoaded', function() {
    // ── France Tile Map ──
    // ── Load France SVG map from CDN ──
    (function() {
        var mapEl = document.getElementById('franceMap');
        var mapWrap = document.getElementById('franceMapWrap');
        var tooltip = document.getElementById('mapTooltip');
        if (!mapEl) return;

        fetch('https://cdn.jsdelivr.net/npm/@svg-maps/france.departments@2.0.0/france.departments.svg')
            .then(function(r) { return r.text(); })
            .then(function(svgText) {
                mapEl.innerHTML = svgText;
                var svg = mapEl.querySelector('svg');
                if (!svg) return;
                svg.removeAttribute('width');
                svg.removeAttribute('height');
                svg.style.maxWidth = '100%';
                svg.style.height = 'auto';

                // Click handler
                svg.addEventListener('click', function(e) {
                    var el = e.target;
                    if (el.tagName.toLowerCase() !== 'path' || !el.id) return;
                    var d = el.id;
                    if (typeof window._deptAddDept === 'function' && typeof window._deptRemoveDept === 'function') {
                        if (el.classList.contains('selected')) { window._deptRemoveDept(d); }
                        else { window._deptAddDept(d); }
                    }
                });

                // Tooltip on hover
                svg.addEventListener('mouseover', function(e) {
                    var el = e.target;
                    if (el.tagName.toLowerCase() !== 'path' || !el.id || !tooltip) return;
                    var name = el.getAttribute('aria-label') || el.id;
                    tooltip.textContent = el.id + ' — ' + name;
                    tooltip.classList.add('visible');
                });
                svg.addEventListener('mousemove', function(e) {
                    if (!tooltip) return;
                    var rect = mapWrap.getBoundingClientRect();
                    tooltip.style.left = (e.clientX - rect.left + 12) + 'px';
                    tooltip.style.top = (e.clientY - rect.top - 30) + 'px';
                });
                svg.addEventListener('mouseout', function(e) {
                    var el = e.target;
                    if (el.tagName.toLowerCase() === 'path' && tooltip) tooltip.classList.remove('visible');
                });

                // Trigger initial sync
                if (typeof window._deptUpdateUI === 'function') window._deptUpdateUI();
            })
            .catch(function() {
                mapEl.innerHTML = '<p class="france-map-loading" style="color:#c00;">Impossible de charger la carte. Utilisez la sélection par région ci-dessous.</p>';
            });
    })();

    // ── Region grid toggle ──
    var regionToggle = document.getElementById('regionGridToggle');
    var regionWrap = document.getElementById('regionGridWrap');
    if (regionToggle && regionWrap) {
        regionToggle.addEventListener('click', function() {
            var open = regionWrap.style.display !== 'none';
            regionWrap.style.display = open ? 'none' : 'block';
            regionToggle.classList.toggle('open', !open);
        });
    }

    // ── Hour toggles ──
    document.querySelectorAll('.hour-toggle').forEach(function(cb) {
        cb.addEventListener('change', function() {
            var times = document.querySelector('.hour-times[data-day="' + this.dataset.day + '"]');
            if (times) { times.style.opacity = this.checked ? '1' : '0.35'; times.style.pointerEvents = this.checked ? '' : 'none'; }
        });
    });

    // ── Generic list management ──
    function setupList(listId, addBtnId, dataId, fieldDefs) {
        var list = document.getElementById(listId);
        var addBtn = document.getElementById(addBtnId);
        var dataInput = document.getElementById(dataId);
        if (!list || !addBtn) return;

        function createRow(values) {
            var row = document.createElement('div');
            row.className = 'ps-list-item ' + listId.replace('List', '-row');
            var html = '';
            fieldDefs.forEach(function(f) {
                if (f.type === 'checkbox') {
                    html += '<div class="ps-switch mb-0" style="flex-shrink:0;"><input type="checkbox" class="form-check-input ' + f.cls + '" ' + (values[f.key] ? 'checked' : '') + '><label style="font-size:0.7rem;">' + f.placeholder + '</label></div>';
                } else {
                    html += '<input type="text" class="form-control form-control-sm ' + f.cls + '" value="' + (values[f.key] || '') + '" placeholder="' + f.placeholder + '" style="flex:' + (f.flex || 1) + ';">';
                }
            });
            html += '<button type="button" class="ps-remove-btn ' + listId.replace('List', '-remove') + '"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
            row.innerHTML = html;
            return row;
        }

        addBtn.addEventListener('click', function() {
            var empty = {}; fieldDefs.forEach(function(f) { empty[f.key] = ''; });
            list.appendChild(createRow(empty));
            var firstInput = list.lastElementChild.querySelector('input[type="text"]');
            if (firstInput) firstInput.focus();
        });

        list.addEventListener('click', function(e) {
            var btn = e.target.closest('.ps-remove-btn');
            if (btn) btn.closest('.ps-list-item').remove();
        });

        if (dataInput) {
            dataInput.closest('form').addEventListener('submit', function() {
                var items = [];
                list.querySelectorAll('.ps-list-item').forEach(function(row) {
                    var item = {};
                    fieldDefs.forEach(function(f) {
                        if (f.type === 'checkbox') {
                            item[f.key] = row.querySelector('.' + f.cls).checked;
                        } else {
                            item[f.key] = (row.querySelector('.' + f.cls) || {}).value || '';
                        }
                    });
                    if (fieldDefs.some(function(f) { return f.type !== 'checkbox' && item[f.key]; })) items.push(item);
                });
                dataInput.value = JSON.stringify(items);
            });
        }
    }

    // Profile tab - locations
    setupList('locationsList', 'addLocation', 'locationsData', [
        {key: 'name', cls: 'loc-name', placeholder: 'Ex : Cabinet principal', flex: 1},
        {key: 'address', cls: 'loc-address', placeholder: 'Adresse', flex: 2}
    ]);

    // Departments map + badges
    var deptsList = document.getElementById('deptsList');
    var deptsData = document.getElementById('deptsData');
    var deptInput = document.getElementById('deptInput');
    var addDeptBtn = document.getElementById('addDept');
    var deptsNum = document.getElementById('deptsNum');
    var deptsCount = document.getElementById('deptsCount');

    if (deptsList) {
        function getSelectedDepts() {
            var depts = [];
            deptsList.querySelectorAll('.dept-badge').forEach(function(b) {
                var rm = b.querySelector('.dept-remove');
                if (rm) depts.push(rm.dataset.dept);
            });
            return depts;
        }

        function updateDeptsUI() {
            var depts = getSelectedDepts();
            if (deptsNum) deptsNum.textContent = depts.length;
            if (deptsCount) deptsCount.innerHTML = '<strong>' + depts.length + '</strong> département' + (depts.length > 1 ? 's' : '') + ' sélectionné' + (depts.length > 1 ? 's' : '');
            // Sync region grid buttons
            document.querySelectorAll('.dept-btn').forEach(function(btn) {
                btn.classList.toggle('selected', depts.indexOf(btn.dataset.dept) !== -1);
            });
            // Sync SVG geographic map paths
            document.querySelectorAll('#franceMap svg path[id]').forEach(function(path) {
                path.classList.toggle('selected', depts.indexOf(path.id) !== -1);
            });
            // Update region counts
            document.querySelectorAll('.dept-region').forEach(function(region) {
                var count = region.querySelectorAll('.dept-btn.selected').length;
                var countEl = region.querySelector('.dept-region-count');
                if (countEl) {
                    countEl.textContent = count;
                    countEl.classList.toggle('has-selection', count > 0);
                }
                var total = region.querySelectorAll('.dept-btn').length;
                var header = region.querySelector('.dept-region-header');
                if (header) header.classList.toggle('all-selected', count === total && count > 0);
            });
        }
        // Expose for async SVG map
        window._deptAddDept = addDept;
        window._deptRemoveDept = removeDept;
        window._deptUpdateUI = updateDeptsUI;

        function addDept(d) {
            d = d.trim();
            if (!d || getSelectedDepts().indexOf(d) !== -1) return;
            var span = document.createElement('span');
            span.className = 'badge dept-badge';
            span.innerHTML = d + ' <button type="button" class="btn-close btn-close-sm ms-1 dept-remove" style="font-size:0.5rem;" data-dept="' + d + '"></button>';
            deptsList.appendChild(span);
            updateDeptsUI();
        }

        function removeDept(d) {
            deptsList.querySelectorAll('.dept-badge').forEach(function(b) {
                var rm = b.querySelector('.dept-remove');
                if (rm && rm.dataset.dept === d) b.remove();
            });
            updateDeptsUI();
        }

        // Map button clicks
        document.querySelectorAll('.dept-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var d = this.dataset.dept;
                if (this.classList.contains('selected')) { removeDept(d); }
                else { addDept(d); }
            });
        });

        // Region header click = select/deselect all
        document.querySelectorAll('.dept-region-header').forEach(function(header) {
            header.addEventListener('click', function() {
                var region = this.closest('.dept-region');
                var btns = region.querySelectorAll('.dept-btn');
                var allSelected = region.querySelectorAll('.dept-btn.selected').length === btns.length;
                btns.forEach(function(btn) {
                    if (allSelected) { removeDept(btn.dataset.dept); }
                    else { addDept(btn.dataset.dept); }
                });
            });
        });

        // Badge remove click
        deptsList.addEventListener('click', function(e) {
            if (e.target.classList.contains('dept-remove')) {
                removeDept(e.target.dataset.dept);
            }
        });

        // Manual input
        if (addDeptBtn) {
            addDeptBtn.addEventListener('click', function() {
                var val = deptInput.value.trim();
                if (!val) return;
                val.split(',').forEach(function(d) { addDept(d.trim()); });
                deptInput.value = '';
            });
        }

        // Serialize on submit
        if (deptsData) {
            deptsData.closest('form').addEventListener('submit', function() {
                deptsData.value = JSON.stringify(getSelectedDepts());
            });
        }

        updateDeptsUI();
    }

    // Report tab
    setupList('rehabList', 'addRehab', 'rehabData', [
        {key: 'name', cls: 'rehab-name', placeholder: 'Nom du protocole', flex: 1},
        {key: 'description', cls: 'rehab-desc', placeholder: 'Description', flex: 2},
        {key: 'isDefault', cls: 'rehab-default', placeholder: 'Par défaut', type: 'checkbox'}
    ]);
    setupList('colleaguesList', 'addColleague', 'colleaguesData', [
        {key: 'name', cls: 'col-name', placeholder: 'Nom', flex: 1},
        {key: 'specialty', cls: 'col-specialty', placeholder: 'Métier', flex: 1},
        {key: 'phone', cls: 'col-phone', placeholder: 'Téléphone', flex: 1}
    ]);
    setupList('suppsList', 'addSupp', 'suppsData', [
        {key: 'name', cls: 'supp-name', placeholder: 'Nom', flex: 1},
        {key: 'brand', cls: 'supp-brand', placeholder: 'Marque', flex: 1},
        {key: 'benefit', cls: 'supp-benefit', placeholder: 'Bénéfice', flex: 2}
    ]);
});
</script>
{% endblock %}
