{% extends 'base.html.twig' %}

{% block title %}Ouvrir mon espace particulier - AniCare{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="text-center mb-4">
                <div class="enable-particulier-icon mx-auto mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </div>
                <h1 class="page-title mb-2">Ouvrir mon espace particulier</h1>
                <p class="page-subtitle mb-0">
                    En tant que professionnel, vous pouvez aussi gérer vos propres chevaux.
                    <br>Votre espace particulier sera accessible en un clic depuis le menu.
                </p>
            </div>

            <div class="card form-card">
                <div class="card-body">
                    <form method="post" action="{{ path('app_enable_particulier_space') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('enable_particulier') }}">

                        {# Step 1 — Explanation #}
                        <div class="enable-step mb-4">
                            <div class="enable-step__header">
                                <span class="enable-step__number">1</span>
                                <h2 class="enable-step__title">Ce qui va changer</h2>
                            </div>
                            <ul class="enable-checklist">
                                <li>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--primary-color)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                    Un toggle <strong>PRO / Perso</strong> apparaitra dans votre barre de navigation
                                </li>
                                <li>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--primary-color)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                    En espace particulier, vous verrez vos propres chevaux et consultations
                                </li>
                                <li>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--primary-color)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                    Votre espace professionnel reste inchangé
                                </li>
                            </ul>
                        </div>

                        {# Step 2 — Optional animal creation #}
                        <div class="enable-step mb-4">
                            <div class="enable-step__header">
                                <span class="enable-step__number">2</span>
                                <h2 class="enable-step__title">Enregistrer un premier cheval <span class="enable-step__optional">optionnel</span></h2>
                            </div>
                            <p class="text-muted mb-3" style="font-size: 0.82rem;">
                                Vous pourrez aussi le faire plus tard depuis votre espace particulier.
                            </p>

                            <div class="enable-animal-toggle mb-3">
                                <label class="form-check form-switch d-flex align-items-center gap-2 mb-0">
                                    <input class="form-check-input" type="checkbox" id="toggleAnimalForm" style="cursor: pointer;">
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--secondary-color);">Je souhaite enregistrer un cheval</span>
                                </label>
                            </div>

                            <div id="animalFormFields" style="display: none;">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label for="animal_name" class="form-label">Nom du cheval <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="animal_name" name="animal_name" placeholder="ex: Spirit">
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="animal_species" class="form-label">Espèce</label>
                                        <select class="form-select" id="animal_species" name="animal_species">
                                            <option value="Cheval" selected>Cheval</option>
                                            <option value="Poney">Poney</option>
                                            <option value="Âne">Âne</option>
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="animal_gender" class="form-label">Sexe</label>
                                        <select class="form-select" id="animal_gender" name="animal_gender">
                                            <option value="male">Mâle</option>
                                            <option value="femelle">Femelle</option>
                                            <option value="hongre">Hongre</option>
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="animal_breed" class="form-label">Race</label>
                                        <input type="text" class="form-control" id="animal_breed" name="animal_breed" placeholder="ex: Selle Français">
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="animal_birth_date" class="form-label">Date de naissance</label>
                                        <input type="date" class="form-control" id="animal_birth_date" name="animal_birth_date">
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Actions #}
                        <div class="d-flex flex-column gap-2 mt-4 pt-3" style="border-top: 1px solid var(--border-color);">
                            <button type="submit" class="btn btn-primary btn-lg w-100 d-flex align-items-center justify-content-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                Activer mon espace particulier
                            </button>
                            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary w-100">
                                Annuler
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
.enable-particulier-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--soft-teal);
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
}

.enable-step__header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
}

.enable-step__number {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--primary-color);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.enable-step__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--secondary-color);
    margin: 0;
}

.enable-step__optional {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(0,0,0,0.04);
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
    vertical-align: middle;
    margin-left: 0.3rem;
}

.enable-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
}

.enable-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.4rem 0;
    font-size: 0.85rem;
    color: var(--secondary-color);
    line-height: 1.4;
}

.enable-checklist li svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('toggleAnimalForm');
    const fields = document.getElementById('animalFormFields');
    const nameInput = document.getElementById('animal_name');

    if (toggle && fields) {
        toggle.addEventListener('change', function() {
            fields.style.display = this.checked ? 'block' : 'none';
            if (this.checked && nameInput) {
                nameInput.focus();
            }
            if (!this.checked && nameInput) {
                nameInput.value = '';
            }
        });
    }
});
</script>
{% endblock %}
