{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - AniCare{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row g-4">
        <div class="col-12 col-lg-3">
            {{ include('profile/_sidebar.html.twig') }}
        </div>

        <div class="col-12 col-lg-9">
            <div class="card anicare-card">
                <div class="card-body p-4 p-lg-5">
                    <p class="page-eyebrow mb-2">Compte</p>
                    <h1 class="page-title mb-4">Modifier mon profil</h1>

                    {{ form_start(form, {'attr': {'class': 'anicare-form needs-validation', 'novalidate': 'novalidate'}}) }}

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                {{ form_label(form.firstName, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.firstName) }}
                            </div>

                            <div class="col-12 col-md-6">
                                {{ form_label(form.lastName, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.lastName) }}
                            </div>

                            <div class="col-12 col-md-6">
                                {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.email) }}
                            </div>

                            <div class="col-12 col-md-6">
                                {{ form_label(form.phone, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.phone, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.phone) }}
                            </div>

                            <div class="col-12">
                                {{ form_label(form.address, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.address, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.address) }}
                            </div>

                            <div class="col-12 col-md-6">
                                {{ form_label(form.postalCode, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.postalCode, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.postalCode) }}
                            </div>

                            <div class="col-12 col-md-6">
                                {{ form_label(form.city, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.city, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.city) }}
                            </div>

                            {% if form.specialty is defined %}
                                <div class="col-12 col-md-6">
                                    {{ form_label(form.specialty, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.specialty, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.specialty) }}
                                </div>
                            {% endif %}

                            <div class="col-12">
                                {{ form_label(form.bio, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.bio, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.bio) }}
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    {{ form_widget(form.acceptsNotifications, {'attr': {'class': 'form-check-input'}}) }}
                                    {{ form_label(form.acceptsNotifications, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                </div>
                            </div>
                        </div>

                        {# ── Section PRO ── #}
                        {% if form.profileDescription is defined %}
                            <hr class="my-4" style="border-color: var(--border-color);">
                            <h2 class="h5 fw-bold mb-4" style="color: var(--secondary-color);">Fiche professionnelle</h2>
                            <div class="row g-4">
                                <div class="col-12">
                                    {{ form_label(form.profileDescription, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.profileDescription, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.profileDescription) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_label(form.website, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.website, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.website) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_label(form.experienceYears, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.experienceYears, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.experienceYears) }}
                                </div>


                                {# Photos existantes #}
                                {% set existingPhotos = app.user.profilePhotos ?? [] %}
                                {% if existingPhotos|length > 0 %}
                                    <div class="col-12">
                                        <label class="form-label">Photos actuelles</label>
                                        <div class="d-flex flex-wrap gap-3">
                                            {% for photo in existingPhotos %}
                                                <div class="position-relative" style="width: 120px; height: 120px;">
                                                    <img src="{{ path('app_professional_photo', {id: app.user.id, fileName: photo.fileName}) }}"
                                                         alt="{{ photo.originalName|default('Photo') }}"
                                                         class="rounded-2"
                                                         style="width: 100%; height: 100%; object-fit: cover;">
                                                    <form method="post"
                                                          action="{{ path('app_profile_photo_delete', {fileName: photo.fileName}) }}"
                                                          onsubmit="return confirm('Supprimer cette photo ?');"
                                                          class="position-absolute" style="top: 4px; right: 4px;">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_photo' ~ photo.fileName) }}">
                                                        <button type="submit" class="btn btn-danger btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.7rem;">&times;</button>
                                                    </form>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}

                                <div class="col-12">
                                    <div class="file-upload-card p-3 rounded-3 border border-dashed bg-light">
                                        {{ form_label(form.profilePhotosUpload, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                        {{ form_widget(form.profilePhotosUpload, {'attr': {'class': 'form-control'}}) }}
                                        {% if form.profilePhotosUpload.vars.help %}
                                            <div class="form-text mt-1">{{ form.profilePhotosUpload.vars.help }}</div>
                                        {% endif %}
                                        {{ form_errors(form.profilePhotosUpload) }}
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        {{ form_rest(form) }}

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>
                            <a href="{{ path('app_profile') }}" class="btn btn-outline-primary btn-lg">Annuler</a>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'components/_address_autocomplete.html.twig' with {
    input_id: 'profile_address',
    postal_id: 'profile_postalCode',
    city_id: 'profile_city'
} %}

{# Arrivée depuis « Mon profil » sur un champ précis (ex : #profile_phone) #}
<style>
    .anicare-form [id^="profile_"] { scroll-margin-top: 140px; }
    .anicare-form .field-target { animation: fieldTarget 2s ease; }
    @keyframes fieldTarget {
        0%, 40% { box-shadow: 0 0 0 4px rgba(200,151,62,0.35); border-color: var(--accent-color); }
        100% { box-shadow: none; }
    }
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
    if (!target || !target.closest('.anicare-form')) return;
    target.classList.add('field-target');
    target.focus({ preventScroll: true });
});
</script>
{% endblock %}
