{% extends 'base.html.twig' %}

{% block title %}Mes tournées - AniCare{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .tn-page { max-width: 1140px; margin: 0 auto; }

    .tn-hero {
        background: linear-gradient(135deg, var(--primary-color) 0%, #0a7a70 60%, var(--secondary-color) 100%);
        border-radius: var(--radius-lg);
        padding: 2.2rem 2.5rem;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .tn-hero::before {
        content: '';
        position: absolute; top: -40%; right: -10%; width: 340px; height: 340px;
        background: radial-gradient(circle, rgba(255,255,255,.08) 0%, transparent 70%);
        border-radius: 50%;
    }
    .tn-hero-eyebrow {
        font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
        opacity: .8; margin-bottom: .35rem;
    }
    .tn-hero h1 { font-size: 1.6rem; font-weight: 800; margin: 0 0 .35rem; }
    .tn-hero p { font-size: .92rem; opacity: .85; margin: 0; }
    .tn-btn-white {
        background: #fff; color: var(--primary-color); border: none;
        border-radius: var(--radius-md); font-size: .85rem; font-weight: 600;
        padding: .55rem 1.2rem; display: inline-flex; align-items: center; gap: .4rem;
        text-decoration: none; transition: all .2s;
    }
    .tn-btn-white:hover { background: var(--soft-teal); color: var(--primary-color); }

    .tn-today-card {
        background: linear-gradient(135deg, #fff7ed 0%, #fff 100%);
        border: 2px solid #fed7aa; border-radius: var(--radius-lg);
        padding: 1.5rem; margin-bottom: 1.5rem;
    }
    .tn-today-title {
        font-size: 1rem; font-weight: 700; color: #c2410c;
        display: flex; align-items: center; gap: .5rem; margin-bottom: .75rem;
    }

    .tn-card {
        background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-md);
        padding: 1rem 1.25rem; display: flex; align-items: center; gap: 1rem;
        transition: box-shadow .2s, transform .2s; text-decoration: none; color: inherit;
    }
    .tn-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.06); transform: translateY(-1px); color: inherit; }
    .tn-card-date {
        width: 52px; height: 52px; border-radius: var(--radius-sm);
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        flex-shrink: 0; font-weight: 700;
    }
    .tn-card-date .day { font-size: 1.2rem; line-height: 1; }
    .tn-card-date .month { font-size: .65rem; text-transform: uppercase; letter-spacing: .05em; opacity: .8; }
    .tn-card-info { flex: 1; min-width: 0; }
    .tn-card-name { font-weight: 700; font-size: .95rem; }
    .tn-card-meta { font-size: .82rem; color: #6c757d; }

    .tn-empty {
        text-align: center; padding: 3.5rem 2rem;
        background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
        border: 2px dashed #dee2e6; border-radius: var(--radius-md);
    }
</style>
{% endblock %}

{% block body %}
<div class="tn-page py-4 px-3">

    <div class="tn-hero mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <p class="tn-hero-eyebrow">Organisation terrain</p>
                <h1>Mes tournées</h1>
                <p>Planifiez vos visites de la journée</p>
            </div>
            <a href="{{ path('app_tournee_new') }}" class="tn-btn-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nouvelle tournée
            </a>
        </div>
    </div>

    {# Today's tournee highlight #}
    {% if today %}
    <div class="tn-today-card">
        <div class="tn-today-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Tournée du jour
        </div>
        <a href="{{ path('app_tournee_show', {id: today.id}) }}" class="tn-card" style="border-color: #fed7aa;">
            <div class="tn-card-date" style="background: #fff7ed; color: #c2410c;">
                <span class="day">{{ today.date|date('d') }}</span>
                <span class="month">{{ today.date|date('M') }}</span>
            </div>
            <div class="tn-card-info">
                <div class="tn-card-name">{{ today.displayName }}</div>
                <div class="tn-card-meta">
                    {{ today.stops|length }} étape{{ today.stops|length > 1 ? 's' : '' }}
                    {% if today.totalTravelTime > 0 %}
                        · {{ today.totalTravelTime }} min de trajet
                    {% endif %}
                </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="#c2410c" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
    </div>
    {% endif %}

    {# All tournees #}
    {% set others = tournees|filter(t => not t.isToday) %}
    {% if others is empty and today is null %}
        <div class="tn-empty">
            <div class="mb-3" style="width: 56px; height: 56px; border-radius: 50%; background: var(--soft-teal); display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="var(--primary-color)" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="10" r="3"/><path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"/></svg>
            </div>
            <h2 style="font-size: 1.1rem; font-weight: 700; color: #333; margin-bottom: .3rem;">Aucune tournée</h2>
            <p class="text-secondary" style="font-size: .9rem; margin-bottom: 1rem;">Créez votre première tournée pour organiser vos visites.</p>
            <a href="{{ path('app_tournee_new') }}" class="btn" style="background: var(--primary-color); color: #fff; border-radius: var(--radius-md); font-weight: 600; font-size: .85rem; padding: .5rem 1.2rem;">
                Planifier une tournée
            </a>
        </div>
    {% elseif others is not empty %}
        <h2 style="font-size: 1rem; font-weight: 700; color: #374151; margin-bottom: .75rem;">
            {% if today %}Autres tournées{% else %}Toutes les tournées{% endif %}
        </h2>
        <div class="d-flex flex-column gap-2">
            {% for tournee in others %}
                <a href="{{ path('app_tournee_show', {id: tournee.id}) }}" class="tn-card">
                    <div class="tn-card-date" style="background: var(--soft-teal); color: var(--primary-color);">
                        <span class="day">{{ tournee.date|date('d') }}</span>
                        <span class="month">{{ tournee.date|date('M') }}</span>
                    </div>
                    <div class="tn-card-info">
                        <div class="tn-card-name">{{ tournee.displayName }}</div>
                        <div class="tn-card-meta">
                            {{ tournee.stops|length }} étape{{ tournee.stops|length > 1 ? 's' : '' }}
                            {% if tournee.totalTravelTime > 0 %}
                                · {{ tournee.totalTravelTime }} min de trajet
                            {% endif %}
                        </div>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="#6c757d" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
