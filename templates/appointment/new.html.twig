{% extends 'base.html.twig' %}
{% block title %}Nouveau rendez-vous - AniCare{% endblock %}
{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card anicare-card">
                <div class="card-header medical-header p-4">
                    <p class="page-eyebrow mb-2">Organisation</p>
                    <h1 class="page-title mb-0">Prendre rendez-vous</h1>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'class': 'anicare-form'}}) }}
                        <div class="row g-4">
                            <div class="col-12">{{ form_row(form.animal, {'attr': {'class': 'form-select'}}) }}</div>
                            <div class="col-12">{{ form_row(form.reason, {'attr': {'class': 'form-control'}}) }}</div>
                            <div class="col-12 col-md-6">{{ form_row(form.scheduledAt, {'attr': {'class': 'form-control'}}) }}</div>
                            <div class="col-12 col-md-6">{{ form_row(form.location, {'attr': {'class': 'form-control'}}) }}</div>
                            <div class="col-12">{{ form_row(form.notes, {'attr': {'class': 'form-control'}}) }}</div>
                        </div>
                        {{ form_rest(form) }}
                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Confirmer le rendez-vous</button>
                    {{ form_end(form) }}
                </div>
            </div>
            <a href="{{ path('app_appointment_index') }}" class="btn btn-outline-primary mt-3">Retour</a>
        </div>
    </div>
</div>
{% endblock %}
