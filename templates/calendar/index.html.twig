{# templates/calendar/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Agenda - AniCare{% endblock %}

{% block body %}
<style>
    .calendar-container {
        width: 100%;
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-subtle);
    }

    .calendar-weekdays-grid {
        display: grid !important;
        grid-template-columns: repeat(7, 1fr) !important;
        background-color: var(--bg-color);
        border-bottom: 1px solid var(--border-color);
        text-align: center;
        font-weight: 700;
        color: var(--taupe);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
    }

    .calendar-weekdays-grid div {
        padding: 12px 0;
    }

    .calendar-days-grid {
        display: grid !important;
        grid-template-columns: repeat(7, 1fr) !important;
        background-color: var(--border-color);
        gap: 1px;
    }

    .calendar-day-box {
        background-color: #ffffff;
        padding: 8px;
        min-height: 110px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .calendar-day-box:hover:not(.day-box-empty) {
        background-color: var(--bg-color);
    }

    .day-box-empty {
        background-color: var(--bg-color) !important;
        opacity: 0.5;
    }

    .current-today-box {
        background-color: rgba(13, 148, 136, 0.05) !important;
        box-shadow: inset 0 0 0 2px var(--primary-color);
    }

    .event-badge {
        display: block;
        font-size: 0.7rem;
        padding: 3px 6px;
        margin-top: 3px;
        border-radius: 4px;
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 600;
        transition: all 0.1s ease;
        line-height: 1.3;
    }

    .event-consultation {
        background-color: rgba(13, 148, 136, 0.1);
        color: #0f766e;
        border-left: 3px solid #0d9488;
    }

    .event-consultation:hover {
        background-color: rgba(13, 148, 136, 0.2);
        color: #0d9488;
    }

    .event-appointment {
        background-color: var(--soft-warm);
        color: var(--accent-hover);
        border-left: 3px solid var(--accent-color);
    }

    .event-appointment:hover {
        background-color: #FFE8A8;
        color: var(--accent-hover);
    }

    .event-cancelled {
        opacity: 0.5;
        text-decoration: line-through;
    }

    .calendar-day-box:hover .add-action-indicator {
        background-color: var(--primary-color) !important;
        color: #ffffff !important;
    }

    .view-switcher .btn {
        min-width: 44px;
    }
    .view-switcher .btn.active-view {
        background-color: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        color: #ffffff !important;
    }

    /* Week view */
    .week-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 1px;
        background-color: var(--border-color);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

    .week-day-col {
        background: #ffffff;
        min-height: 300px;
        padding: 12px;
    }

    .week-day-col.is-today {
        background: rgba(13, 148, 136, 0.04);
    }

    .week-day-header {
        text-align: center;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--border-color);
    }

    .week-day-header .day-name {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--taupe);
    }

    .week-day-header .day-num {
        display: block;
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--secondary-color);
    }

    .week-day-col.is-today .week-day-header .day-num {
        color: var(--primary-color);
    }

    .week-day-col.is-today .week-day-header {
        border-bottom-color: var(--primary-color);
    }

    /* Day view */
    .day-event-card {
        padding: 16px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background: #ffffff;
        margin-bottom: 12px;
        transition: all 0.15s ease;
    }

    .day-event-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .day-event-card.type-consultation {
        border-left: 4px solid var(--primary-color);
    }

    .day-event-card.type-appointment {
        border-left: 4px solid var(--accent-color);
    }
</style>

<div class="container py-4">
    {# ── Header ── #}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <p class="page-eyebrow mb-1" style="color: var(--primary-color);">Agenda</p>
            <h1 class="page-title m-0">Planning & Activités</h1>
        </div>

        <div class="d-flex gap-3 align-items-center flex-wrap">
            {# View switcher #}
            <div class="view-switcher btn-group" role="group">
                <a href="{{ path('app_calendar', {view: 'day', day: currentDay, month: currentMonth, year: currentYear}) }}"
                   class="btn btn-outline-secondary btn-sm {{ view == 'day' ? 'active-view' : '' }}">Jour</a>
                <a href="{{ path('app_calendar', {view: 'week', day: currentDay, month: currentMonth, year: currentYear}) }}"
                   class="btn btn-outline-secondary btn-sm {{ view == 'week' ? 'active-view' : '' }}">Semaine</a>
                <a href="{{ path('app_calendar', {view: 'month', month: currentMonth, year: currentYear}) }}"
                   class="btn btn-outline-secondary btn-sm {{ view == 'month' ? 'active-view' : '' }}">Mois</a>
            </div>

            {# Navigation #}
            <div class="d-flex gap-2 align-items-center bg-white p-2 rounded-3 border" style="border-color: var(--border-color) !important;">
                {% if view == 'month' %}
                    <a href="{{ path('app_calendar', {view: 'month', month: prevMonth, year: prevYear}) }}" class="btn btn-outline-secondary btn-sm px-2">◀</a>
                    <span class="fw-bold px-3 text-uppercase" style="min-width: 165px; text-align: center; color: var(--secondary-color);">
                        {{ currentMonthName }} {{ currentYear }}
                    </span>
                    <a href="{{ path('app_calendar', {view: 'month', month: nextMonth, year: nextYear}) }}" class="btn btn-outline-secondary btn-sm px-2">▶</a>
                {% elseif view == 'week' %}
                    <a href="{{ path('app_calendar', {view: 'week', day: prevWeek|date('j'), month: prevWeek|date('n'), year: prevWeek|date('Y')}) }}" class="btn btn-outline-secondary btn-sm px-2">◀</a>
                    <span class="fw-bold px-3" style="min-width: 200px; text-align: center; color: var(--secondary-color);">
                        {{ monday|date('d') }} — {{ sunday|date('d') }} {{ currentMonthName }} {{ currentYear }}
                    </span>
                    <a href="{{ path('app_calendar', {view: 'week', day: nextWeek|date('j'), month: nextWeek|date('n'), year: nextWeek|date('Y')}) }}" class="btn btn-outline-secondary btn-sm px-2">▶</a>
                {% else %}
                    <a href="{{ path('app_calendar', {view: 'day', day: prevDay|date('j'), month: prevDay|date('n'), year: prevDay|date('Y')}) }}" class="btn btn-outline-secondary btn-sm px-2">◀</a>
                    <span class="fw-bold px-3" style="min-width: 220px; text-align: center; color: var(--secondary-color);">
                        {{ dayName }} {{ currentDay }} {{ currentMonthName }} {{ currentYear }}
                    </span>
                    <a href="{{ path('app_calendar', {view: 'day', day: nextDay|date('j'), month: nextDay|date('n'), year: nextDay|date('Y')}) }}" class="btn btn-outline-secondary btn-sm px-2">▶</a>
                {% endif %}
            </div>

            <a href="{{ path('app_calendar', {view: view, day: 'now'|date('j'), month: 'now'|date('n'), year: 'now'|date('Y')}) }}" class="btn btn-primary btn-sm">Aujourd'hui</a>
        </div>
    </div>

    {# ── Légende ── #}
    <div class="d-flex gap-4 mb-3">
        <span class="d-flex align-items-center gap-2 small" style="color: var(--taupe);">
            <span style="width:14px; height:14px; border-radius:3px; background: rgba(13,148,136,0.15); border-left: 3px solid #0d9488; display:inline-block;"></span>
            Consultation
        </span>
        <span class="d-flex align-items-center gap-2 small" style="color: var(--taupe);">
            <span style="width:14px; height:14px; border-radius:3px; background: var(--soft-warm); border-left: 3px solid var(--accent-color); display:inline-block;"></span>
            Rendez-vous
        </span>
    </div>

    {# ══════════════════════════════════════
       VUE MENSUELLE
       ══════════════════════════════════════ #}
    {% if view == 'month' %}
        <div class="calendar-container">
            <div class="calendar-weekdays-grid">
                <div>Lun</div><div>Mar</div><div>Mer</div><div>Jeu</div><div>Ven</div><div>Sam</div><div>Dim</div>
            </div>

            <div class="calendar-days-grid">
                {% if startOfWeekDay > 1 %}
                    {% for i in 1..(startOfWeekDay - 1) %}
                        <div class="calendar-day-box day-box-empty"></div>
                    {% endfor %}
                {% endif %}

                {% for day in 1..daysInMonth %}
                    {% set isToday = (day == 'now'|date('j')|number_format and currentMonth == 'now'|date('n')|number_format and currentYear == 'now'|date('Y')|number_format) %}
                    {% set targetDate = currentYear ~ '-' ~ (currentMonth < 10 ? '0' ~ currentMonth : currentMonth) ~ '-' ~ (day < 10 ? '0' ~ day : day) %}

                    <a href="{{ path('app_calendar', {view: 'day', day: day, month: currentMonth, year: currentYear}) }}"
                       class="calendar-day-box text-decoration-none text-dark position-relative {{ isToday ? 'current-today-box' : '' }}" style="cursor: pointer;">

                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small {{ isToday ? 'text-teal fs-6' : '' }}" style="{{ not isToday ? 'color: var(--secondary-color);' : '' }}">
                                {{ day }}
                            </span>
                            <span class="add-action-indicator rounded-circle d-flex align-items-center justify-content-center"
                                  style="width: 16px; height: 16px; font-size: 0.65rem; background-color: var(--bg-color); color: var(--taupe); font-weight: bold;">+</span>
                        </div>

                        <div class="day-events-list" onclick="event.stopPropagation();">
                            {% if eventsByDay[day] is defined %}
                                {% for event in eventsByDay[day] %}
                                    <span class="event-badge event-{{ event.type }} {{ event.status == 'CANCELLED' ? 'event-cancelled' : '' }}"
                                          title="{{ event.animal }} — {{ event.title }}{% if event.professional %} (Dr. {{ event.professional }}){% endif %}">
                                        {{ event.animal }} · {{ event.title }}
                                    </span>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>

    {# ══════════════════════════════════════
       VUE HEBDOMADAIRE
       ══════════════════════════════════════ #}
    {% elseif view == 'week' %}
        <div class="week-grid">
            {% for wd in weekDays %}
                <div class="week-day-col {{ wd.isToday ? 'is-today' : '' }}">
                    <div class="week-day-header">
                        <span class="day-name">{{ wd.dayName }}</span>
                        <span class="day-num">{{ wd.dayNum }}</span>
                    </div>

                    {% for event in wd.events %}
                        <a href="{{ path(event.link, {id: event.id}) }}"
                           class="event-badge event-{{ event.type }} {{ event.status == 'CANCELLED' ? 'event-cancelled' : '' }} mb-2 d-block text-decoration-none"
                           style="white-space: normal; font-size: 0.75rem;">
                            <strong>{{ event.animal }}</strong><br>
                            {{ event.title }}
                            {% if event.professional %}
                                <br><span style="opacity: 0.75;">Dr. {{ event.professional }}</span>
                            {% endif %}
                        </a>
                    {% endfor %}

                    {% if wd.events is empty %}
                        <p class="text-center small mt-4" style="color: var(--taupe); opacity: 0.5;">—</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

    {# ══════════════════════════════════════
       VUE JOURNALIÈRE
       ══════════════════════════════════════ #}
    {% elseif view == 'day' %}
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                {% if events is empty %}
                    <div class="text-center py-5">
                        <div class="mb-3" style="font-size: 3rem; opacity: 0.3;">📅</div>
                        <p style="color: var(--taupe);">Aucun événement prévu ce jour.</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <a href="{{ path('app_health_book_entry_new', {preset_date: currentDate|date('Y-m-d')}) }}" class="btn btn-primary btn-sm">Ajouter une consultation</a>
                            <a href="{{ path('app_appointment_new') }}" class="btn btn-outline-info btn-sm">Prendre rendez-vous</a>
                        </div>
                    </div>
                {% else %}
                    {% for event in events %}
                        <a href="{{ path(event.link, {id: event.id}) }}" class="day-event-card d-block text-decoration-none type-{{ event.type }}">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge mb-2 {{ event.type == 'consultation' ? 'badge-vaccin' : '' }}"
                                          style="{{ event.type == 'appointment' ? 'background-color: var(--soft-warm); color: var(--accent-hover);' : '' }}">
                                        {{ event.type == 'consultation' ? 'Consultation' : 'Rendez-vous' }}
                                    </span>
                                    {% if event.status == 'CANCELLED' %}
                                        <span class="badge bg-danger ms-1">Annulé</span>
                                    {% elseif event.status == 'CONFIRMED' %}
                                        <span class="badge bg-success ms-1">Confirmé</span>
                                    {% elseif event.status == 'PENDING' %}
                                        <span class="badge bg-warning text-dark ms-1">En attente</span>
                                    {% endif %}

                                    <h3 class="h6 fw-bold mb-1" style="color: var(--secondary-color);">{{ event.title }}</h3>
                                    <p class="mb-0 small" style="color: var(--taupe);">
                                        🐴 {{ event.animal }}
                                        {% if event.professional %}
                                            · Dr. {{ event.professional }}
                                        {% endif %}
                                    </p>
                                </div>
                                <span class="small fw-bold" style="color: var(--taupe);">
                                    {{ event.date|date('H:i') != '00:00' ? event.date|date('H:i') : 'Journée' }}
                                </span>
                            </div>
                        </a>
                    {% endfor %}

                    <div class="d-flex gap-2 mt-4">
                        <a href="{{ path('app_health_book_entry_new', {preset_date: currentDate|date('Y-m-d')}) }}" class="btn btn-primary btn-sm">Ajouter une consultation</a>
                        <a href="{{ path('app_appointment_new') }}" class="btn btn-outline-info btn-sm">Prendre rendez-vous</a>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
