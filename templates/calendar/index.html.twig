{# templates/calendar/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Agenda - AniCare{% endblock %}

{% block body %}
<style>
    /* ========== LAYOUT ========== */
    .agenda-layout { display: grid; grid-template-columns: 1fr 260px; gap: 20px; align-items: start; }
    .agenda-main { min-width: 0; overflow: hidden; }
    .agenda-sidebar { display: flex; flex-direction: column; gap: 16px; }

    @media (max-width: 960px) {
        .agenda-layout { grid-template-columns: 1fr; }
        .agenda-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    }
    @media (max-width: 580px) {
        .agenda-sidebar { grid-template-columns: 1fr; }
    }

    /* ========== SIDEBAR CARDS ========== */
    .sidebar-card {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(26,77,69,0.05);
    }
    .sidebar-card-header {
        padding: 14px 16px 10px;
        font-weight: 800;
        font-size: 0.82rem;
        color: var(--secondary-color);
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid rgba(26,77,69,0.06);
        background: linear-gradient(135deg, #f9fcfb 0%, var(--soft-teal) 100%);
    }
    .sidebar-card-header svg { flex-shrink: 0; }
    .sidebar-card-body { padding: 12px 16px 16px; }

    /* Notification items */
    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid rgba(26,77,69,0.05);
        text-decoration: none;
        color: inherit;
        transition: background 0.15s;
        border-radius: 6px;
        margin: 0 -4px;
        padding-left: 4px;
        padding-right: 4px;
    }
    .notif-item:last-child { border-bottom: none; }
    .notif-item:hover { background: var(--soft-teal); }
    .notif-dot {
        width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 5px;
    }
    .notif-dot--teal { background: var(--primary-color); }
    .notif-dot--gold { background: var(--accent-color); }
    .notif-dot--warning { background: var(--warning-color); }
    .notif-text { font-size: 0.78rem; color: var(--secondary-color); line-height: 1.35; }
    .notif-text strong { font-weight: 700; }
    .notif-time { font-size: 0.68rem; color: var(--taupe); margin-top: 1px; }
    .notif-empty { font-size: 0.8rem; color: var(--taupe); text-align: center; padding: 16px 0; }

    /* Mini calendar */
    .mini-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; gap: 0; }
    .mini-cal-header { font-size: 0.65rem; font-weight: 700; color: var(--taupe); text-transform: uppercase; padding: 4px 0; }
    .mini-cal-day {
        font-size: 0.72rem; padding: 4px 0; border-radius: 50%; cursor: pointer;
        transition: all 0.12s; color: var(--secondary-color); font-weight: 500;
        display: flex; align-items: center; justify-content: center;
        width: 28px; height: 28px; margin: 0 auto;
    }
    .mini-cal-day:hover { background: var(--soft-teal); }
    .mini-cal-day.is-today { background: var(--primary-color); color: #fff; font-weight: 800; }
    .mini-cal-day.is-empty { visibility: hidden; }
    .mini-cal-nav {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0 0 8px; font-size: 0.78rem; font-weight: 700; color: var(--secondary-color);
    }
    .mini-cal-nav a {
        color: var(--primary-color); text-decoration: none; font-size: 0.85rem;
        width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;
        border-radius: 50%; transition: background 0.15s;
    }
    .mini-cal-nav a:hover { background: var(--soft-teal); }

    /* ========== TODAY BAND ========== */
    .today-band {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 16px 20px;
        box-shadow: 0 2px 10px rgba(26,77,69,0.05);
    }
    .today-band-title {
        font-weight: 800; font-size: 0.85rem; color: var(--secondary-color);
        margin-bottom: 12px;
        display: flex; align-items: center; gap: 8px;
    }
    .today-band-title .badge-count {
        background: var(--primary-color); color: #fff;
        font-size: 0.65rem; font-weight: 800;
        padding: 2px 8px; border-radius: 10px;
    }
    .today-events-scroll {
        display: flex; gap: 12px; overflow-x: auto; padding-bottom: 4px;
    }
    .today-events-scroll::-webkit-scrollbar { height: 4px; }
    .today-events-scroll::-webkit-scrollbar-thumb { background: rgba(26,77,69,0.15); border-radius: 4px; }

    .today-event-card {
        flex: 0 0 220px;
        border-radius: 10px;
        padding: 12px 14px;
        text-decoration: none;
        color: inherit;
        transition: all 0.15s;
        border-left: 4px solid transparent;
        position: relative;
    }
    .today-event-card:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0,0,0,0.1); }
    .today-event-card.type-consultation {
        background: rgba(26,77,69,0.06); border-left-color: var(--primary-color);
    }
    .today-event-card.type-appointment {
        background: rgba(200,151,62,0.08); border-left-color: var(--accent-color);
    }
    .today-event-card.type-reminder {
        background: rgba(229,166,62,0.08); border-left-color: var(--warning-color);
    }
    .today-event-card .tec-time {
        font-size: 0.7rem; font-weight: 800; color: var(--taupe); margin-bottom: 4px;
    }
    .today-event-card .tec-animal {
        font-size: 0.82rem; font-weight: 700; color: var(--secondary-color);
    }
    .today-event-card .tec-title {
        font-size: 0.72rem; color: var(--taupe); margin-top: 2px;
    }
    .today-event-card .tec-client {
        font-size: 0.68rem; color: var(--primary-color); font-weight: 600; margin-top: 4px;
    }
    .today-empty {
        font-size: 0.82rem; color: var(--taupe); padding: 8px 0;
    }
    .day-number {
        display: inline-flex; align-items: center; justify-content: center;
        width: 24px; height: 24px; border-radius: 50%;
        font-size: 0.75rem; font-weight: 600; color: var(--secondary-color);
        transition: background-color 0.15s, color 0.15s;
    }
    .day-number--today {
        background-color: var(--primary-color); color: #fff;
    }
    .calendar-day-box.selected-day-box .day-number:not(.day-number--today) {
        background-color: rgba(200, 151, 62, 0.15); color: var(--accent-color);
    }
    .calendar-day-box.selected-day-box {
        background-color: transparent !important;
    }
    .day-add-btn:hover { background-color: var(--soft-teal) !important; color: var(--primary-color) !important; }

    /* ========== CALENDAR ========== */
    .calendar-container {
        width: 100%;
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-subtle);
    }

    .calendar-weekdays-grid {
        display: grid !important;
        grid-template-columns: repeat(7, 1fr) !important;
        background-color: var(--bg-color);
        border-bottom: 1px solid var(--border-color);
        text-align: center;
        font-weight: 700;
        color: var(--taupe);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
    }
    .calendar-weekdays-grid div { padding: 12px 0; }

    .calendar-days-grid {
        display: grid !important;
        grid-template-columns: repeat(7, 1fr) !important;
        background-color: var(--border-color);
        gap: 1px;
    }
    .calendar-day-box {
        background-color: #ffffff;
        padding: 6px;
        min-height: 80px;
        min-width: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        cursor: pointer;
        transition: background-color 0.1s;
    }
    .calendar-day-box:hover:not(.day-box-empty) { background-color: var(--bg-color); }
    .day-box-empty { background-color: var(--bg-color) !important; opacity: 0.5; cursor: default; }
    .current-today-box { background-color: rgba(26, 77, 69, 0.03) !important; }

    .event-badge {
        display: flex;
        flex-direction: column;
        font-size: 0.65rem;
        padding: 3px 6px;
        margin-top: 2px;
        border-radius: 4px;
        text-decoration: none;
        overflow: hidden;
        font-weight: 600;
        transition: all 0.1s ease;
        line-height: 1.25;
    }
    .event-badge .ev-time { font-size: 0.6rem; font-weight: 700; opacity: 0.85; }
    .event-badge .ev-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .event-consultation { background-color: rgba(26, 77, 69, 0.1); color: #153d37; border-left: 3px solid #1a4d45; }
    .event-consultation:hover { background-color: rgba(26, 77, 69, 0.2); color: #1a4d45; }
    .event-appointment { background-color: var(--soft-warm); color: var(--accent-hover); border-left: 3px solid var(--accent-color); }
    .event-appointment:hover { background-color: #FFE8A8; color: var(--accent-hover); }
    .event-reminder { background-color: rgba(229, 166, 62, 0.12); color: #92600a; border-left: 3px solid var(--warning-color); }
    .event-reminder:hover { background-color: rgba(229, 166, 62, 0.22); color: #7a5008; }
    .event-cancelled { opacity: 0.5; text-decoration: line-through; }

    #calTooltip {
        display: none;
        position: fixed;
        background: var(--secondary-color);
        color: #fff;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        line-height: 1.4;
        white-space: nowrap;
        z-index: 9999;
        box-shadow: 0 4px 14px rgba(0,0,0,0.25);
        pointer-events: none;
    }
    #calTooltip .tt-client { font-weight: 700; }
    #calTooltip .tt-location { opacity: 0.8; font-size: 0.68rem; }

    .view-switcher .btn { min-width: 44px; }
    .view-switcher .btn.active-view {
        background-color: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        color: #ffffff !important;
    }

    /* ========== TIME GRID ========== */
    .time-grid {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-subtle);
    }
    .time-grid-header { display: grid; background-color: var(--bg-color); border-bottom: 1px solid var(--border-color); }
    .time-grid-header-cell { text-align: center; padding: 10px 4px; border-left: 1px solid var(--border-color); }
    .time-grid-header-cell:first-child { border-left: none; }
    .time-grid-header-cell .header-day-name { display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--taupe); }
    .time-grid-header-cell .header-day-num { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; font-size: 1.1rem; font-weight: 800; color: var(--secondary-color); border-radius: 50%; }
    .time-grid-header-cell.is-today .header-day-num { background-color: var(--primary-color); color: #ffffff; }

    .time-grid-body { display: grid; position: relative; }
    .time-label { padding: 0 8px; font-size: 0.7rem; font-weight: 600; color: var(--taupe); text-align: right; position: relative; height: 48px; border-bottom: 1px solid var(--border-color); display: flex; align-items: flex-start; justify-content: flex-end; }
    .time-label span { transform: translateY(-8px); }

    .time-col {
        position: relative;
        border-left: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
        height: 48px;
        cursor: pointer;
        transition: background-color 0.1s;
    }
    .time-col:hover { background-color: rgba(26, 77, 69, 0.06); }
    .time-col.is-today-col { background-color: rgba(26, 77, 69, 0.03); }

    .time-event {
        position: absolute;
        left: 2px; right: 2px;
        border-radius: 4px;
        padding: 3px 6px;
        font-size: 0.7rem;
        font-weight: 600;
        line-height: 1.3;
        overflow: hidden;
        text-decoration: none;
        z-index: 2;
        min-height: 22px;
        transition: box-shadow 0.15s ease;
        cursor: pointer;
    }
    .time-event:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.18); z-index: 3; }
    .time-event.type-consultation { background-color: rgba(26, 77, 69, 0.15); border-left: 3px solid #1a4d45; color: #153d37; }
    .time-event.type-appointment { background-color: var(--soft-warm); border-left: 3px solid var(--accent-color); color: var(--accent-hover); }
    .time-event.type-reminder { background-color: rgba(229, 166, 62, 0.12); border-left: 3px solid var(--warning-color); color: #92600a; }
    .time-event .event-time { font-size: 0.65rem; opacity: 0.8; }
    .time-event .event-title { font-weight: 700; }

    .time-now-line { position: absolute; left: 0; right: 0; height: 2px; background-color: #dc3545; z-index: 5; pointer-events: none; }
    .time-now-line::before { content: ''; position: absolute; left: -5px; top: -4px; width: 10px; height: 10px; border-radius: 50%; background-color: #dc3545; }

    .allday-bar { border-bottom: 1px solid var(--border-color); display: grid; min-height: 32px; }
    .allday-cell { border-left: 1px solid var(--border-color); padding: 2px 4px; }
    .allday-cell:first-child { border-left: none; }
    .allday-label { font-size: 0.65rem; font-weight: 600; color: var(--taupe); padding: 0 8px; display: flex; align-items: center; }

    .day-time-grid .time-grid-header { grid-template-columns: 56px 1fr; }
    .day-time-grid .time-grid-body { grid-template-columns: 56px 1fr; }
    .day-time-grid .allday-bar { grid-template-columns: 56px 1fr; }

    .week-time-grid .time-grid-header { grid-template-columns: 56px repeat(7, 1fr); }
    .week-time-grid .time-grid-body { grid-template-columns: 56px repeat(7, 1fr); }
    .week-time-grid .allday-bar { grid-template-columns: 56px repeat(7, 1fr); }

    .scroll-time-grid { max-height: 720px; overflow-y: auto; }

    /* ========== ADD EVENT BUTTON ========== */
    .add-event-btn {
        width: 44px; height: 44px; border-radius: 50%;
        background: var(--accent-color); color: #fff; border: none;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        box-shadow: 0 3px 12px rgba(200,151,62,0.4);
        transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
        margin-left: 6px;
    }
    .add-event-btn:hover { transform: scale(1.08); box-shadow: 0 5px 18px rgba(200,151,62,0.5); background: var(--accent-hover); }
    .add-event-btn.open svg { transform: rotate(45deg); transition: transform 0.2s; }
    .add-event-dropdown {
        display: none; position: absolute; right: 0; top: calc(100% + 8px);
        background: #fff; border: 1px solid var(--border-color);
        border-radius: 12px; box-shadow: 0 8px 28px rgba(0,0,0,0.15);
        min-width: 220px; z-index: 200; overflow: hidden;
    }
    .add-event-dropdown.show { display: block; }
    .add-event-option {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; text-decoration: none;
        color: var(--secondary-color); font-size: 0.85rem; font-weight: 600;
        transition: background 0.12s;
    }
    .add-event-option:hover { background: var(--soft-teal); color: var(--primary-color); }
    .add-event-option + .add-event-option { border-top: 1px solid rgba(26,77,69,0.06); }
    .add-event-icon {
        width: 30px; height: 30px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        color: #fff; flex-shrink: 0;
    }
</style>

<div class="container py-4">
    {# ── Header + contrôles sur une ligne ── #}
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <p class="page-eyebrow mb-1" style="color: var(--primary-color);">Agenda</p>
            <h1 class="page-title m-0">Planning & Activités</h1>
        </div>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <div class="view-switcher btn-group" role="group">
                <a href="{{ path('app_calendar', {view: 'day', day: currentDay, month: currentMonth, year: currentYear}) }}"
                   class="btn btn-outline-secondary btn-sm {{ view == 'day' ? 'active-view' : '' }}">Jour</a>
                <a href="{{ path('app_calendar', {view: 'week', day: currentDay, month: currentMonth, year: currentYear}) }}"
                   class="btn btn-outline-secondary btn-sm {{ view == 'week' ? 'active-view' : '' }}">Semaine</a>
                <a href="{{ path('app_calendar', {view: 'month', month: currentMonth, year: currentYear}) }}"
                   class="btn btn-outline-secondary btn-sm {{ view == 'month' ? 'active-view' : '' }}">Mois</a>
            </div>

            <div class="d-flex gap-2 align-items-center bg-white p-2 rounded-3 border" style="border-color: var(--border-color) !important;">
                {% if view == 'month' %}
                    <a href="{{ path('app_calendar', {view: 'month', month: prevMonth, year: prevYear}) }}" class="btn btn-outline-secondary btn-sm px-2">&#9664;</a>
                    <span class="fw-bold px-3 text-uppercase" style="min-width: 140px; text-align: center; color: var(--secondary-color); font-size: 0.82rem;">
                        {{ currentMonthName }} {{ currentYear }}
                    </span>
                    <a href="{{ path('app_calendar', {view: 'month', month: nextMonth, year: nextYear}) }}" class="btn btn-outline-secondary btn-sm px-2">&#9654;</a>
                {% elseif view == 'week' %}
                    <a href="{{ path('app_calendar', {view: 'week', day: prevWeek|date('j'), month: prevWeek|date('n'), year: prevWeek|date('Y')}) }}" class="btn btn-outline-secondary btn-sm px-2">&#9664;</a>
                    <span class="fw-bold px-3" style="min-width: 160px; text-align: center; color: var(--secondary-color); font-size: 0.82rem;">
                        {{ monday|date('d') }} — {{ sunday|date('d') }} {{ currentMonthName }} {{ currentYear }}
                    </span>
                    <a href="{{ path('app_calendar', {view: 'week', day: nextWeek|date('j'), month: nextWeek|date('n'), year: nextWeek|date('Y')}) }}" class="btn btn-outline-secondary btn-sm px-2">&#9654;</a>
                {% else %}
                    <a href="{{ path('app_calendar', {view: 'day', day: prevDay|date('j'), month: prevDay|date('n'), year: prevDay|date('Y')}) }}" class="btn btn-outline-secondary btn-sm px-2">&#9664;</a>
                    <span class="fw-bold px-3" style="min-width: 160px; text-align: center; color: var(--secondary-color); font-size: 0.82rem;">
                        {{ dayName }} {{ currentDay }} {{ currentMonthName }} {{ currentYear }}
                    </span>
                    <a href="{{ path('app_calendar', {view: 'day', day: nextDay|date('j'), month: nextDay|date('n'), year: nextDay|date('Y')}) }}" class="btn btn-outline-secondary btn-sm px-2">&#9654;</a>
                {% endif %}
            </div>

            <a href="{{ path('app_calendar', {view: view, day: 'now'|date('j'), month: 'now'|date('n'), year: 'now'|date('Y')}) }}" class="btn btn-primary btn-sm" style="white-space: nowrap;">Aujourd'hui</a>

            <a href="{{ path('app_appointment_index') }}" class="btn btn-sm d-inline-flex align-items-center gap-2" style="background: var(--primary-color); color: #fff; font-weight: 600; padding: 8px 18px; border-radius: 8px; box-shadow: 0 2px 8px rgba(26,77,69,0.25); white-space: nowrap;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Tous mes rendez-vous
            </a>

            <div class="position-relative">
                <button class="add-event-btn" id="addEventBtn" aria-label="Ajouter" title="Ajouter">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <div class="add-event-dropdown" id="addEventDropdown">
                    <a href="{{ path('app_health_book_entry_new') }}" class="add-event-option">
                        <span class="add-event-icon" style="background: var(--primary-color);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                        </span>
                        Nouvelle consultation
                    </a>
                    <a href="{{ path('app_appointment_new') }}" class="add-event-option">
                        <span class="add-event-icon" style="background: var(--accent-color);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </span>
                        Nouveau rendez-vous
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# ── Légende ── #}
    <div class="d-flex gap-4 mb-3">
        <span class="d-flex align-items-center gap-2 small" style="color: var(--taupe);">
            <span style="width:14px; height:14px; border-radius:3px; background: rgba(26,77,69,0.15); border-left: 3px solid #1a4d45; display:inline-block;"></span>
            Consultation
        </span>
        <span class="d-flex align-items-center gap-2 small" style="color: var(--taupe);">
            <span style="width:14px; height:14px; border-radius:3px; background: var(--soft-warm); border-left: 3px solid var(--accent-color); display:inline-block;"></span>
            Rendez-vous
        </span>
        <span class="d-flex align-items-center gap-2 small" style="color: var(--taupe);">
            <span style="width:14px; height:14px; border-radius:3px; background: rgba(229,166,62,0.12); border-left: 3px solid var(--warning-color); display:inline-block;"></span>
            Rappel
        </span>
    </div>

    {# ══════════════════════════════════════
       LAYOUT : Calendrier principal + Sidebar
       ══════════════════════════════════════ #}
    <div class="agenda-layout">
        <div class="agenda-main">
            {# ── VUE MENSUELLE ── #}
            {% if view == 'month' %}
                <div class="calendar-container">
                    <div class="calendar-weekdays-grid">
                        <div>Lun</div><div>Mar</div><div>Mer</div><div>Jeu</div><div>Ven</div><div>Sam</div><div>Dim</div>
                    </div>
                    <div class="calendar-days-grid">
                        {% if startOfWeekDay > 1 %}
                            {% for i in 1..(startOfWeekDay - 1) %}
                                <div class="calendar-day-box day-box-empty"></div>
                            {% endfor %}
                        {% endif %}

                        {% for day in 1..daysInMonth %}
                            {% set isToday = (day ~ '' == 'now'|date('j') and currentMonth ~ '' == 'now'|date('n') and currentYear ~ '' == 'now'|date('Y')) %}
                            {% set isoDate = currentYear ~ '-' ~ (currentMonth < 10 ? '0' ~ currentMonth : currentMonth) ~ '-' ~ (day < 10 ? '0' ~ day : day) ~ 'T09:00' %}
                            {% set dayFull = currentYear ~ '-' ~ (currentMonth < 10 ? '0' ~ currentMonth : currentMonth) ~ '-' ~ (day < 10 ? '0' ~ day : day) %}
                            <div class="calendar-day-box position-relative {{ isToday ? 'current-today-box' : '' }}"
                                 data-day="{{ day }}" data-date="{{ dayFull }}" {{ isToday ? 'data-is-today="1"' : '' }}>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="day-number {{ isToday ? 'day-number--today' : '' }}">{{ day }}</span>
                                    <a href="{{ path('app_appointment_new', {date: isoDate}) }}" class="day-add-btn rounded-circle d-flex align-items-center justify-content-center" style="width: 18px; height: 18px; font-size: 0.7rem; background-color: var(--bg-color); color: var(--taupe); font-weight: bold; text-decoration: none;">+</a>
                                </div>
                                {% if eventsByDay[day] is defined %}
                                    {% for event in eventsByDay[day] %}
                                        <a href="{{ path(event.link, event.linkParams) }}"
                                           class="event-badge event-{{ event.type }} {{ event.status == 'CANCELLED' ? 'event-cancelled' : '' }} text-decoration-none cal-hover"
                                           {% if event.clientName %}data-client="{{ event.clientName }}"{% endif %}
                                           {% if event.location %}data-location="{{ event.location }}"{% endif %}>
                                            {% if event.date|date('H:i') != '00:00' %}<span class="ev-time">{{ event.date|date('H:i') }}{% if event.endAt %} — {{ event.endAt|date('H:i') }}{% endif %}</span>{% endif %}
                                            <span class="ev-label">{{ event.animal }} · {{ event.title }}</span>
                                        </a>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>

            {# ── VUE HEBDOMADAIRE ── #}
            {% elseif view == 'week' %}
                <div class="time-grid week-time-grid">
                    <div class="time-grid-header">
                        <div class="time-grid-header-cell" style="border-left: none;"></div>
                        {% for wd in weekDays %}
                            <div class="time-grid-header-cell {{ wd.isToday ? 'is-today' : '' }}">
                                <span class="header-day-name">{{ wd.dayName|slice(0, 3) }}</span>
                                <span class="header-day-num">{{ wd.dayNum }}</span>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="allday-bar">
                        <div class="allday-label">Journ.</div>
                        {% for wd in weekDays %}
                            <div class="allday-cell {{ wd.isToday ? 'is-today-col' : '' }}">
                                {% for event in wd.events %}
                                    {% if event.date|date('H:i') == '00:00' %}
                                        <a href="{{ path(event.link, event.linkParams) }}"
                                           class="event-badge event-{{ event.type }} text-decoration-none mb-1 {{ event.status == 'CANCELLED' ? 'event-cancelled' : '' }}"
                                           style="font-size: 0.65rem;">
                                            {{ event.animal }} · {{ event.title|length > 12 ? event.title|slice(0, 12) ~ '...' : event.title }}
                                        </a>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="scroll-time-grid" id="weekScrollGrid">
                        <div class="time-grid-body">
                            {% for hour in 6..21 %}
                                <div class="time-label"><span>{{ hour < 10 ? '0' ~ hour : hour }}:00</span></div>
                                {% for colIdx in 0..6 %}
                                    {% set colDate = weekDays[colIdx].date|date('Y-m-d') ~ 'T' ~ (hour < 10 ? '0' ~ hour : hour) ~ ':00' %}
                                    <div class="time-col {{ weekDays[colIdx].isToday ? 'is-today-col' : '' }}"
                                         data-hour="{{ hour }}" data-col="{{ colIdx }}"
                                         onclick="window.location='{{ path('app_appointment_new', {date: colDate}) }}'">
                                        {% for event in weekDays[colIdx].events %}
                                            {% set evHour = event.date|date('G')|number_format %}
                                            {% if evHour == hour and event.date|date('H:i') != '00:00' %}
                                                {% set evMinutes = event.date|date('i')|number_format %}
                                                {% set topPx = (evMinutes / 60) * 48 %}
                                                {% set eventHeight = event.duration ? (event.duration / 60) * 48 : 44 %}
                                                <a href="{{ path(event.link, event.linkParams) }}"
                                                   class="time-event type-{{ event.type }} text-decoration-none {{ event.status == 'CANCELLED' ? 'event-cancelled' : '' }} cal-hover"
                                                   style="top: {{ topPx }}px; min-height: {{ eventHeight > 22 ? eventHeight : 22 }}px;"
                                                   {% if event.clientName %}data-client="{{ event.clientName }}"{% endif %}
                                                   {% if event.location %}data-location="{{ event.location }}"{% endif %}
                                                   onclick="event.stopPropagation();">
                                                    <span class="event-time">{{ event.date|date('H:i') }}{% if event.endAt %} — {{ event.endAt|date('H:i') }}{% endif %}</span>
                                                    <span class="event-title d-block">{{ event.animal }}</span>
                                                    <span class="d-block" style="font-size: 0.65rem;">{{ event.title|length > 18 ? event.title|slice(0, 18) ~ '...' : event.title }}</span>
                                                </a>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endfor %}
                            {% endfor %}
                        </div>
                    </div>
                </div>

            {# ── VUE JOURNALIERE ── #}
            {% elseif view == 'day' %}
                <div class="time-grid day-time-grid">
                    <div class="time-grid-header">
                        <div class="time-grid-header-cell" style="border-left: none;"></div>
                        <div class="time-grid-header-cell is-today">
                            <span class="header-day-name">{{ dayName }}</span>
                            <span class="header-day-num">{{ currentDay }}</span>
                        </div>
                    </div>
                    <div class="allday-bar">
                        <div class="allday-label">Journ.</div>
                        <div class="allday-cell">
                            {% for event in events %}
                                {% if event.date|date('H:i') == '00:00' %}
                                    <a href="{{ path(event.link, event.linkParams) }}"
                                       class="event-badge event-{{ event.type }} text-decoration-none mb-1 {{ event.status == 'CANCELLED' ? 'event-cancelled' : '' }}">
                                        {{ event.animal }} · {{ event.title }}
                                        {% if event.professional %} — Dr. {{ event.professional }}{% endif %}
                                    </a>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    <div class="scroll-time-grid" id="dayScrollGrid">
                        <div class="time-grid-body">
                            {% for hour in 6..21 %}
                                {% set slotDate = currentDate|date('Y-m-d') ~ 'T' ~ (hour < 10 ? '0' ~ hour : hour) ~ ':00' %}
                                <div class="time-label"><span>{{ hour < 10 ? '0' ~ hour : hour }}:00</span></div>
                                <div class="time-col is-today-col" data-hour="{{ hour }}"
                                     onclick="window.location='{{ path('app_appointment_new', {date: slotDate}) }}'">
                                    {% for event in events %}
                                        {% set evHour = event.date|date('G')|number_format %}
                                        {% if evHour == hour and event.date|date('H:i') != '00:00' %}
                                            {% set evMinutes = event.date|date('i')|number_format %}
                                            {% set topPx = (evMinutes / 60) * 48 %}
                                            {% set eventHeight = event.duration ? (event.duration / 60) * 48 : 44 %}
                                            <a href="{{ path(event.link, event.linkParams) }}"
                                               class="time-event type-{{ event.type }} text-decoration-none {{ event.status == 'CANCELLED' ? 'event-cancelled' : '' }} cal-hover"
                                               style="top: {{ topPx }}px; min-height: {{ eventHeight > 22 ? eventHeight : 22 }}px;"
                                               {% if event.clientName %}data-client="{{ event.clientName }}"{% endif %}
                                               {% if event.location %}data-location="{{ event.location }}"{% endif %}
                                               onclick="event.stopPropagation();">
                                                <span class="event-time">{{ event.date|date('H:i') }}{% if event.endAt %} — {{ event.endAt|date('H:i') }}{% endif %}</span>
                                                <span class="event-title d-block">{{ event.animal }}</span>
                                                <span class="d-block" style="font-size: 0.75rem;">{{ event.title }}</span>
                                                {% if event.professional %}
                                                    <span class="d-block" style="font-size: 0.65rem; opacity: 0.75;">Dr. {{ event.professional }}</span>
                                                {% endif %}
                                            </a>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# ══════════════════════════════════════
           SIDEBAR DROITE
           ══════════════════════════════════════ #}
        <aside class="agenda-sidebar">
            {# ── Notifications ── #}
            <div class="sidebar-card">
                <div class="sidebar-card-header">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    Notifications
                    {% if pendingAppointmentsCount > 0 %}
                        <span style="background: var(--accent-color); color: #fff; font-size: 0.6rem; font-weight: 800; padding: 1px 7px; border-radius: 8px; margin-left: auto;">{{ pendingAppointmentsCount }}</span>
                    {% endif %}
                </div>
                <div class="sidebar-card-body">
                    {% set hasNotifs = false %}

                    {# Upcoming events today as notifications #}
                    {% for event in todayEvents|slice(0, 5) %}
                        {% set hasNotifs = true %}
                        <a href="{{ path(event.link, event.linkParams) }}" class="notif-item">
                            <span class="notif-dot notif-dot--{{ event.type == 'consultation' ? 'teal' : (event.type == 'appointment' ? 'gold' : 'warning') }}"></span>
                            <div>
                                <div class="notif-text">
                                    <strong>{{ event.date|date('H:i') }}</strong> —
                                    {{ event.type == 'consultation' ? 'Consultation' : (event.type == 'appointment' ? 'RDV' : 'Rappel') }}
                                    {{ event.animal }}
                                </div>
                                <div class="notif-time">
                                    {% if event.clientName %}{{ event.clientName }}{% endif %}
                                    {% if event.location %} · {{ event.location }}{% endif %}
                                </div>
                            </div>
                        </a>
                    {% endfor %}

                    {% if pendingAppointmentsCount > 0 %}
                        {% set hasNotifs = true %}
                        <div class="notif-item" style="cursor: default;">
                            <span class="notif-dot notif-dot--gold"></span>
                            <div>
                                <div class="notif-text">
                                    <strong>{{ pendingAppointmentsCount }}</strong> rendez-vous en attente de confirmation
                                </div>
                                <div class="notif-time">30 prochains jours</div>
                            </div>
                        </div>
                    {% endif %}

                    {% if not hasNotifs %}
                        <div class="notif-empty">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="var(--taupe)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="margin-bottom: 6px; opacity: 0.5;"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                            <div>Aucune notification</div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# ── Mini Calendrier ── #}
            <div class="sidebar-card">
                <div class="sidebar-card-header">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Calendrier
                </div>
                <div class="sidebar-card-body">
                    {% set miniMonth = currentMonth %}
                    {% set miniYear = currentYear %}
                    {% set miniFirstDay = date(miniYear ~ '-' ~ (miniMonth < 10 ? '0' ~ miniMonth : miniMonth) ~ '-01') %}
                    {% set miniDaysInMonth = miniFirstDay|date('t') %}
                    {% set miniStartWeekday = miniFirstDay|date('N') %}

                    <div class="mini-cal-nav">
                        <a href="{{ path('app_calendar', {view: view, month: (miniMonth == 1 ? 12 : miniMonth - 1), year: (miniMonth == 1 ? miniYear - 1 : miniYear), day: currentDay}) }}">&#9664;</a>
                        <span>{{ currentMonthName }} {{ miniYear }}</span>
                        <a href="{{ path('app_calendar', {view: view, month: (miniMonth == 12 ? 1 : miniMonth + 1), year: (miniMonth == 12 ? miniYear + 1 : miniYear), day: currentDay}) }}">&#9654;</a>
                    </div>
                    <div class="mini-cal-grid">
                        <div class="mini-cal-header">L</div>
                        <div class="mini-cal-header">M</div>
                        <div class="mini-cal-header">M</div>
                        <div class="mini-cal-header">J</div>
                        <div class="mini-cal-header">V</div>
                        <div class="mini-cal-header">S</div>
                        <div class="mini-cal-header">D</div>

                        {% for i in 1..(miniStartWeekday - 1) %}
                            <div class="mini-cal-day is-empty"></div>
                        {% endfor %}
                        {% for d in 1..miniDaysInMonth %}
                            {% set nowDay = 'now'|date('j') %}
                            {% set nowMonth = 'now'|date('n') %}
                            {% set nowYear = 'now'|date('Y') %}
                            {% set isMiniToday = (d ~ '' == nowDay and miniMonth ~ '' == nowMonth and miniYear ~ '' == nowYear) %}
                            <a href="{{ path('app_calendar', {view: 'day', day: d, month: miniMonth, year: miniYear}) }}" class="mini-cal-day {{ isMiniToday ? 'is-today' : '' }}" style="text-decoration: none;">{{ d }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </aside>
    </div>

    {# ══════════════════════════════════════
       BANDEAU RDV DU JOUR
       ══════════════════════════════════════ #}
    <div class="today-band mt-4" id="dayBand">
        <div class="today-band-title" id="dayBandTitle">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="dayBandLabel">Rendez-vous du {{ todayDayName }} {{ todayDate|date('d/m/Y') }}</span>
            {% if todayEvents|length > 0 %}
                <span class="badge-count" id="dayBandCount">{{ todayEvents|length }}</span>
            {% else %}
                <span class="badge-count" id="dayBandCount" style="display:none;"></span>
            {% endif %}
        </div>

        <div id="dayBandContent">
            {% if todayEvents|length > 0 %}
                <div class="today-events-scroll">
                    {% for event in todayEvents %}
                        <a href="{{ path(event.link, event.linkParams) }}" class="today-event-card type-{{ event.type }}">
                            <div class="tec-time">
                                {{ event.date|date('H:i') }}{% if event.endAt %} — {{ event.endAt|date('H:i') }}{% endif %}
                            </div>
                            <div class="tec-animal">{{ event.animal }}</div>
                            <div class="tec-title">{{ event.title }}</div>
                            {% if event.clientName %}
                                <div class="tec-client">{{ event.clientName }}</div>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="today-empty">Aucun rendez-vous aujourd'hui</div>
            {% endif %}
        </div>
    </div>

    {% if view == 'month' %}
    <script id="monthEventsData" type="application/json">
    {
        {% for day in 1..daysInMonth %}
            {% set dayKey = day %}
            {% set dayFull = currentYear ~ '-' ~ (currentMonth < 10 ? '0' ~ currentMonth : currentMonth) ~ '-' ~ (day < 10 ? '0' ~ day : day) %}
            "{{ dayKey }}": {
                "date": "{{ dayFull }}",
                "events": [
                    {% if eventsByDay[day] is defined %}
                        {% for event in eventsByDay[day] %}
                            {
                                "type": "{{ event.type }}",
                                "time": "{{ event.date|date('H:i') }}",
                                "endTime": "{{ event.endAt ? event.endAt|date('H:i') : '' }}",
                                "animal": {{ event.animal|json_encode|raw }},
                                "title": {{ event.title|json_encode|raw }},
                                "clientName": {{ event.clientName|json_encode|raw }},
                                "link": "{{ path(event.link, event.linkParams) }}"
                            }{{ not loop.last ? ',' : '' }}
                        {% endfor %}
                    {% endif %}
                ]
            }{{ not loop.last ? ',' : '' }}
        {% endfor %}
    }
    </script>
    {% endif %}
</div>


<div id="calTooltip"></div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var grid = document.getElementById('weekScrollGrid') || document.getElementById('dayScrollGrid');
    if (grid) {
        var now = new Date();
        grid.scrollTop = Math.max(0, (now.getHours() - 7) * 48);
    }

    var tooltip = document.getElementById('calTooltip');
    document.querySelectorAll('.cal-hover').forEach(function (el) {
        var client = el.dataset.client;
        var location = el.dataset.location;
        if (!client && !location) return;
        el.addEventListener('mouseenter', function (e) {
            var html = '';
            if (client) html += '<div class="tt-client">' + client + '</div>';
            if (location) html += '<div class="tt-location">' + location + '</div>';
            tooltip.innerHTML = html;
            tooltip.style.display = 'block';
            var rect = el.getBoundingClientRect();
            var ttRect = tooltip.getBoundingClientRect();
            var left = rect.left + rect.width / 2 - ttRect.width / 2;
            var top = rect.top - ttRect.height - 8;
            if (top < 4) top = rect.bottom + 8;
            if (left < 4) left = 4;
            if (left + ttRect.width > window.innerWidth - 4) left = window.innerWidth - ttRect.width - 4;
            tooltip.style.left = left + 'px';
            tooltip.style.top = top + 'px';
        });
        el.addEventListener('mouseleave', function () { tooltip.style.display = 'none'; });
    });

    // Day box click → update bottom band
    var monthData = document.getElementById('monthEventsData');
    if (monthData) {
        var DAYS_FR = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
        var allEvents = JSON.parse(monthData.textContent);
        var dayBoxes = document.querySelectorAll('.calendar-day-box[data-day]');

        function escHtml(s) {
            var d = document.createElement('div');
            d.textContent = s || '';
            return d.innerHTML;
        }

        function updateBand(dayKey) {
            var info = allEvents[dayKey];
            if (!info) return;
            var d = new Date(info.date + 'T00:00:00');
            var dayName = DAYS_FR[d.getDay()];
            var dd = info.date.split('-');
            var label = 'Rendez-vous du ' + dayName + ' ' + dd[2] + '/' + dd[1] + '/' + dd[0];

            document.getElementById('dayBandLabel').textContent = label;
            var badge = document.getElementById('dayBandCount');
            var evts = info.events;
            if (evts.length > 0) {
                badge.textContent = evts.length;
                badge.style.display = '';
            } else {
                badge.style.display = 'none';
            }

            var content = document.getElementById('dayBandContent');
            if (evts.length === 0) {
                content.innerHTML = '<div class="today-empty">Aucun rendez-vous ce jour</div>';
            } else {
                var html = '<div class="today-events-scroll">';
                evts.forEach(function(ev) {
                    html += '<a href="' + escHtml(ev.link) + '" class="today-event-card type-' + escHtml(ev.type) + '">';
                    html += '<div class="tec-time">' + escHtml(ev.time);
                    if (ev.endTime) html += ' — ' + escHtml(ev.endTime);
                    html += '</div>';
                    html += '<div class="tec-animal">' + escHtml(ev.animal) + '</div>';
                    html += '<div class="tec-title">' + escHtml(ev.title) + '</div>';
                    if (ev.clientName) html += '<div class="tec-client">' + escHtml(ev.clientName) + '</div>';
                    html += '</a>';
                });
                html += '</div>';
                content.innerHTML = html;
            }

            var band = document.getElementById('dayBand');
            band.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        dayBoxes.forEach(function(box) {
            box.addEventListener('click', function(e) {
                if (e.target.closest('.day-add-btn') || e.target.closest('.event-badge')) return;
                dayBoxes.forEach(function(b) { b.classList.remove('selected-day-box'); });
                box.classList.add('selected-day-box');
                dayBoxes.forEach(function(b) {
                    if (b.dataset.isToday === '1') b.classList.toggle('current-today-box', b === box);
                });
                updateBand(box.dataset.day);
            });
        });
    }

    var addBtn = document.getElementById('addEventBtn');
    var addDropdown = document.getElementById('addEventDropdown');
    if (addBtn && addDropdown) {
        addBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = addDropdown.classList.toggle('show');
            addBtn.classList.toggle('open', isOpen);
        });
        document.addEventListener('click', function (e) {
            if (!addBtn.contains(e.target) && !addDropdown.contains(e.target)) {
                addDropdown.classList.remove('show');
                addBtn.classList.remove('open');
            }
        });
    }
});
</script>
{% endblock %}
