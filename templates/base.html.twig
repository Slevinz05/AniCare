<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}AniCare{% endblock %}</title>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%22250%22>🐾</text></svg>">

        {# Bootstrap doit être chargé AVANT ton app.css #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

        {# Ton fichier CSS AniCare doit être chargé APRÈS Bootstrap #}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

        {% block stylesheets %}{% endblock %}
    </head>

    <body class="d-flex flex-column min-vh-100">
        {{ include('_partials/_header.html.twig') }}

        <main class="flex-grow-1">
            {% block body %}{% endblock %}
        </main>

        {{ include('_partials/_footer.html.twig') }}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        {% block javascripts %}{% endblock %}
    </body>
</html>