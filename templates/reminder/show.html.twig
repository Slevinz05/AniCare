{% extends 'base.html.twig' %}

{% block title %}{{ reminder.title }} - AniCare{% endblock %}

{% block body %}
<style>
    .rs-card { background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); overflow: hidden; }
    .rs-section { padding: 1.5rem; }
    .rs-section + .rs-section { border-top: 1px solid #f0f0f0; }
    .rs-label { font-size: .78rem; font-weight: 600; color: #6c757d; text-transform: uppercase; letter-spacing: .05em; margin-bottom: .25rem; }
    .rs-value { font-size: .95rem; font-weight: 600; color: #1a1a1a; }
    .rs-cat-pill {
        display: inline-flex; padding: .2rem .65rem; border-radius: 999px;
        font-size: .75rem; font-weight: 600;
    }
    .rs-cat-vaccine { background: #e3f2fd; color: #1565c0; }
    .rs-cat-vermifuge { background: #fce4ec; color: #c62828; }
    .rs-cat-dentaire { background: #f3e5f5; color: #6a1b9a; }
    .rs-cat-marechalerie { background: #fff3e0; color: #e65100; }
    .rs-cat-osteo { background: #e8f5e9; color: #2e7d32; }
    .rs-cat-controle { background: #e0f7fa; color: #00695c; }
    .rs-cat-autre { background: #f5f5f5; color: #616161; }
    .rs-status-banner {
        padding: .75rem 1.5rem; display: flex; align-items: center; gap: .5rem;
        font-size: .85rem; font-weight: 600;
    }
    .rs-status-overdue { background: #fef2f2; color: #dc3545; }
    .rs-status-today { background: #fff3e0; color: #e65100; }
    .rs-status-active { background: var(--soft-teal); color: var(--primary-color); }
    .rs-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    .rs-actions .btn {
        border-radius: var(--radius-md); font-size: .85rem; font-weight: 600;
        padding: .5rem 1.1rem; display: inline-flex; align-items: center; gap: .35rem;
    }
</style>

<div class="container py-4" style="max-width: 800px;">

    <div class="card-header medical-header p-4 rounded-3 mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <p class="page-eyebrow mb-2">Rappel</p>
                <h1 class="page-title mb-1" style="font-size: 1.4rem;">{{ reminder.title }}</h1>
                <p class="page-subtitle mb-0">{{ reminder.animal.name }}</p>
            </div>
            <div class="rs-actions">
                <a href="{{ path('app_reminder_edit', {id: reminder.id}) }}" class="btn btn-outline-light" style="font-size: .82rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Modifier
                </a>
                <a href="{{ path('app_reminder_index') }}" class="btn btn-outline-light" style="font-size: .82rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Retour
                </a>
            </div>
        </div>
    </div>

    <div class="rs-card">
        {# Status banner #}
        {% if reminder.isOverdue %}
            <div class="rs-status-banner rs-status-overdue">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Ce rappel est en retard
            </div>
        {% elseif reminder.isDueToday %}
            <div class="rs-status-banner rs-status-today">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Ce rappel est prévu aujourd'hui
            </div>
        {% else %}
            <div class="rs-status-banner rs-status-active">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Rappel actif
            </div>
        {% endif %}

        {# Details #}
        <div class="rs-section">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="rs-label">Catégorie</div>
                    {% if reminder.category %}
                        <span class="rs-cat-pill rs-cat-{{ reminder.category }}">{{ reminder.categoryLabel }}</span>
                    {% else %}
                        <span class="rs-value text-secondary">Non définie</span>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <div class="rs-label">Animal</div>
                    <div class="rs-value">
                        <a href="{{ path('app_animal_show', {slug: reminder.animal.slug}) }}" style="color: var(--primary-color); text-decoration: none;">
                            {{ reminder.animal.name }}
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="rs-label">Prochaine échéance</div>
                    <div class="rs-value">{{ (reminder.nextOccurrence ?? reminder.scheduledAt)|date('d/m/Y') }}</div>
                </div>
                <div class="col-md-6">
                    <div class="rs-label">Récurrence</div>
                    <div class="rs-value">{{ reminder.recurrenceLabel }}</div>
                </div>
            </div>
        </div>

        {% if reminder.notes %}
        <div class="rs-section">
            <div class="rs-label">Notes</div>
            <p style="font-size: .9rem; color: #374151; margin: 0; white-space: pre-line;">{{ reminder.notes }}</p>
        </div>
        {% endif %}

        <div class="rs-section" style="background: #f9fafb;">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="rs-label">Créé le</div>
                    <div style="font-size: .85rem; color: #6c757d;">{{ reminder.createdAt|date('d/m/Y à H:i') }}</div>
                </div>
                {% if reminder.createdBy %}
                <div class="col-md-6">
                    <div class="rs-label">Créé par</div>
                    <div style="font-size: .85rem; color: #6c757d;">{{ reminder.createdBy.fullName }}</div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
