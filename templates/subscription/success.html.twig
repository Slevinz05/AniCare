                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="{{ path('app_home') }}" class="btn btn-primary">Accéder au tableau de bord</a>
                        <a href="{{ path('app_subscription') }}" class="btn btn-outline-primary">Mon abonnement</a>
