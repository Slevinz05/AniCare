{% extends 'base.html.twig' %}

{% block title %}Abonnement activé - AniCare{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card anicare-card text-center">
                <div class="card-body p-5">
                    <div class="mb-4" style="font-size: 4rem;">🎉</div>
                    <h1 class="h3 page-title mb-3">Bienvenue dans l'espace PRO !</h1>
                    <p class="text-secondary mb-4">
                        Votre abonnement professionnel est maintenant actif.
                        Vous bénéficiez de toutes les fonctionnalités dédiées aux vétérinaires.
